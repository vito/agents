# committer: a Dagger coding agent's git toolbox — everything git-concerned in
# one module. It replaces the former `review` module (the uncommitted half:
# status/diff) and `history` module (the committed half: log/show/fileAt), and
# adds the write operation they both lacked: `commit`.
#
# A Dagger-native agent has no Bash tool, and the mounted Workspace is a plain
# snapshot with NO .git, so `git` itself is never an option. Everything here
# goes through the Dagger-native workspace git API, deliberately layered:
#
#   * Workspace.git.uncommitted is a Changeset of the pending changes: its
#     .diffStats and .asPatch render the `git status` / `git diff` half.
#   * Workspace.git.head is a GitRef — head.log(limit:, paths:) walks the
#     checkout's history. Cheap: the workspace's repository is materialized
#     once per session and the walk reads straight from it.
#   * head.asRepository exposes the backing GitRepository directly: ref(name:)
#     resolves hashes and names; commit(id:) accepts full/short shas, and
#     GitCommit.tree gives the filesystem at a commit.
#   * Workspace.withCommit(message:, paths:, date:) records pending changes as
#     a commit and returns a workspace with HEAD advanced. Returning that
#     Workspace! from the tool IS delivery: the tool layer rebinds the agent's
#     workspace to the returned state. `date` is required (for reproducible
#     commits); currentTimestamp supplies it.
#   * Workspace.withReset(commit:, hard: false) moves HEAD while preserving
#     the working tree, so commits can be redone without losing pending edits.
#   * GitRef.push publishes HEAD to the checkout's remote, engine-side (no
#     host checkout involved), with an optional lease in the style of
#     `--force-with-lease`. An effect on the remote, so never cached.
"""
Git operations on this workspace: review pending changes, read the checkout's
history, commit, reset, and push.
"""
type Committer {
  """
  Compose the git tools onto a base LLM.
  """
  agent(base: LLM!): LLM! @agent {
    base
      .withTools(currentNode, except: ["checkMessages", "checkFiltering"])
      .withSystemPrompt(systemPrompt)
  }

  # ------------------------------------------------------- pending changes
  """
  Summarize the workspace's pending changes: one line per changed file — its
  change kind (A/M/D/R) and added/removed line counts — followed by a totals
  footer. This is the quick "git status"-style overview; reach for `diff` when
  you need the actual hunks.

  The marks are diff vocabulary describing the path's state relative to the
  last commit, NOT `git status` porcelain: there is no index here, so a file
  git would call untracked is simply `A`, and nothing distinguishes staged
  from unstaged. One consequence worth knowing: `commit` without `paths`
  picks up those `A` files too, unlike `git commit -a`.
  """
  status(
    source: Workspace!,
    """
    Glob patterns to include, relative to the workspace root (e.g. "src/**"
    or "**/*.go"). Empty summarizes all pending changes.
    """
    paths: [String!]! = [],
  ): String! {
    let scoped = pendingStats(source, paths)
    if (scoped.isEmpty) {
      if (paths.isEmpty) {
        return "No pending changes."
      }
      return "No pending changes under the given paths."
    }
    let rows = scoped.map { s =>
      `${renderKind(s.kind)}  +${toString(s.addedLines)}  -${toString(s.removedLines)}  ${s.path}`
    }
    let added = scoped.reduce(0) { acc, s => acc + (s.addedLines ?? 0) }
    let removed = scoped.reduce(0) { acc, s => acc + (s.removedLines ?? 0) }
    let footer = `${toString(scoped.length)} files changed, +${toString(added)} -${toString(removed)}`
    rows.join("\n") + "\n\n" + footer
  }

  """
  Show the workspace's pending changes as a Git-compatible unified diff — the
  full hunks across every changed file. Use `status` first for a compact
  overview; use this to actually read the edits (e.g. before committing or
  summarizing your work, or to confirm an edit landed as intended).

  Pass `paths` to scope the output: the full diff of a workspace with a lot of
  pending changes can be enormous.
  """
  diff(
    source: Workspace!,
    """
    Glob patterns to include, relative to the workspace root (e.g. "src/**"
    or "**/*.go"). Empty shows every pending change.
    """
    paths: [String!]! = [],
  ): String! {
    let changes = source.git.uncommitted
    if (changes.isEmpty) {
      return "No pending changes."
    }
    let scoped = changes.filter(include: paths).asPatch.contents
    if (scoped == "") {
      return "No pending changes under the given paths."
    }
    scoped
  }

  """
  Record the workspace's pending changes as a git commit and advance HEAD.

  Without `paths`, EVERYTHING `status` lists is committed — including files
  git would call untracked, since there is no staging area here (unlike
  `git commit -a`). With `paths`, only the changes on those paths are
  committed and the rest stay pending.

  Review with `status` / `diff` before committing, and read `log` first for
  scope names and wording. Subjects must use `scope: summary` and fit in 50
  characters, including the scope. A blank line and brief description are
  required; explain why when the reason is interesting and non-obvious.
  Authorship defaults to the identity the workspace was loaded with.

  Description prose is word-wrapped at 80 characters. Existing line breaks,
  indented/fenced code, and trailers are preserved; long tokens are not split.
  Commits are automatically signed-off.
  """
  commit(
    source: Workspace!,
    """
    A `scope: summary` subject of at most 50 characters, then a blank line
    and a brief description. Include the why for interesting, non-obvious
    changes; don't pad obvious changes with boilerplate. Prose is wrapped
    at 80 characters without rewriting indented/fenced code or trailers.
    """
    message: String!,
    """
    Glob patterns to commit, relative to the workspace root (e.g. "src/**"
    or "**/*.go"). Empty commits every pending change. Patterns must match
    both sides of a rename or neither; a nonempty selection matching nothing
    is an error.
    """
    paths: [String!]! = [],
  ): Workspace! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): committing is a side effect on the workspace's state; a
    # later identical call must record a fresh commit, not replay the first.
    message = formatMessage(message)
    let picked = pendingStats(source, paths).filter { s => !s.path.hasSuffix("/") }
    if (picked.isEmpty) {
      if (paths.isEmpty) {
        raise "nothing to commit: no pending changes"
      }
      raise "nothing to commit under the given paths (status shows what is pending)"
    }

    # withCommit takes literal paths. Expand from the same filtered stats
    # used above, excluding directory rows so they cannot widen the selection
    # to unmatched siblings. Preserve both names of selected renames.
    let selectedPaths = if (paths.isEmpty) {
      [] :: [String!]!
    } else {
      (picked.map { s => s.path }
        + picked.map { s => s.oldPath ?? "" }.filter { p => p != "" }).uniq
    }
    let committed = source.withCommit(
      message,
      paths: selectedPaths,
      date: currentTimestamp,
      signoff: true,
    )
    # Force the commit HERE, inside the tool: without this the failure would
    # surface later, when the engine rebinds the workspace, stripped of the
    # context of what was being committed.
    let sha = committed.git.head.commitSHA rescue {
      e: Error => raise `commit failed: ${plainError(e.message)}`
    }

    let left = committed.git.uncommitted.diffStats.{{path}}.length
    let leftNote = if (left > 0) {
      "\n" + `${toString(left)} file(s) remain uncommitted; status shows them.`
    } else {
      ""
    }
    print(`Committed ${short(sha)}: ${subject(message)} ` + `(${toString(picked.length)} file(s))` + leftNote)
    committed
  }

  """
  Move HEAD to a chosen commit without changing the working tree.

  Use this to redo or combine local commits: read `log`, choose the commit to
  return to, reset, then review `status` / `diff` and commit again. Changes
  from the undone commits and any pending edits remain in the workspace.
  There is deliberately no hard-reset mode here.

  Rewrites local history; only use when asked to undo or rewrite commits.
  Does not push or change the remote. Record the old HEAD before resetting
  so it can be used as a recovery target.
  """
  reset(
    source: Workspace!,
    """
    The commit to move HEAD to. Use a commit hash from `log`; it is required
    so resetting never silently chooses how much history to undo.
    """
    commit: String!,
  ): Workspace! @cache(policy: FunctionCachePolicy.Never) {
    if (commit.trimSpace == "") {
      raise "reset: specify the commit to move HEAD to (log shows the history)"
    }
    let previous = head(source).commitSHA
    let reset = source.withReset(commit: commit.trimSpace, hard: false)
    # Force evaluation before returning the workspace, like commit: failures
    # should surface here, not while the agent is rebinding its workspace.
    let sha = reset.git.head.commitSHA rescue {
      e: Error => raise `reset failed: ${plainError(e.message)}`
    }
    print(`Reset HEAD from ${previous} to ${sha}. Working tree preserved; review status / diff before committing again.`)
    reset
  }

  """
  Push the workspace's committed history to its remote.

  Publishes HEAD — everything `commit` has recorded — to the repository the
  checkout was cloned from. Pending changes are NOT pushed: commit first,
  then push. The remote branch is created when it does not exist yet.

  A push the remote rejects (its branch moved past ours) is an error, never a
  takeover. To overwrite anyway, pass `expectedRemoteSHA`: the push then
  succeeds only while the remote branch still points at that sha — a lease,
  like `--force-with-lease` — so use it only after reading what the remote
  moved to, and only when discarding that is the intent.
  """
  push(
    source: Workspace!,
    """
    Destination branch on the remote. Empty pushes the current branch under
    its own name; required when HEAD is not on a branch.
    """
    branch: String! = "",
    """
    Lease on the remote branch: omit for a plain push (fast-forwards and
    branch creation only), or pass the sha the remote branch is expected to
    point at to force-update it from exactly that state.
    """
    expectedRemoteSHA: String = null,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): pushing is an effect on the remote; a later identical
    # call must push again, not replay the first result.
    #
    # The HEAD probe is the same first-read guard as the history tools': a
    # workspace with no readable history gets the plain answer, not a push
    # error.
    head(source).commitSHA rescue {
      e: Error => return noHistory(e.message)
    }
    let result = head(source).push(
      branch: branch,
      expectedRemoteSHA: expectedRemoteSHA,
    ).{{ref, previousSHA, sha, disposition}} rescue {
      e: Error => raise `push failed: ${plainError(e.message)}`
    }
    let summary = case (result.disposition) {
      GitPushDisposition.UP_TO_DATE => `${result.ref} is already up to date at ${short(result.sha)}; nothing to push.`

      GitPushDisposition.CREATED => `Pushed ${result.ref} (new branch) at ${short(result.sha)}.`

      GitPushDisposition.FORCED => `Pushed ${result.ref}: forced ${short(result.previousSHA)} -> ${short(result.sha)}.`

      else => `Pushed ${result.ref}: ${short(result.previousSHA)} -> ${short(result.sha)}.`
    }
    let left = source.git.uncommitted.diffStats.{{path}}.length
    let leftNote = if (left > 0) {
      "\n" + `${toString(left)} file(s) remain uncommitted and were not pushed; status shows them.`
    } else {
      ""
    }
    summary + leftNote
  }

  # --------------------------------------------------------------- history
  """
  Show the repository's commit history, newest first.

  Each entry is one line — short hash, date, author, subject — and
  `full: true` prints every commit's full message body.

  Use it to learn how this repository writes commit messages (`full: true`
  prints the bodies), or — with `paths` — to find out who last touched a file
  and why. For one commit's actual patch, use `show`.
  """
  log(
    source: Workspace!,
    """
    Maximum number of commits to show, newest first.
    """
    limit: Int! = 20,
    """
    Only show commits touching these Git path patterns, relative to the
    repository root (e.g. "src/**" or "**/*.go"), like `git log -- <paths>`.
    Empty includes all paths.
    """
    paths: [String!]! = [],
    """
    Only show commits whose message matches this regular expression, matched
    case-insensitively over a bounded window of recent commits — the footer
    reports how many were searched. The pattern is matched against the WHOLE
    message, body included — a commit can match on something its one-line
    subject never mentions, so pass `full: true` to see where the hit is — and
    `^` anchors to the start of the message, not to each line.
    """
    grep: String = null,
    """
    Print the full message body of every commit, not just the subject.
    """
    full: Boolean! = false,
  ): String! {
    # One PAST `limit` when there is no grep to widen the walk: the footer's
    # "there is more below" can only be honest if the walk was allowed to find
    # one more commit than the listing prints. `takeFirst(limit)` below drops it
    # again, so the extra entry is never rendered.
    let scanned = if (grep == null) { limit + 1 } else { searchWindow }
    let walk = head(source).log(
      limit: scanned,
      paths: if (paths.isEmpty) { null } else { paths },
    ).{{shortSha, authorName, authoredDate, message}} rescue {
      e: Error => return noHistory(e.message)
    }
    # The first read of the workspace's git state: a synthetic workspace, a
    # checkout that is not a git repository at all, or a fresh `git init`
    # with nothing committed yet all give out here.

    let matched = if (grep == null) {
      walk
    } else {
      # Case-insensitive by construction: a String has to be cast into the
      # Regexp slot, since only literals coerce.
      let pattern = ("(?i)" + (grep ?? "")) :: Regexp!
      walk.filter { c => c.message.containsMatch(pattern) }
    }
    let shown = matched.takeFirst(limit)

    if (shown.isEmpty) {
      return emptyLog(paths, grep)
    }

    let entries = shown.map { c =>
      let header = `${c.shortSha}  ${when(c.authoredDate)}  ${c.authorName}`
      if (full) {
        header + "\n" + indent(clampLines(
          c.message.trimSpace,
          messageLines,
          `(message truncated — show(commit: "${c.shortSha}") for all of it)`,
        ))
      } else {
        header + "\n" + indent(subject(c.message))
      }
    }

    # Footer notes, in the order a reader wants them: what the search covered,
    # then whether history continues below it.
    let searchNote = if (grep == null) {
      ""
    } else {
      let more = matched.length - shown.length
      # `paths` narrows the walk before the pattern is applied, so the window
      # the match count refers to is the recent commits that touched those
      # paths — not recent history as a whole.
      let window = if (paths.isEmpty) {
        `the last ${toString(searchWindow)} commits`
      } else {
        `the last ${toString(searchWindow)} commits touching the given paths`
      }
      `(${toString(matched.length)} match(es) in ${window}` + (if (more > 0) { `; ${toString(more)} not shown, raise limit)` } else { ")" })
    }
    # Only meaningful without a grep: a grep listing walks the whole search
    # window and reports its own leftovers above.
    let moreNote = if (grep == null and matched.length > shown.length) {
      "(more history below; raise limit to see it)"
    } else {
      ""
    }
    let notes = [searchNote, moreNote].filter { n => n != "" }
    let footer = if (notes.isEmpty) { "" } else { "\n\n" + notes.join("\n") }

    banner(source) + "\n\n" + entries.join("\n\n") + footer
  }

  """
  Show one commit in full: its metadata, message, per-file stats and patch —
  `git show` for any commit in the checkout's history.

  `commit` names it: "HEAD" (the newest commit), a short or full hash as
  printed by `log`, or a tag name. With `against`, the patch is the
  difference between the two commits instead of the commit's own change,
  which is how you review a whole stack ("everything since <sha>") or compare
  against a release tag.

  Both halves are capped, because a single commit can touch thousands of
  files: the patch stops at `maxLines`, and the file stats list is capped too.
  The totals line above those rows always counts the whole commit, so you can
  see how much was left out — scope with `paths` to see the rest, rather than
  raising `maxLines`.
  """
  show(
    source: Workspace!,
    """
    The commit to show: "HEAD", a short or full hash from `log`, or a tag
    name. Hashes and names are resolved directly by the repository.
    """
    commit: String! = "HEAD",
    """
    Show the difference from this commit to `commit` instead of the change
    `commit` itself made. Same spelling rules as `commit`.
    """
    against: String = null,
    """
    Glob patterns to include, relative to the repository root (e.g. "src/**"
    or "**/*.go"). Empty shows all changes. Totals still count the whole
    commit; file rows and the patch are limited to the matching changes.
    """
    paths: [String!]! = [],
    """
    Maximum number of patch lines to print. The totals line says how big the
    change really is; scope with `paths` instead of raising this too far.
    """
    maxLines: Int! = 400,
  ): String! {
    # The first read of the workspace's git state: a checkout with no readable
    # history gives out here, with a plain answer instead of an engine error.
    let headSha = head(source).commitSHA rescue {
      e: Error => return noHistory(e.message)
    }
    let want = resolveSpec(source, commit, headSha)

    let repo = source.git.head.asRepository
    let target = repo.commit(id: want).{{
      sha,
      shortSha,
      authorName,
      authorEmail,
      authoredDate,
      message,
      parentShas
    }}
    let baseSpec = if (against == null) {
      target.parentShas.takeFirst.join("")
    } else {
      resolveSpec(source, against ?? "", headSha)
    }
    let changes = if (baseSpec == "") {
      # A root commit has no parent: everything in it is an addition.
      repo.commit(id: want).tree(discardGitDir: true).changes(from: directory)
    } else {
      repo
        .commit(id: want)
        .tree(discardGitDir: true)
        .changes(from: repo.commit(id: baseSpec).tree(discardGitDir: true))
    }
    let patch = changes.filter(include: paths).asPatch.contents
    let mergeNote = if (against == null and target.parentShas.length > 1) {
      "\n" + `(merge commit: shown against its first parent ${short(baseSpec)})`
    } else {
      ""
    }
    let meta = if (against == null) {
      `commit ${target.sha}` + "\n" + `Author: ${target.authorName} <${target.authorEmail}>` + "\n" + `Date:   ${when(target.authoredDate)}` + mergeNote + "\n\n" + indent(target.message.trimSpace)
    } else {
      `Difference from ${short(baseSpec)} to ${target.shortSha}` + "\n" + `  ${target.shortSha}  ${when(target.authoredDate)}  ${target.authorName}  ${subject(target.message)}`
    }
    meta + "\n\n" + statBlock(changes, paths, maxFiles) + "\n\n" + patchBlock(
      patch,
      paths,
      maxLines,
    )
  }

  """
  Read a file as it was at a commit — the workspace tool `read`, pointed at
  history instead of the working tree.

  Use it to recover something you deleted, to see what a file looked like
  before a change, or to read a file that no longer exists. Lines are printed
  with their numbers, and the output is capped like `read`: page through a
  long file with `offset`.
  """
  fileAt(
    source: Workspace!,
    """
    Path of the file, relative to the repository root.
    """
    path: String!,
    """
    The commit to read it at: "HEAD", a short or full hash from `log`, or a
    tag name.
    """
    commit: String! = "HEAD",
    """
    Line offset to start reading from.
    """
    offset: Int! = 0,
    """
    Maximum number of lines to print.
    """
    limit: Int! = 400,
  ): String! {
    # The first read of the workspace's git state: a checkout with no readable
    # history gives out here, with a plain answer instead of an engine error.
    let headSha = head(source).commitSHA rescue {
      e: Error => return noHistory(e.message)
    }
    let want = resolveSpec(source, commit, headSha)
    let repo = source.git.head.asRepository
    let target = repo.commit(id: want).{{shortSha, message, authoredDate}}
    let contents = repo.commit(id: want).tree(discardGitDir: true).file(path).contents rescue {
      e: Error => raise `${path} does not exist at ${target.shortSha}: ${plainError(e.message)}` + ` — it may have been added later, deleted, or renamed; log(paths: ["${path}"]) shows the commits that touched it`
    }
    let lines = contents.split("\n")
    let page = lines.dropFirst(offset).takeFirst(limit)
    let numbered = page.map { line, i =>
      `${toString(offset + i + 1)}`.padLeft(6) + "→" + line
    }
    let shown = offset + page.length
    let footer = if (shown < lines.length) {
      "\n\n" + `(showing lines ${toString(offset + 1)}-${toString(shown)} of ${toString(lines.length)}; ` + `pass offset: ${toString(shown)} for more)`
    } else {
      ""
    }
    `${path} at ${target.shortSha} (${when(target.authoredDate)}) — ${subject(target.message)}` + "\n\n" + numbered.join("\n") + footer
  }

  """
  Check commit-message validation and conservative description wrapping.
  """
  checkMessages: String! @check {
    let valid = "committer: enforce commit style\n\nKeep history readable."
    assert { formatMessage(valid) == valid }
    assert { formatMessage(valid.replace("\n", "\r\n")) == valid }
    let fifty = "scope: " + "".padRight(43).replace(" ", "é")
    assert { formatMessage(fifty + "\n\nDescription.") == fifty + "\n\nDescription." }
    [
      "",
      "unscoped subject\n\nDescription.",
      ": missing scope\n\nDescription.",
      "scope: \n\nDescription.",
      "scope:  extra space\n\nDescription.",
      " scope: leading space\n\nDescription.",
      "scope: trailing space \n\nDescription.",
      fifty + "x\n\nDescription.",
      "scope: missing body",
      "scope: missing separator\nDescription.",
      "scope: empty body\n\n \t\n",
    ].each { invalid =>
      let result = formatMessage(invalid) rescue {
        e: Error => e.message
      }
      assert { result.hasPrefix("commit:") }
    }

    let eighty = ["123456789", "123456789", "123456789", "123456789", "123456789", "123456789", "123456789", "123456789"].join(" ") + "x"
    assert { eighty.split("").length == 80 }
    assert { wrapDescription(eighty) == eighty }
    assert { wrapDescription(eighty + " next") == eighty + "\nnext" }
    assert { wrapDescription("short  line\nanother\n\nparagraph") == "short  line\nanother\n\nparagraph" }
    let long = eighty + " next words"
    [" ", "    ", "\t", "Signed-off-by: ", "Co-authored-by: "].each { prefix =>
      assert { wrapDescription(prefix + long) == prefix + long }
    }
    ["- ", "* ", "+ ", "1. ", "12) "].each { prefix =>
      let wrapped = wrapDescription(prefix + long)
      assert { wrapped.hasPrefix(prefix) }
      assert { wrapped.split("\n").all { line => line.split("").length <= 80 } }
      assert {
        wrapped.split("\n").dropFirst.all { line =>
          line.hasPrefix(
            "".padRight(prefix.split("").length),
          )
        }
      }
      assert { wrapDescription(wrapped) == wrapped }
    }
    ["```", "~~~~"].each { fence =>
      let code = fence + "lang\n" + long + "\n\n  " + long + "\n" + fence
      assert { wrapDescription(code + "\n" + long) == code + "\n" + eighty + "\nnext words" }
    }
    let nested = "````\n```\n" + long + "\n````"
    assert { wrapDescription(nested) == nested }
    assert { wrapDescription("~~~\n" + long) == "~~~\n" + long }
    let url = "https://example.com/" + "".padRight(90).replace(" ", "x")
    assert { wrapDescription("See " + url + " for details.") == "See\n" + url + "\nfor details." }
    let wrapped = formatMessage("scope: wrap prose\n\n" + long + "\n\n    " + long)
    assert { formatMessage(wrapped) == wrapped }
    "Commit-message checks passed."
  }

  """
  Check glob filtering and commits on a private frozen workspace.
  """
  checkFiltering(source: Workspace!): String! @check {
    # Returning a String keeps fixture commits local to this check; the
    # caller's workspace and host checkout are never rebound or exported.
    let root = "glob-check-" + Random.string
    let base = source.git.head.asWorkspace
      .withNewFile(root + "/edit.go", "before\n")
      .withNewFile(root + "/delete.go", "remove\n")
      .withNewFile(root + "/old.go", "rename\n")
      .withNewFile(root + "/keep.txt", "keep\n")
      .withCommit("fixture", paths: [root], date: "2026-09-15T12:00:00Z")
    let working = base
      .withNewFile(root + "/edit.go", "after\n")
      .withoutFile(root + "/delete.go")
      .withoutFile(root + "/old.go")
      .withNewFile(root + "/new.go", "rename\n")
      .withNewFile(root + "/newdir/added.go", "added\n")
      .withNewFile(root + "/space name.go", "space\n")
      .withNewFile(root + "/quote\"name.go", "quote\n")
      .withNewFile(root + "/keep.txt", "unselected\n")
      .withNewFile(root + "/newdir/keep.txt", "unselected sibling\n")
    let patterns = [root + "/**/*.go"]
    let summary = status(working, paths: patterns)
    assert { summary.contains("edit.go") and summary.contains("newdir/added.go") }
    assert { !summary.contains("keep.txt") }
    let patch = diff(working, paths: patterns)
    assert { patch.contains("+after") and patch.contains("+added") }
    assert { patch.contains("-remove") and !patch.contains("unselected") }
    assert { diff(working, paths: [root + "/**/*.rs"]).contains("No pending changes") }
    assert { diff(working, paths: [root + "/newdir/added.?o"]).contains("+added") }
    assert { diff(working, paths: [root + "/newdir/[a]dded.go"]).contains("+added") }
    let message = "test: select glob changes\n\nExercise the public commit selection."
    let selected = commit(working, message, paths: patterns)
    let remaining = selected.git.uncommitted.diffStats.{{path}}
      .map { s => s.path }.filter { p => !p.hasSuffix("/") }
    assert { remaining == [root + "/keep.txt", root + "/newdir/keep.txt"] }
    assert { selected.directory("/").changes(from: working.directory("/")).isEmpty }
    let shown = show(selected, paths: [root + "/**/added.*"])
    assert { shown.contains("+added") and !shown.contains("+after") }
    assert { show(selected, paths: [root + "/**/*.rs"]).contains("no changes under the given paths") }
    let noMatch = commit(working, message, paths: [root + "/**/*.rs"]).git.head.commitSHA rescue {
      e: Error => e.message
    }
    assert { noMatch.contains("nothing to commit") }
    let splitRename = commit(working, message, paths: [root + "/old.*"]).git.head.commitSHA rescue {
      e: Error => e.message
    }
    assert { splitRename.contains("split the rename") }
    assert { commit(working, message).git.uncommitted.isEmpty }
    "Glob filtering and commit checks passed."
  }

  # ---------------------------------------------------------------- helpers

  # Bound commit-message searches in `log`; commit resolution has no window.
  let searchWindow: Int! = 500

  # Per-commit message cap in `log`, so one essay-length commit body cannot
  # crowd out the rest of the listing.
  let messageLines: Int! = 24

  # Per-commit file-row cap. A single commit can touch thousands of files
  # (generated code, a vendor bump), and the stat list alone would then be the
  # whole answer.
  let maxFiles: Int! = 40

  let head(source: Workspace!): Dagger.GitRef! {
    source.git.head
  }

  # The pending changes' per-file stats, scoped to `paths`. Shared by status
  # (to render them) and commit (to refuse an empty commit up front).
  let pendingStats(
    source: Workspace!,
    paths: [String!]!,
  ): [{{kind: DiffStatKind!, addedLines: Int!, removedLines: Int!, path: String!, oldPath: String}}!]! {
    source.git.uncommitted.filter(include: paths).diffStats.{{kind, addedLines, removedLines, path, oldPath}}
  }

  # Engine errors carry a "[traceparent:<trace>-<span>]" marker so an agent can
  # go read the failing span's logs. Every failure these tools rescue, though,
  # is an ordinary mistake in a tool argument — a typo in a commit spelling, a
  # file that did not exist yet at that commit — not an engine fault, and the
  # marker only invites a log dive over a typo. Drop it from the text that gets
  # embedded in a friendly message; keep everything the message actually says.
  let plainError(message: String!): String! {
    message.replaceMatches(`\s*\[traceparent:[^\]]*\]`, with: "").trimSpace
  }

  # Where each history tool's FIRST read of the workspace's git state sends its
  # failure: a synthetic workspace, a checkout that is not a git repository at
  # all, or a fresh `git init` with nothing committed yet. The plain-language
  # answer sits on that first read — `log`'s history walk, and the HEAD probe
  # in `show` and `fileAt` — before anything else touches the repository.
  let noHistory(reason: String!): String! {
    `This workspace has no readable git history (${plainError(reason)}). ` + "Your pending edits are still visible with status / diff."
  }

  # Resolve full or abbreviated hashes and named refs through the engine.
  # HEAD/empty uses the tip already resolved by the caller's first read.
  let resolveSpec(source: Workspace!, spec: String!, headSha: String!): String! {
    let want = spec.trimSpace
    if (want == "" or want == "HEAD") {
      return headSha
    }
    source.git.head.asRepository.ref(name: want).commitSHA rescue {
      e: Error => raise `cannot resolve commit "${spec}": ${plainError(e.message)}`
    }
  }

  let statBlock(
    changes: Changeset!,
    paths: [String!]!,
    max: Int!,
  ): String! {
    let stats = changes.diffStats.{{path, kind, addedLines, removedLines}}
    if (stats.isEmpty) {
      return "(no file changes)"
    }
    let added = stats.reduce(0) { acc, s => acc + (s.addedLines ?? 0) }
    let removed = stats.reduce(0) { acc, s => acc + (s.removedLines ?? 0) }
    let totals = `${toString(stats.length)} file(s) changed, +${toString(added)} -${toString(removed)}`
    let scoped = changes.filter(include: paths).diffStats.{{path, kind, addedLines, removedLines}}
    if (scoped.isEmpty) {
      return totals + "\n" + "  (none under the given paths)"
    }
    let rows = scoped.takeFirst(max).map { s =>
      `  ${renderKind(s.kind)}  +${toString(s.addedLines)}  -${toString(s.removedLines)}  ${s.path}`
    }
    # A comparison across a release can touch five figures of files: never let
    # the file list alone flood the caller's context.
    let omitted = scoped.length - rows.length
    let note = if (omitted > 0) {
      "\n" + `  ... ${toString(omitted)} more file(s) not listed; scope with paths to see them`
    } else {
      ""
    }
    let scopeNote = if (paths.isEmpty) { "" } else { ` (${toString(scoped.length)} under the given paths)` }
    totals + scopeNote + "\n" + rows.join("\n") + note
  }

  # Clamp an already-scoped patch to `max` lines.
  let patchBlock(patch: String, paths: [String!]!, max: Int!): String! {
    let text = patch ?? ""
    if (text.trimSpace == "") {
      if (!paths.isEmpty) {
        return "(no changes under the given paths)"
      }
      return "(this commit records no file changes)"
    }
    clampLines(text, max, "(patch truncated — scope it with paths, or read the file with fileAt)")
  }

  let clampLines(text: String!, max: Int!, note: String!): String! {
    let lines = text.split("\n")
    if (lines.length <= max) {
      return text
    }
    lines.takeFirst(max).join("\n") + "\n\n" + `... ${toString(lines.length - max)} of ${toString(lines.length)} lines not shown. ` + note
  }

  let banner(source: Workspace!): String! {
    let branch = head(source).name.trimPrefix("refs/heads/") rescue {
      e: Error => "?"
    }
    `On ${branch}, HEAD ${short(head(source).commitSHA)}.`
  }

  let emptyLog(paths: [String!]!, grep: String): String! {
    if (grep != null) {
      return `No commit message in the last ${toString(searchWindow)} commits matches "${grep ?? ""}"` + (if (paths.isEmpty) { "." } else { " under the given paths." })
    }
    if (paths.isEmpty) {
      return "No commit history in this workspace."
    }
    "No commits have touched the given paths."
  }

  let indent(text: String!): String! {
    text.split("\n").map { line => "    " + line }.join("\n")
  }

  # Validate before touching the workspace. Count Unicode characters, not
  # bytes; never silently truncate a subject or invent a rationale.
  let formatMessage(message: String!): String! {
    let lines = message.replace("\r\n", "\n").split("\n")
    let title = lines.takeFirst.join("")
    if (!title.containsMatch(`^[A-Za-z0-9][A-Za-z0-9_./-]*: \S.*$`) or title != title.trimSpace) {
      raise "commit: use a scoped subject such as 'committer: enforce commit style'"
    }
    if (title.split("").length > 50) {
      raise `commit: subject is ${toString(title.split("").length)} characters; maximum is 50 including scope`
    }
    if (lines.length < 3 or lines[1] != "") {
      raise "commit: follow the subject with a blank line and a brief description"
    }
    let body = lines.dropFirst(2).join("\n")
    if (body.trimSpace == "") {
      raise "commit: add a brief description; explain why when interesting and non-obvious"
    }
    title + "\n\n" + wrapDescription(body)
  }

  # Conservative rather than a Markdown reflow: keep existing line breaks
  # and all indented lines verbatim (including tabs). Fences may contain
  # unindented code. Trailer-like lines must not be split: Git parses them.
  let wrapDescription(body: String!): String! {
    let fence = ""
    body.split("\n").map { line =>
      let trimmed = line.trimLeft(" \t")
      if (fence != "") {
        let closing = trimmed.trimRight(" \t")
        if (closing.hasPrefix(fence) and closing.trim(
          fence.split("").takeFirst.join(""),
        ) == "") {
          fence = ""
        }
        continue line
      }
      let opening = trimmed.match("^(`{3,}|~{3,})")
      if (opening != null) {
        fence = opening.string
        continue line
      }
      if (line == "" or line.hasPrefix(" ") or line.hasPrefix("\t") or line.containsMatch(`^[A-Za-z0-9-]+: `)) {
        continue line
      }
      let marker = line.match(`^(?:[-+*]|[0-9]+[.)]) +`)
      let prefix = if (marker == null) { "" } else { marker.string }
      wrapLine(line.trimPrefix(prefix), prefix)
    }.join("\n")
  }

  let wrapLine(text: String!, prefix: String!): String! {
    if ((prefix + text).split("").length <= 80) {
      return prefix + text
    }
    let result: [String!]! = []
    let line = prefix
    let hasWord = false
    let continuation = "".padRight(prefix.split("").length)
    text.splitMatches(`\s+`).filter { word => word != "" }.each { word =>
      let candidate = line + (if (hasWord) { " " } else { "" }) + word
      if (hasWord and candidate.split("").length > 80) {
        result += [line]
        line = continuation + word
      } else {
        line = candidate
      }
      hasWord = true
    }
    (result + [line]).join("\n")
  }

  let subject(message: String!): String! {
    message.split("\n", 2).takeFirst.join("")
  }

  let short(sha: String!): String! {
    sha.split("", 8).takeFirst(7).join("")
  }

  # RFC3339 in, "2026-08-14 03:15" out: the seconds and the zone are noise in
  # a listing, but the time of day tells you what happened in this session.
  let when(date: String!): String! {
    let parts = date.split("T")
    let day = parts.takeFirst.join("")
    let clock = parts.dropFirst.join("").split("", 6).takeFirst(5).join("")
    if (clock == "") { day } else { day + " " + clock }
  }

  # Nullable: `show`'s stats reach here through a projection of the nullable
  # `changes` field, whose record fields inherit its nullability.
  let renderKind(kind: DiffStatKind): String! {
    case (kind) {
      DiffStatKind.ADDED => "A"
      DiffStatKind.MODIFIED => "M"
      DiffStatKind.REMOVED => "D"
      DiffStatKind.RENAMED => "R"
      else => "?"
    }
  }

  let systemPrompt: String! = """
    You have git tools for this workspace, covering your pending changes, the
    checkout's history, and committing:

    - `status` — a compact per-file overview of your pending changes (change
      kind + added/removed line counts). Start here to see what you've
      touched.
    - `diff` — those same changes as a full Git-style unified patch, when you
      need to read the actual hunks. Scope it with `paths`; an unscoped patch
      can be huge.
    - `commit` — record pending changes as a commit and advance HEAD. Without
      `paths` it commits EVERYTHING `status` lists; with `paths`, only those
      changes, leaving the rest pending.
    - `reset` — move HEAD to a chosen commit, keeping the working tree and
      pending edits intact. Only use when asked to undo or rewrite commits.
      Read `log` and record the old HEAD first; then reset, review `status` /
      `diff`, and commit again. No hard reset, and no remote changes. Rewriting
      published history needs explicit authorization, not an automatic force
      push after a rejection.
    - `push` — publish committed history to the checkout's remote. Pending
      changes are not pushed: commit first. A rejected push (the remote
      moved) is an error; `expectedRemoteSHA` is the force-with-lease escape
      hatch, for when overwriting the remote is genuinely intended.
    - `log` — commits newest first. Pass `paths` to see who last touched a
      file and why, `grep` to search commit messages, and `full: true` to
      print full message bodies.
    - `show` — one commit in full: metadata, message, per-file stats and the
      patch. Takes "HEAD", a short hash from `log`, or a tag; `against` turns
      it into a comparison between two commits.
    - `fileAt` — a file's contents as of a commit, for recovering something
      you deleted or seeing what a file looked like before a change.

    The A/M/D/R marks in `status` describe each path relative to the last
    commit, not `git status`'s index model — there is no staging area here,
    so a file git would call untracked is just `A`, and `commit` without
    `paths` includes those, unlike `git commit -a`.

    Committing well: review with `status` / `diff` first; read `log` for scope
    names and wording. Keep each commit focused on one logical change, scoping
    with `paths` when only part of your pending work belongs together.

    Commit style is enforced: use `scope: summary` (e.g. `committer: wrap
    descriptions`), at most 50 characters TOTAL including the scope. Choose
    a meaningful component/area scope. Follow it with a blank line and a brief
    description of the change. Explain why when the motivation or tradeoff is
    interesting and non-obvious; don't restate the subject, invent reasons,
    or add boilerplate just to say "why". The tool wraps prose at 80 characters,
    keeping existing line breaks, indented/fenced code and trailers intact;
    long tokens remain unbroken and lists get hanging indentation.

    Only commit when asked to, or when the task clearly calls for it — and
    only push when asked: a push leaves the workspace and publishes to the
    remote. The reading tools re-read the current state on every call, so
    re-run them after making edits.
  """
}
