# committer: a Dagger coding agent's git toolbox — everything git-concerned in
# one module. It replaces the former `review` module (the uncommitted half:
# status/diff) and `history` module (the committed half: log/show/fileAt), and
# adds the write operation they both lacked: `commit`.
#
# A Dagger-native agent has no Bash tool, and the mounted Workspace is a plain
# snapshot with NO .git, so `git` itself is never an option. Everything here
# goes through the Dagger-native workspace git API, deliberately layered:
#
#   * Workspace.git.uncommitted is a Changeset of the pending changes: its
#     .diffStats and .asPatch render the `git status` / `git diff` half.
#   * Workspace.git.head is a GitRef — head.log(limit:, paths:) walks the
#     checkout's history. Cheap: the workspace's repository is materialized
#     once per session and the walk reads straight from it.
#   * head.asRepository exposes the backing GitRepository directly: ref(name:)
#     resolves hashes and names; commit(id:) accepts full/short shas, and
#     GitCommit.tree gives the filesystem at a commit.
#   * Workspace.withCommit(changes:, message:, date:) records selected changes as
#     a commit and returns a workspace with HEAD advanced. Returning that
#     Workspace! from the tool IS delivery: the tool layer rebinds the agent's
#     workspace to the returned state. `date` is required (for reproducible
#     commits); currentTimestamp supplies it.
#   * Workspace.withReset(commit:, hard:) moves HEAD, preserving the working
#     tree by default or replacing it with the target commit when hard is true.
#   * GitRef.push publishes HEAD to the checkout's remote, engine-side (no
#     host checkout involved), with an optional lease in the style of
#     `--force-with-lease`. An effect on the remote, so never cached.
#   * Workspace.compareCommitsFrom / withCommitsFrom plan and replay another
#     workspace's commits onto this one (cherry-pick with authorship kept, or
#     a fast-forward when hashes can be preserved). `rebase` is built from
#     them: rewind to the fork point, fast-forward onto the upstream ref's
#     tip, replay our commits, and STOP at the first conflict — which is
#     merged three-way into the working tree (Changeset.withChangeset with
#     conflict markers) for the agent to resolve before `rebaseContinue`
#     records it and carries on. The in-progress state rides on the module
#     object, like `reset`'s saved workspaces, and reaches the next call
#     through the returned LLM.
#   * Refs by ADDRESS: `log(base:)`, `rebase(ref:)`, `cherryPickPlan(from:)`,
#     `cherryPick(from:)` and the `from:` of show/fileAt/restore take a GitRef,
#     which the tool layer lifts from an address string — a git URL with a
#     fragment, or any artifact that is a GitRef, such as another agent's
#     history when a module exposes it, or this module's `saved` collection
#     (dag://committer/saved/head?saved-workspace=<sha>). Commits that exist
#     only in another agent's workspace, or that a reset orphaned, are
#     reachable without pushing anything (vito/agents#21).
#     `cherryPickPlan(from:)` plans a harvest, `cherryPick(from:)` takes it,
#     and `cherryPick(markers: true)` lands a conflicting commit as uncommitted
#     edits to resolve.
"""
Git operations on this workspace: review pending changes, read the checkout's
history, restore files, commit, reset, cherry-pick, rebase, and push.
"""
type Committer {
  # Keep the workspace being left so reset can restore pruned history too.
  # Exposed as the `saved` collection, keyed by the HEAD hash each was left at.
  let savedWorkspaces: Map[Workspace!]! = [:]

  # An in-progress rebase, between a stop at a conflict and the continue,
  # skip, or abort that resumes it. `rebaseOrigin` is the frozen workspace
  # the rebase started from: the source of the commits being replayed and
  # what abort restores; null means no rebase is in progress.
  let rebaseOrigin: Workspace = null
  # Commits of the origin still to replay, oldest first, after the stopped one.
  let rebaseRemaining: [String!]! = []
  # The origin commit whose conflicted changes sit in the working tree.
  let rebaseStopped: String! = ""
  # HEAD at the stop, to tell a resolution committed by hand from a drop.
  let rebaseStoppedHead: String! = ""
  let rebaseOnto: String! = ""
  let rebaseOntoSha: String! = ""
  let rebaseOldHead: String! = ""
  # The branch the rebase started on, "" when HEAD was detached. Rewinding
  # detaches HEAD, so this is what the finished rebase names in its push hint.
  let rebaseBranch: String! = ""

  let plumbing = ["withSavedWorkspace", "savedWorkspace", "withRebaseState", "withoutRebaseState", "saved"]

  # Bump version when stored fields are removed or change meaning, so older
  # saved tool state is discarded instead of failing to load.
  """
  Compose the git tools onto a base LLM.
  """
  agent(base: LLM!): LLM! @agent {
    base
      .withTools(currentNode, except: plumbing, version: 1)
      .withSystemPrompt(systemPrompt)
  }

  # ------------------------------------------------------- pending changes
  """
  Summarize the workspace's pending changes: one line per changed file — its
  change kind (A/M/D/R) and added/removed line counts — followed by a totals
  footer. This is the quick "git status"-style overview; reach for `diff` when
  you need the actual hunks.

  The marks are diff vocabulary describing the path's state relative to the
  last commit, NOT `git status` porcelain: there is no index here, so a file
  git would call untracked is simply `A`, and nothing distinguishes staged
  from unstaged. One consequence worth knowing: `commit` without `paths`
  picks up those `A` files too, unlike `git commit -a`.
  """
  status(
    source: Workspace!,
    """
    Glob patterns to include, relative to the workspace root (e.g. "src/**"
    or "**/*.go"). Empty summarizes all pending changes.
    """
    paths: [String!]! = [],
  ): String! {
    let scoped = pendingStats(source, paths)
    if (scoped.isEmpty) {
      if (paths.isEmpty) {
        return rebaseBanner + "No pending changes."
      }
      return rebaseBanner + "No pending changes under the given paths."
    }
    let rows = scoped.map { s =>
      `${renderKind(s.kind)}  +${toString(s.addedLines)}  -${toString(s.removedLines)}  ${s.path}`
    }
    let added = scoped.reduce(0) { acc, s => acc + (s.addedLines ?? 0) }
    let removed = scoped.reduce(0) { acc, s => acc + (s.removedLines ?? 0) }
    let footer = `${toString(scoped.length)} files changed, +${toString(added)} -${toString(removed)}`
    rebaseBanner + rows.join("\n") + "\n\n" + footer
  }

  """
  Show the workspace's pending changes as a Git-compatible unified diff — the
  full hunks across every changed file. Use `status` first for a compact
  overview; use this to actually read the edits (e.g. before committing or
  summarizing your work, or to confirm an edit landed as intended).

  Pass `paths` to scope the output: the full diff of a workspace with a lot of
  pending changes can be enormous.
  """
  diff(
    source: Workspace!,
    """
    Glob patterns to include, relative to the workspace root (e.g. "src/**"
    or "**/*.go"). Empty shows every pending change.
    """
    paths: [String!]! = [],
  ): String! {
    let changes = source.git.uncommitted
    if (changes.isEmpty) {
      return "No pending changes."
    }
    let scoped = changes.filter(include: paths).asPatch.contents
    if (scoped == "") {
      return "No pending changes under the given paths."
    }
    scoped
  }

  """
  Restore selected files from a commit without moving HEAD.

  Selected paths become identical to the source commit's tree: modified or
  deleted files are restored, and selected additions absent from that commit
  are removed. Paths outside the selection are left alone. There is no staging
  area: this replaces working-tree files, not index entries.

  Use `preview: true` to inspect the changes without applying them. Only restore
  when discarding the selected edits is intended; use `reset` to move HEAD.
  """
  restore(
    source: Workspace!,
    """
    Required, nonempty glob patterns relative to the workspace root, using the
    same conventions as status and commit (e.g. "sdk/php/generated/**"). Matches
    files in either the working tree or source commit, including deleted files.
    Fails if no files match; use "**" explicitly to select everything.
    """
    paths: [String!]!,
    """
    Commit to restore from: HEAD by default, or a short/full hash, branch, or tag.
    HEAD itself is never moved.
    """
    ref: String! = "HEAD",
    """
    Show the proposed changes without modifying the workspace.
    """
    preview: Boolean! = false,
    """
    Resolve `ref` in this git ref instead of the checkout: any GitRef
    address, including other agents' histories (FindArtifacts lists them) and
    workspaces a reset left behind
    (`dag://committer/saved/head?saved-workspace=<sha>`). With `ref` at its
    default, restores from that ref's own commit.
    """
    from: GitRef = null,
  ): Workspace! @cache(policy: FunctionCachePolicy.Never) {
    if (paths.isEmpty or paths.any { p => p.trimSpace == "" }) {
      raise "restore: specify nonempty path patterns; use ** explicitly to restore everything"
    }
    if (ref.trimSpace == "") {
      raise "restore: specify a source commit, or omit ref to use HEAD"
    }
    let before = source.snapshot
    let sha = if (from != null) {
      resolveSpecIn(from, ref)
    } else {
      resolveSpec(before, ref, head(before).commitSHA)
    }
    let tree = if (from != null) {
      from.asRepository.commit(id: sha).tree(discardGitDir: true)
    } else {
      repositoryHolding(before, sha).commit(id: sha).tree(discardGitDir: true)
    }
    # Diff BOTH trees before filtering: filtering only the source tree misses
    # additions that need removal, and filtering only the workspace misses
    # deleted files that need restoration. withChanges applies exact contents,
    # not a three-way merge that could keep edits we intended to discard.
    let changes = tree.changes(from: before.directory("/")).filter(include: paths)
    if (changes.isEmpty) {
      # Distinguish an already-restored selection from a typo. Reuse Changeset's
      # glob semantics rather than introducing a second path matcher.
      if (tree.changes(from: directory).filter(include: paths).isEmpty) {
        raise `restore: no files match paths: ${paths.join(", ")}`
      }
      print(`Selected files already match ${short(sha)}; nothing to restore.`)
      return source
    }
    print((if (preview) { "Restore preview" } else { "Restoring files" })
      + ` from ${sha}; HEAD unchanged.\n\n`
      + statBlock(changes, [], maxFiles) + "\n\n"
      + patchBlock(changes.asPatch.contents, [], 400))
    if (preview) {
      return source
    }
    # Apply to the original workspace: a snapshot pins HEAD and can lose the
    # branch attachment, which restore must preserve along with the commit.
    let restored = source.withChanges(changes)
    restored.git.uncommitted.diffStats.{{path}}.length rescue {
      e: Error => raise `restore failed: ${plainError(e.message)}`
    }
    restored
  }

  """
  Record the workspace's pending changes as a git commit and advance HEAD.

  Without `paths`, EVERYTHING `status` lists is committed — including files
  git would call untracked, since there is no staging area here (unlike
  `git commit -a`). With `paths`, only the changes on those paths are
  committed and the rest stay pending.

  Review with `status` / `diff` before committing, and read `log` first for
  scope names and wording. Subjects must use `scope: summary` and fit in 50
  characters, including the scope. A blank line and brief description are
  required; explain why when the reason is interesting and non-obvious.
  Authorship defaults to your Git identity.

  Description prose is word-wrapped at 80 characters. Existing line breaks,
  indented/fenced code, and trailers are preserved; long tokens are not split.
  Commits are automatically signed-off.
  """
  commit(
    source: Workspace!,
    """
    A `scope: summary` subject of at most 50 characters, then a blank line
    and a brief description. Include the why for interesting, non-obvious
    changes; don't pad obvious changes with boilerplate. Prose is wrapped
    at 80 characters without rewriting indented/fenced code or trailers.
    """
    message: String!,
    """
    Glob patterns to commit, relative to the workspace root (e.g. "src/**"
    or "**/*.go"). Empty commits every pending change. Selecting only one
    side of a rename selects an addition or deletion. Selections conflicting
    with the working tree fail, as does a nonempty selection matching nothing.
    """
    paths: [String!]! = [],
  ): Workspace! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): committing is a side effect on the workspace's state; a
    # later identical call must record a fresh commit, not replay the first.
    message = formatMessage(message)
    let changes = source.git.uncommitted.filter(include: paths)
    let picked = changes.diffStats.{{path}}.filter { s => !s.path.hasSuffix("/") }
    if (picked.isEmpty) {
      if (paths.isEmpty) {
        raise "nothing to commit: no pending changes"
      }
      raise "nothing to commit under the given paths (status shows what is pending)"
    }

    let committed = source.withCommit(
      changes: changes,
      message: message,
      date: currentTimestamp,
      signoff: true,
    )
    # Force the commit HERE, inside the tool: without this the failure would
    # surface later, when the engine rebinds the workspace, stripped of the
    # context of what was being committed.
    let sha = committed.git.head.commitSHA rescue {
      e: Error => raise `commit failed: ${plainError(e.message)}`
    }

    let left = committed.git.uncommitted.diffStats.{{path}}.length
    let leftNote = if (left > 0) {
      "\n" + `${toString(left)} file(s) remain uncommitted; status shows them.`
    } else {
      ""
    }
    print(`Committed ${short(sha)}: ${subject(message)} ` + `(${toString(picked.length)} file(s))` + leftNote)
    committed
  }

  """
  Reset to a commit, or restore a workspace saved by an earlier reset.

  Use this to redo or combine local commits: read `log`, choose the commit to
  return to, reset, then review `status` / `diff` and commit again. By default,
  changes from the undone commits and any pending edits remain in the workspace
  when resetting to a commit that has not been saved. With `hard: true`, the
  working tree is replaced by the target commit's tree, discarding pending edits.

  Each reset saves the workspace being left under its HEAD hash. Returning
  to a saved hash restores that entire workspace, including its pending
  edits, rather than carrying over your current working tree — unless `hard`
  is true, which restores only the saved commit's tree. The workspace
  you leave is saved in turn, so you can go back again. Full hashes or unique
  prefixes of at least four characters select saved workspaces.
  Each hash keeps its most recently saved workspace.

  Rewrites local history; only use when asked to undo or rewrite commits.
  Does not push or change the remote.
  """
  reset(
    llm: LLM!,
    source: Workspace!,
    """
    The commit to move HEAD to, or a saved HEAD hash printed by an earlier
    reset. Required so resetting never silently chooses how much history
    to undo.
    """
    commit: String!,
    """
    Replace the working tree with the target commit's tree, discarding pending
    edits even for a saved workspace. Defaults to false. The workspace being
    left is still saved for recovery.
    """
    hard: Boolean! = false,
  ): LLM! @cache(policy: FunctionCachePolicy.Never) {
    let want = commit.trimSpace
    if (want == "") {
      raise "reset: specify the commit to move HEAD to (log shows the history)"
    }
    let before = source.snapshot
    let previous = head(before).commitSHA
    let matches = savedWorkspaces.keys.filter { sha =>
      want.split("").length >= 4 and sha.hasPrefix(want)
    }
    if (matches.length > 1) {
      raise `reset: ambiguous saved commit "${want}"; use a longer hash`
    }
    let remembered = savedWorkspaces[matches.takeFirst.join("")]
    let target = if (remembered != null) {
      if (hard) {
        remembered.withReset(commit: remembered.git.head.commitSHA, hard: true)
      } else {
        remembered
      }
    } else {
      before.withReset(commit: want, hard: hard)
    }
    # Force evaluation before returning the workspace, like commit: failures
    # should surface here, not while the agent is rebinding its workspace.
    let sha = target.git.head.commitSHA rescue {
      e: Error => raise `reset failed: ${plainError(e.message)}`
    }
    let note = if (hard) {
      "Working tree replaced with the target commit's tree; pending edits discarded."
    } else if (remembered != null) {
      "Restored the saved workspace, including its pending edits."
    } else {
      "Working tree preserved; review status / diff before committing again."
    }
    print(`Reset HEAD from ${previous} to ${sha}. ${note} `
      + `To return to the workspace you left, reset to ${previous}; `
      + `its commits stay reachable as dag://committer/saved/head?saved-workspace=${previous}.`)
    # A self-call gives the updated toolset an engine identity. Rebind both
    # it and the workspace through the continuation so the map persists.
    let tools = currentNode.{{... on Dagger.Committer!}}
      .withSavedWorkspace(workspace: before)
    llm.withTools(tools, except: plumbing).withWorkspace(target)
  }

  # ------------------------------------------------------------ cherry-pick
  """
  Plan cherry-picking commits from another git ref into HEAD, oldest first.

  Lists commits in source not in HEAD, annotated with what `cherryPick`
  would do: new, already had, redundant, or CONFLICT with the reason,
  obstructing paths, and recovery hints. This does not change the workspace.
  Use `show(commit:, from:)` to inspect a commit's patch before taking it.
  For our own history excluding another ref, use `log(base:)` instead.
  """
  cherryPickPlan(
    source: Workspace!,
    """
    The source ref to plan taking commits from: any GitRef address, including
    other agents' histories (FindArtifacts lists them) and saved workspaces.
    """
    from: GitRef!,
    """
    Maximum number of commits to show. Selects the newest N commits of the
    plan, displays them oldest first, and reports how many older ones were
    omitted.
    """
    limit: Int! = 20,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # The source may be a live agent's ref; never reuse a stale plan.
    if (limit < 1) {
      raise "cherryPickPlan: limit must be positive"
    }
    let theirs = from.asWorkspace
    let picks = source.compareCommitsFrom(source: theirs, maxCommits: replayBound).{{
      commit.{{sha, authoredDate, authorName, message}},
      status,
      reason,
      conflictPaths
    }} rescue {
      e: Error => raise `cherryPickPlan: planning against the ref failed: ${plainError(e.message)}`
    }
    let direction = "Commits in source not in HEAD\n\n"
    if (picks.isEmpty) {
      return rebaseBanner + direction + "HEAD already has every commit on the ref: nothing to cherry-pick."
    }
    let newOnes = picks.filter { p => p.status == WorkspaceCommitPickStatus.PICKABLE }
    let had = picks.filter { p => p.status == WorkspaceCommitPickStatus.PICKED }
    let redundant = picks.filter { p => p.status == WorkspaceCommitPickStatus.REDUNDANT }
    let conflicting = picks.filter { p => p.status == WorkspaceCommitPickStatus.CONFLICT }
    let header = `${toString(picks.length)} commit(s) on the ref that HEAD lacks, oldest first: `
      + `${toString(newOnes.length)} new, ${toString(had.length)} already had, `
      + `${toString(redundant.length)} redundant, ${toString(conflicting.length)} conflicting`
    let shown = picks.takeLast(limit)
    let entries = shown.map { p =>
      let paths = if (p.conflictPaths.isEmpty) { "" } else { " " + p.conflictPaths.join(", ") }
      let line = `${short(p.commit.sha)}  ${when(p.commit.authoredDate)}  ${p.commit.authorName}  [${pickLabel(p.status, p.reason)}${paths}]`
      line + "\n" + indent(subject(p.commit.message))
    }
    let omitted = picks.length - shown.length
    let truncation = if (omitted > 0) {
      "\n\n" + `(${toString(omitted)} older commit(s) not shown; raise limit to see them)`
    } else {
      ""
    }
    let recovery = if (conflicting.isEmpty) {
      ""
    } else {
      "\n\n" + conflicting.map { p => `${short(p.commit.sha)}: ${pickRecovery(p.reason, short(p.commit.sha))}` }.join("\n")
    }
    let next = if (newOnes.isEmpty) {
      ""
    } else {
      "\n\n" + "cherryPick(from: <the same ref>) takes the new ones, authorship intact; show(commit:, from:) reads one first."
    }
    rebaseBanner + direction + header + "\n\n" + entries.join("\n\n") + truncation + recovery + next
  }

  """
  Cherry-pick commits from another git ref onto HEAD, keeping their
  authorship, message and date.

  `from` is any GitRef address, including other agents' histories
  (FindArtifacts lists them), a workspace a reset left behind
  (`dag://committer/saved/head?saved-workspace=<sha>`), or a git URL with a
  fragment. Without `commits`, every commit on it that HEAD lacks is taken,
  oldest first; fast-forwarding when possible, so hashes may change.
  `cherryPickPlan(from:)` shows the plan first.

  Applies ONLY what applies cleanly: commits already in HEAD, and commits
  whose content is already present, are skipped, and a commit that conflicts
  is reported rather than forced. Your pending edits survive, but a commit
  touching a path you have edited is a conflict: commit or revert those
  edits and try again.

  For a commit that still conflicts, `markers: true` with exactly that one
  commit is `git cherry-pick -n`: it applies the commit as UNCOMMITTED edits,
  with conflict markers where it no longer fits, and prints the original
  message to reuse. Resolve the markers and commit it yourself — the
  authorship becomes yours, which is why a plain cherryPick is always worth
  trying first.
  """
  cherryPick(
    source: Workspace!,
    """
    The ref to take commits from, by address.
    """
    from: GitRef!,
    """
    Commits to pick, as full or short hashes reachable from `from`. They are
    always applied in history order. Empty takes everything HEAD lacks.
    """
    commits: [String!]! = [],
    """
    Apply exactly one commit (in `commits`) as uncommitted edits, leaving
    conflict markers where it no longer applies, instead of committing it.
    """
    markers: Boolean! = false,
  ): Workspace! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): the ref may point at a live agent's history, and a
    # later identical call must plan against HEAD as it is then.
    if (markers) {
      if (commits.length != 1) {
        raise "cherryPick: markers: true takes exactly one commit, e.g. commits: [\"<sha>\"]; cherryPickPlan(from:) lists them"
      }
      return pickWithMarkers(source, from, commits[0] ?? "")
    }
    let theirs = from.asWorkspace
    let picks = source.compareCommitsFrom(source: theirs, commits: commits, maxCommits: replayBound).{{
      commit.{{sha, message}},
      status,
      reason,
      conflictPaths
    }} rescue {
      e: Error => raise `cherryPick: planning against the ref failed: ${plainError(e.message)}`
    }
    if (picks.isEmpty) {
      print("Nothing to cherry-pick: HEAD already has every commit on the ref.")
      return source
    }
    let pickable = picks.filter { p => p.status == WorkspaceCommitPickStatus.PICKABLE }
    let conflicting = picks.filter { p => p.status == WorkspaceCommitPickStatus.CONFLICT }
    let skipped = picks.length - pickable.length - conflicting.length
    let conflictBlock = if (conflicting.isEmpty) {
      ""
    } else {
      "\n\n" + `CONFLICT — ${toString(conflicting.length)} commit(s) NOT picked:` + "\n"
        + conflicting.map { p =>
          `  ${short(p.commit.sha)} ${subject(p.commit.message)}` + "\n"
            + (if (p.conflictPaths.isEmpty) { "    " } else { `    ${p.conflictPaths.join(", ")}: ` })
            + pickConflict(p.reason) + "\n"
            + `    -> ${pickRecovery(p.reason, short(p.commit.sha))}`
        }.join("\n")
    }
    let skippedNote = if (skipped == 0) {
      ""
    } else {
      "\n" + `(${toString(skipped)} already present, skipped)`
    }
    if (pickable.isEmpty) {
      print("Nothing new to cherry-pick." + skippedNote + conflictBlock)
      return source
    }
    let picked = source.withCommitsFrom(
      source: theirs,
      commits: pickable.map { p => p.commit.sha },
      maxCommits: replayBound,
    )
    # Force the apply here, with the commits involved in hand, rather than
    # later when the engine rebinds the workspace.
    let newHead = head(picked).commitSHA rescue {
      e: Error => raise `cherryPick: applying ${toString(pickable.length)} commit(s) failed: ${plainError(e.message)}`
    }
    # Report what actually landed: a non-fast-forward pick makes new commits,
    # whose hashes differ from the ref's. log() lists newest first.
    let landed = head(picked).log(limit: replayBound, base: head(source)).{{sha, message}} rescue {
      e: Error => raise `cherryPick: listing the picked commits failed: ${plainError(e.message)}`
    }
    let oldestFirst = landed.map { c => `  ${short(c.sha)} ${subject(c.message)}` }.reduce([] :: [String!]!) { acc, line => [line] + acc }
    print(`Cherry-picked ${toString(landed.length)} commit(s), oldest first; HEAD is now ${short(newHead)}:` + "\n"
      + oldestFirst.join("\n")
      + skippedNote + conflictBlock)
    picked
  }

  """
  Save a workspace for reset recovery. Internal bookkeeping, not an agent tool.
  """
  withSavedWorkspace(workspace: Workspace!): Committer! {
    self.savedWorkspaces = savedWorkspaces.with(workspace.git.head.commitSHA, workspace)
    self
  }

  """
  The workspace `reset` saved under this HEAD hash. Collection plumbing:
  Saved.get reaches the map through it, since `savedWorkspaces` is private.
  """
  savedWorkspace(sha: String!): Workspace! {
    let remembered = savedWorkspaces[sha]
    if (remembered == null) {
      raise `no workspace was saved at ${sha}; saved hashes: ${savedWorkspaces.keys.join(", ")}`
    }
    remembered
  }

  """
  The workspaces `reset` left behind, as a collection keyed by the HEAD hash
  each was at when it was saved.

  A reset orphans the commits it moved away from; each saved workspace keeps
  them reachable. `dag://committer/saved/head?saved-workspace=<sha>` is a
  saved workspace's HEAD as a GitRef: pass it to `show(from:)`,
  `fileAt(from:)`, `restore(from:)` or `cherryPick(from:)` to read or reapply
  those commits without resetting back.
  """
  saved: Saved! {
    Saved(currentNode.{{... on Dagger.Committer!}}, savedWorkspaces.keys)
  }

  # ---------------------------------------------------------------- rebase
  """
  Rebase this branch's commits onto another ref, stopping at each conflict
  for you to resolve.

  The target `ref` is any GitRef address — a git URL with a fragment, such
  as "https://github.com/org/repo#main", or an artifact such as another
  agent's history (FindArtifacts lists them). The rebase rewinds to where
  this branch forked from the target, fast-forwards to its tip, and replays
  your commits on top — oldest first, authors and dates intact, merge
  commits left out, commits already on the target dropped.

  Pass `from` to replay only the commits after it — `git rebase --onto
  <ref> <from>` — when this branch was stacked on another branch that has
  since been rewritten and merged: the old parent head leaves the parent's
  stale commits out of the replay.

  When a commit no longer applies cleanly the rebase STOPS: the commits
  before it are on the new base, and its changes are merged into your
  working tree three-way, with git-style conflict markers (<<<<<<<) where
  the two sides disagree. Resolve the markers with your edit tools, then
  `rebaseContinue` records the commit (original message and author kept,
  unless you pass a new message) and carries on to the next conflict or the
  end. `rebaseSkip` drops the stopped commit instead; `rebaseAbort` restores
  the workspace you started from.

  Requires a clean working tree: commit pending edits first. Rewrites local
  history and does not push. The rewind leaves HEAD detached, so publishing
  the result is `push` with the branch named and `expectedRemoteSHA` (a
  lease) set — the finished rebase spells the call out.
  """
  rebase(
    llm: LLM!,
    source: Workspace!,
    """
    The ref to rebase onto: any GitRef address, including other agents'
    histories (FindArtifacts lists them), or a git URL with a fragment such
    as "https://github.com/org/repo#main".
    """
    ref: GitRef!,
    """
    Replay only the commits after this one (a sha or ref in this checkout's
    history), like `git rebase --onto <ref> <from>`. Use it when the branch
    was stacked on another branch that has since been rewritten and merged:
    pass the old parent head so its stale commits are not replayed. Empty
    replays everything since the fork point from `ref`.
    """
    from: String! = "",
  ): LLM! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): resolves a live remote tip and rewrites the workspace; a
    # later identical call must do both again.
    if (rebaseOrigin != null) {
      raise `rebase: a rebase is already in progress, stopped at ${short(rebaseStopped)}; ` + "finish it with rebaseContinue, or rebaseAbort to return to where you started"
    }
    if (!source.git.uncommitted.isEmpty) {
      raise "rebase: the working tree has pending changes; commit them first (status shows them)"
    }
    # The branch name is read from the live workspace: the snapshot below is
    # pinned to its commit and no longer knows it.
    let branchName = branchOf(source)
    # Frozen: the source of the replayed commits must be a stable value, and
    # it doubles as what rebaseAbort restores.
    let origin = source.snapshot
    let oldHead = head(origin).commitSHA rescue {
      e: Error => raise "rebase: " + noHistory(e.message)
    }

    let upstream = ref
    let ontoSha = upstream.commitSHA rescue {
      e: Error => raise `rebase: cannot read the ref to rebase onto: ${plainError(e.message)}`
    }
    let label = refLabel(upstream, ontoSha)
    # `from` narrows the replay to the commits after it, the way `git rebase
    # --onto <ref> <from>` does. It must be on this branch: anything else
    # would replay commits from the fork point instead, silently.
    let since = from.trimSpace
    let replayBase = if (since == "") {
      upstream
    } else {
      let fromRef = repository(origin).ref(name: since)
      let fromSha = fromRef.commitSHA rescue {
        e: Error => raise `rebase: cannot resolve from: "${since}" in this checkout: ${plainError(e.message)}`
      }
      let shared = head(origin).commonAncestor(other: fromRef).commitSHA rescue {
        e: Error => raise `rebase: from: "${since}" shares no history with HEAD: ${plainError(e.message)}`
      }
      if (shared != fromSha) {
        raise `rebase: from: "${since}" (${short(fromSha)}) is not an ancestor of HEAD (${short(oldHead)}); ` + "pass a commit on this branch, e.g. the old head of the branch it was stacked on"
      }
      fromRef
    }
    let replayLabel = if (since == "") { label } else { since }
    let newBase = rebasedBase(origin, upstream, label)
    # Our side of the fork, linearized the way `git rebase` does: merge
    # commits are not replayed, only the commits they brought in that
    # upstream does not already have. Asking the engine for "all new
    # commits" instead would select the merges too, and refuse them.
    let ours = head(origin).log(limit: replayBound, base: replayBase).{{sha, message, parentShas}} rescue {
      e: Error => raise replayError(
        `listing this branch's commits since ${replayLabel}`,
        label,
        e.message,
      )
    }
    let linear = ours.filter { c => c.parentShas.length <= 1 }.map { c => c.sha }
    let merges = ours.filter { c => c.parentShas.length > 1 }
    let note = if (merges.isEmpty) {
      ""
    } else {
      `Left out ${toString(merges.length)} merge commit(s), whose merged-in commits are replayed individually: ` + merges.map { c => `${short(c.sha)} ${subject(c.message)}` }.join(", ") + "."
    }
    advance(llm, origin, newBase, linear, label, ontoSha, oldHead, branchName, note)
  }

  """
  Continue a stopped rebase: record the resolved commit and replay the rest.

  Call it once the conflict markers left by `rebase` are resolved. The
  pending edits are committed with the stopped commit's original message,
  author, and date — pass `message` to amend the message instead. Then the
  remaining commits are replayed, stopping again at the next conflict.

  If you already committed the resolution yourself, that commit stands and
  the replay simply continues. If nothing is left to commit (the change was
  already upstream), the commit is dropped, as git's rebase would.
  """
  rebaseContinue(
    llm: LLM!,
    source: Workspace!,
    """
    Replacement commit message for the resolved commit. Omitted keeps the
    original message.
    """
    message: String = null,
  ): LLM! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): reads the live working tree and advances module state.
    let origin = rebaseOrigin
    if (origin == null) {
      raise "rebaseContinue: no rebase is in progress; `rebase` starts one"
    }
    let pending = source.git.uncommitted
    let marked = conflictedFiles(pending.asPatch.contents)
    if (!marked.isEmpty) {
      raise `rebaseContinue: conflict markers remain in ${marked.join(", ")}; resolve them first`
    }
    let headNow = head(source).commitSHA
    let original = repository(origin).commit(id: rebaseStopped).{{
      message,
      authorName,
      authorEmail,
      authoredDate
    }}

    let current = source
    let note = ""
    if (headNow != rebaseStoppedHead) {
      # The agent recorded the resolution with `commit` (or otherwise moved
      # HEAD); its commit stands.
      if (!pending.isEmpty) {
        raise "rebaseContinue: HEAD moved past the stopped commit but edits are still pending; commit or revert them, then continue"
      }
      note = `Kept your own commit ${short(headNow)} in place of ${short(rebaseStopped)}.`
    } else if (pending.isEmpty) {
      note = `Dropped ${short(rebaseStopped)}: nothing was left to commit after resolution.`
    } else {
      # Preserving someone's history, not writing new: no style enforcement,
      # no sign-off, the original author and date.
      current = source.withCommit(
        changes: pending,
        message: message ?? original.message,
        date: original.authoredDate,
        authorName: original.authorName,
        authorEmail: original.authorEmail,
      )
      let sha = head(current).commitSHA rescue {
        e: Error => raise `rebaseContinue: recording the resolved commit failed: ${plainError(e.message)}`
      }
      note = `Recorded ${short(rebaseStopped)} as ${short(sha)}` + (if (message == null) { "." } else { " with the new message." })
    }
    advance(
      llm,
      origin,
      current,
      rebaseRemaining,
      rebaseOnto,
      rebaseOntoSha,
      rebaseOldHead,
      rebaseBranch,
      note,
    )
  }

  """
  Drop the commit a rebase stopped at and replay the rest.

  Discards the pending edits (the stopped commit's conflicted changes) and
  continues as if that commit never existed — `git rebase --skip`. Prefer
  resolving with `rebaseContinue`; skip only when the commit is genuinely
  obsolete.
  """
  rebaseSkip(
    llm: LLM!,
    source: Workspace!,
  ): LLM! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): reads the live working tree and advances module state.
    let origin = rebaseOrigin
    if (origin == null) {
      raise "rebaseSkip: no rebase is in progress; `rebase` starts one"
    }
    let clean = source.withReset(commit: head(source).commitSHA, hard: true)
    head(clean).commitSHA rescue {
      e: Error => raise `rebaseSkip: discarding the pending edits failed: ${plainError(e.message)}`
    }
    advance(
      llm,
      origin,
      clean,
      rebaseRemaining,
      rebaseOnto,
      rebaseOntoSha,
      rebaseOldHead,
      rebaseBranch,
      `Skipped ${short(rebaseStopped)}.`,
    )
  }

  """
  Abandon a stopped rebase and restore the workspace exactly as it was
  before `rebase` — history, branch, and all. Nothing is kept from the
  partial replay.
  """
  rebaseAbort(
    llm: LLM!,
  ): LLM! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): rebinds the workspace and clears module state.
    let origin = rebaseOrigin
    if (origin == null) {
      raise "rebaseAbort: no rebase is in progress; there is nothing to undo"
    }
    let tools = currentNode.{{... on Dagger.Committer!}}.withoutRebaseState
    print(`Rebase aborted. Workspace restored to ${short(rebaseOldHead)}, as it was before rebase.`)
    llm.withTools(tools, except: plumbing).withWorkspace(origin)
  }

  """
  Record an in-progress rebase. Internal bookkeeping, not an agent tool.
  """
  withRebaseState(
    origin: Workspace!,
    remaining: [String!]!,
    stopped: String!,
    stoppedHead: String!,
    onto: String!,
    ontoSha: String!,
    oldHead: String!,
    branch: String!,
  ): Committer! {
    self.rebaseOrigin = origin
    self.rebaseRemaining = remaining
    self.rebaseStopped = stopped
    self.rebaseStoppedHead = stoppedHead
    self.rebaseOnto = onto
    self.rebaseOntoSha = ontoSha
    self.rebaseOldHead = oldHead
    self.rebaseBranch = branch
    self
  }

  """
  Forget a finished or abandoned rebase. Internal bookkeeping, not an agent tool.
  """
  withoutRebaseState: Committer! {
    self.rebaseOrigin = null
    self.rebaseRemaining = []
    self.rebaseStopped = ""
    self.rebaseStoppedHead = ""
    self.rebaseOnto = ""
    self.rebaseOntoSha = ""
    self.rebaseOldHead = ""
    self.rebaseBranch = ""
    self
  }

  """
  Push the workspace's committed history to its remote.

  Publishes HEAD — everything `commit` has recorded — to the repository the
  checkout was cloned from. Pending changes are NOT pushed: commit first,
  then push. The remote branch is created when it does not exist yet.

  A push the remote rejects (its branch moved past ours) is an error, never a
  takeover. To overwrite anyway, pass `expectedRemoteSHA`: the push then
  succeeds only while the remote branch still points at that sha — a lease,
  like `--force-with-lease` — so use it only after reading what the remote
  moved to, and only when discarding that is the intent.
  """
  push(
    source: Workspace!,
    """
    Destination branch on the remote. Empty pushes the current branch under
    its own name; required when HEAD is not on a branch.
    """
    branch: String! = "",
    """
    Lease on the remote branch: omit for a plain push (fast-forwards and
    branch creation only), or pass the sha the remote branch is expected to
    point at to force-update it from exactly that state.
    """
    expectedRemoteSHA: String = null,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): pushing is an effect on the remote; a later identical
    # call must push again, not replay the first result.
    #
    # The HEAD probe is the same first-read guard as the history tools': a
    # workspace with no readable history gets the plain answer, not a push
    # error.
    head(source).commitSHA rescue {
      e: Error => return noHistory(e.message)
    }
    let result = head(source).push(
      branch: branch,
      expectedRemoteSHA: expectedRemoteSHA,
    ).{{ref, previousSHA, sha, disposition}} rescue {
      e: Error => raise `push failed: ${plainError(e.message)}`
    }
    let summary = case (result.disposition) {
      GitPushDisposition.UP_TO_DATE => `${result.ref} is already up to date at ${short(result.sha)}; nothing to push.`

      GitPushDisposition.CREATED => `Pushed ${result.ref} (new branch) at ${short(result.sha)}.`

      GitPushDisposition.FORCED => `Pushed ${result.ref}: forced ${short(result.previousSHA)} -> ${short(result.sha)}.`

      else => `Pushed ${result.ref}: ${short(result.previousSHA)} -> ${short(result.sha)}.`
    }
    let left = source.git.uncommitted.diffStats.{{path}}.length
    let leftNote = if (left > 0) {
      "\n" + `${toString(left)} file(s) remain uncommitted and were not pushed; status shows them.`
    } else {
      ""
    }
    summary + leftNote
  }

  # --------------------------------------------------------------- history
  """
  Show the repository's commit history, newest first.

  Each entry is one line — short hash, date, author, subject — and
  `full: true` prints every commit's full message body.

  Use it to learn how this repository writes commit messages (`full: true`
  prints the bodies), or — with `paths` — to find out who last touched a file
  and why. For one commit's actual patch, use `show`.

  With `base`, list only commits reachable from our HEAD but not that ref,
  still newest first. Paths, message search, and limits apply within that
  selected history. To plan taking another ref's commits into HEAD, use
  `cherryPickPlan(from:)` instead.
  """
  log(
    source: Workspace!,
    """
    Maximum number of commits to show, newest first, after filtering.
    """
    limit: Int! = 20,
    """
    Only show commits touching these Git path patterns, relative to the
    repository root (e.g. "src/**" or "**/*.go"), like `git log -- <paths>`.
    Empty includes all paths. Combined with `base`, filters only HEAD's
    commits that are not reachable from that ref.
    """
    paths: [String!]! = [],
    """
    Only show commits whose message matches this regular expression, matched
    case-insensitively over a bounded window of recent commits — the footer
    reports how many were searched. The pattern is matched against the WHOLE
    message, body included — a commit can match on something its one-line
    subject never mentions, so pass `full: true` to see where the hit is — and
    `^` anchors to the start of the message, not to each line. With `base`,
    the search window contains only HEAD's commits not reachable from base.
    """
    grep: String = null,
    """
    Print the full message body of every commit, not just the subject.
    """
    full: Boolean! = false,
    """
    Exclude commits reachable from this git ref, listing only commits in
    our HEAD but not base. Any GitRef address, including other agents'
    histories (FindArtifacts lists them).
    """
    base: GitRef = null,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): base may point at a live agent's history.
    let selection = if (base == null) { "" } else { "Commits in HEAD not in base\n\n" }
    # One PAST `limit` when there is no grep to widen the walk: the footer's
    # "there is more below" can only be honest if the walk was allowed to find
    # one more commit than the listing prints. `takeFirst(limit)` below drops it
    # again, so the extra entry is never rendered.
    let scanned = if (grep == null) { limit + 1 } else { searchWindow }
    # Exclude base in the walk itself, before paths and the scan limit.
    let walk = head(source).log(
      limit: scanned,
      base: base,
      paths: if (paths.isEmpty) { null } else { paths },
    ).{{shortSha, authorName, authoredDate, message}} rescue {
      e: Error => return selection + noHistory(e.message)
    }
    # The first read of the workspace's git state: a synthetic workspace, a
    # checkout that is not a git repository at all, or a fresh `git init`
    # with nothing committed yet all give out here.

    let matched = if (grep == null) {
      walk
    } else {
      # Case-insensitive by construction: a String has to be cast into the
      # Regexp slot, since only literals coerce.
      let pattern = ("(?i)" + (grep ?? "")) :: Regexp!
      walk.filter { c => c.message.containsMatch(pattern) }
    }
    let shown = matched.takeFirst(limit)

    if (shown.isEmpty) {
      if (base != null) {
        let scope = if (paths.isEmpty) { "" } else { " touching the given paths" }
        let empty = if (grep == null) {
          "No commits in HEAD not in base" + scope + "."
        } else {
          `No commit message matches "${grep ?? ""}" in ${toString(walk.length)} searched commits in HEAD not in base` + scope + "."
        }
        return selection + empty
      }
      return emptyLog(paths, grep)
    }

    let entries = shown.map { c =>
      let header = `${c.shortSha}  ${when(c.authoredDate)}  ${c.authorName}`
      if (full) {
        header + "\n" + indent(clampLines(
          c.message.trimSpace,
          messageLines,
          `(message truncated — show(commit: "${c.shortSha}") for all of it)`,
        ))
      } else {
        header + "\n" + indent(subject(c.message))
      }
    }

    # Footer notes, in the order a reader wants them: what the search covered,
    # then whether history continues below it.
    let searchNote = if (grep == null) {
      ""
    } else {
      let more = matched.length - shown.length
      # `paths` narrows the walk before the pattern is applied, so the window
      # the match count refers to is the recent commits that touched those
      # paths — not recent history as a whole.
      let window = if (base != null) {
        `${toString(walk.length)} searched commits in HEAD not in base`
          + (if (paths.isEmpty) { "" } else { " touching the given paths" })
      } else if (paths.isEmpty) {
        `the last ${toString(searchWindow)} commits`
      } else {
        `the last ${toString(searchWindow)} commits touching the given paths`
      }
      `(${toString(matched.length)} match(es) in ${window}` + (if (more > 0) { `; ${toString(more)} not shown, raise limit)` } else { ")" })
    }
    # Only meaningful without a grep: a grep listing walks the whole search
    # window and reports its own leftovers above.
    let moreNote = if (grep == null and matched.length > shown.length) {
      "(more history below; raise limit to see it)"
    } else {
      ""
    }
    let notes = [searchNote, moreNote].filter { n => n != "" }
    let footer = if (notes.isEmpty) { "" } else { "\n\n" + notes.join("\n") }

    selection + banner(source) + "\n\n" + entries.join("\n\n") + footer
  }

  """
  Show one commit in full: its metadata, message, per-file stats and patch —
  `git show` for any commit in the checkout's history.

  `commit` names it: "HEAD" (the newest commit), a short or full hash as
  printed by `log`, or a tag name. With `against`, the patch is the
  difference between the two commits instead of the commit's own change,
  which is how you review a whole stack ("everything since <sha>") or compare
  against a release tag.

  Both halves are capped, because a single commit can touch thousands of
  files: the patch stops at `maxLines`, and the file stats list is capped too.
  The totals line above those rows always counts the whole commit, so you can
  see how much was left out — scope with `paths` to see the rest, rather than
  raising `maxLines`.
  """
  show(
    source: Workspace!,
    """
    The commit to show: "HEAD", a short or full hash from `log`, or a tag
    name. Hashes and names are resolved directly by the repository.
    """
    commit: String! = "HEAD",
    """
    Show the difference from this commit to `commit` instead of the change
    `commit` itself made. Same spelling rules as `commit`.
    """
    against: String = null,
    """
    Glob patterns to include, relative to the repository root (e.g. "src/**"
    or "**/*.go"). Empty shows all changes. Totals still count the whole
    commit; file rows and the patch are limited to the matching changes.
    """
    paths: [String!]! = [],
    """
    Maximum number of patch lines to print. The totals line says how big the
    change really is; scope with `paths` instead of raising this too far.
    """
    maxLines: Int! = 400,
    """
    Resolve `commit` and `against` in this git ref instead of the checkout:
    any GitRef address, including other agents' histories (FindArtifacts
    lists them) and workspaces a reset left behind
    (`dag://committer/saved/head?saved-workspace=<sha>`). With `commit` at
    its default, shows that ref's own commit.
    """
    from: GitRef = null,
  ): String! {
    # The first read of the workspace's git state: a checkout with no readable
    # history gives out here, with a plain answer instead of an engine error.
    let headSha = if (from != null) {
      from.commitSHA
    } else {
      head(source).commitSHA rescue {
        e: Error => return noHistory(e.message)
      }
    }
    let want = if (from != null) {
      resolveSpecIn(from, commit)
    } else {
      resolveSpec(source, commit, headSha)
    }

    let repo = if (from != null) {
      from.asRepository
    } else {
      repositoryHolding(source, want)
    }
    let target = repo.commit(id: want).{{
      sha,
      shortSha,
      authorName,
      authorEmail,
      authoredDate,
      message,
      parentShas
    }}
    let baseSpec = if (against == null) {
      target.parentShas.takeFirst.join("")
    } else if (from != null) {
      resolveSpecIn(from, against ?? "")
    } else {
      resolveSpec(source, against ?? "", headSha)
    }
    let changes = if (against == null) {
      repo.commit(id: want).changes
    } else {
      repo.commit(id: want).changes(against: repo.commit(id: baseSpec))
    }
    let patch = changes.filter(include: paths).asPatch.contents
    let mergeNote = if (against == null and target.parentShas.length > 1) {
      "\n" + `(merge commit: shown against its first parent ${short(baseSpec)})`
    } else {
      ""
    }
    let meta = if (against == null) {
      `commit ${target.sha}` + "\n" + `Author: ${target.authorName} <${target.authorEmail}>` + "\n" + `Date:   ${when(target.authoredDate)}` + mergeNote + "\n\n" + indent(target.message.trimSpace)
    } else {
      `Difference from ${short(baseSpec)} to ${target.shortSha}` + "\n" + `  ${target.shortSha}  ${when(target.authoredDate)}  ${target.authorName}  ${subject(target.message)}`
    }
    meta + "\n\n" + statBlock(changes, paths, maxFiles) + "\n\n" + patchBlock(
      patch,
      paths,
      maxLines,
    )
  }

  """
  Read a file as it was at a commit — the workspace tool `read`, pointed at
  history instead of the working tree.

  Use it to recover something you deleted, to see what a file looked like
  before a change, or to read a file that no longer exists. Lines are printed
  with their numbers, and the output is capped like `read`: page through a
  long file with `offset`.
  """
  fileAt(
    source: Workspace!,
    """
    Path of the file, relative to the repository root.
    """
    path: String!,
    """
    The commit to read it at: "HEAD", a short or full hash from `log`, or a
    tag name.
    """
    commit: String! = "HEAD",
    """
    Line offset to start reading from.
    """
    offset: Int! = 0,
    """
    Maximum number of lines to print.
    """
    limit: Int! = 400,
    """
    Resolve `commit` in this git ref instead of the checkout: any GitRef
    address, including other agents' histories (FindArtifacts lists them)
    and workspaces a reset left behind
    (`dag://committer/saved/head?saved-workspace=<sha>`). With `commit` at
    its default, reads at that ref's own commit.
    """
    from: GitRef = null,
  ): String! {
    # The first read of the workspace's git state: a checkout with no readable
    # history gives out here, with a plain answer instead of an engine error.
    let headSha = if (from != null) {
      from.commitSHA
    } else {
      head(source).commitSHA rescue {
        e: Error => return noHistory(e.message)
      }
    }
    let want = if (from != null) {
      resolveSpecIn(from, commit)
    } else {
      resolveSpec(source, commit, headSha)
    }
    let repo = if (from != null) {
      from.asRepository
    } else {
      repositoryHolding(source, want)
    }
    let target = repo.commit(id: want).{{shortSha, message, authoredDate}}
    let contents = repo.commit(id: want).tree(discardGitDir: true).file(path).contents rescue {
      e: Error => raise `${path} does not exist at ${target.shortSha}: ${plainError(e.message)}` + ` — it may have been added later, deleted, or renamed; log(paths: ["${path}"]) shows the commits that touched it`
    }
    let lines = contents.split("\n")
    let page = lines.dropFirst(offset).takeFirst(limit)
    let numbered = page.map { line, i =>
      `${toString(offset + i + 1)}`.padLeft(6) + "→" + line
    }
    let shown = offset + page.length
    let footer = if (shown < lines.length) {
      "\n\n" + `(showing lines ${toString(offset + 1)}-${toString(shown)} of ${toString(lines.length)}; ` + `pass offset: ${toString(shown)} for more)`
    } else {
      ""
    }
    `${path} at ${target.shortSha} (${when(target.authoredDate)}) — ${subject(target.message)}` + "\n\n" + numbered.join("\n") + footer
  }

  # ---------------------------------------------------------------- helpers

  # Bound commit-message searches in `log`; commit resolution has no window.
  let searchWindow: Int! = 500

  # Per-commit message cap in `log`, so one essay-length commit body cannot
  # crowd out the rest of the listing.
  let messageLines: Int! = 24

  # Per-commit file-row cap. A single commit can touch thousands of files
  # (generated code, a vendor bump), and the stat list alone would then be the
  # whole answer.
  let maxFiles: Int! = 40

  let head(source: Workspace!): Dagger.GitRef! {
    source.git.head
  }

  # The pending changes' per-file stats, scoped to `paths`, for status.
  let pendingStats(
    source: Workspace!,
    paths: [String!]!,
  ): [{{kind: DiffStatKind!, addedLines: Int!, removedLines: Int!, path: String!, oldPath: String}}!]! {
    source.git.uncommitted.filter(include: paths).diffStats.{{kind, addedLines, removedLines, path, oldPath}}
  }

  # Engine errors carry a "[traceparent:<trace>-<span>]" marker so an agent can
  # go read the failing span's logs. Every failure these tools rescue, though,
  # is an ordinary mistake in a tool argument — a typo in a commit spelling, a
  # file that did not exist yet at that commit — not an engine fault, and the
  # marker only invites a log dive over a typo. Drop it from the text that gets
  # embedded in a friendly message; keep everything the message actually says.
  let plainError(message: String!): String! {
    message.replaceMatches(`\s*\[traceparent:[^\]]*\]`, with: "").trimSpace
  }

  # Where each history tool's FIRST read of the workspace's git state sends its
  # failure: a synthetic workspace, a checkout that is not a git repository at
  # all, or a fresh `git init` with nothing committed yet. The plain-language
  # answer sits on that first read — `log`'s history walk, and the HEAD probe
  # in `show` and `fileAt` — before anything else touches the repository.
  let noHistory(reason: String!): String! {
    `This workspace has no readable git history (${plainError(reason)}). ` + "Your pending edits are still visible with status / diff."
  }

  let repository(source: Workspace!): GitRepository! {
    source.git.head.asRepository
  }

  # The engine bounds a replay by the commits on EITHER side of the fork
  # point — upstream's new commits count, not just ours — and 1000 is the
  # most it accepts. A busy upstream can outrun that in weeks.
  let replayBound: Int! = 1000

  # Engine replay failures in rebase vocabulary. The bound is the one
  # failure with a workaround worth spelling out; everything else passes
  # through cleaned.
  let replayError(doing: String!, onto: String!, reason: String!): String! {
    if (reason.contains("maxCommits")) {
      return `rebase: ${doing} failed: ${onto} has moved more than ${toString(replayBound)} commits past this branch's fork point, ` + "which is more than the engine can replay across at once. Rebase onto an older commit of it first " + `(a ref address ending in #<sha>), then onto ${onto}.`
    }
    `rebase: ${doing} failed: ${plainError(reason)}`
  }

  # The new base for a rebase: `origin` rewound to where it forked from
  # `upstream`, then fast-forwarded to upstream's tip. Built from the
  # workspace itself rather than from a checkout of the upstream branch, so
  # the result stays this workspace — its remote routing, its config — with
  # only HEAD moved. (The rewind does detach HEAD; the finished rebase says
  # so and names the branch in its push hint.)
  let rebasedBase(origin: Workspace!, upstream: GitRef!, label: String!): Workspace! {
    let ontoSha = upstream.commitSHA
    let baseSha = head(origin).commonAncestor(other: upstream).commitSHA rescue {
      e: Error => raise `rebase: this branch and ${label} share no history: ${plainError(e.message)}`
    }
    let rewound = origin.withReset(commit: baseSha, hard: true)
    let newBase = if (baseSha == ontoSha) {
      rewound
    } else {
      rewound.withCommitsFrom(source: upstream.asWorkspace, maxCommits: replayBound)
    }
    let newBaseSha = head(newBase).commitSHA rescue {
      e: Error => raise replayError(
        `fast-forwarding to ${label} (${short(ontoSha)})`,
        label,
        e.message,
      )
    }
    # Fast-forwards keep hashes; anything else would mean upstream's commits
    # were copied instead of adopted, and the "rebased" branch would then
    # diverge from the branch it claims to sit on.
    if (newBaseSha != ontoSha) {
      raise `rebase: adopting ${label} produced ${short(newBaseSha)} instead of its tip ${short(ontoSha)}; refusing to rebase onto rewritten history`
    }
    newBase
  }

  # Land origin's commit `sha` on `applied` as pending edits, with conflict
  # markers where the two sides disagree.
  #
  # A three-way merge, as `git cherry-pick` does it: the commit's parent tree
  # is the base, the rebased tree is ours (expressed as a changeset from that
  # parent), and the commit's own changeset is theirs. Hunks land where the
  # code has moved to, and markers show both sides. When git cannot merge
  # (binary conflicts), fall back to a plain `git apply` that inlines the
  # rejected hunks at their original lines; when even that refuses (a file
  # the patch creates already exists), return null and leave the tree clean.
  let landConflict(origin: Workspace!, applied: Workspace!, sha: String!): Workspace {
    let commit = repository(origin).commit(id: sha)
    let parent = commit.parentShas.takeFirst.join("")
    let tree = applied.directory("/")
    let merged = if (parent == "") {
      null
    } else {
      let base = repository(origin).commit(id: parent).tree(discardGitDir: true)
      let ours = tree.changes(from: base)
      let theirs = commit.changes
      let result = ours.withChangeset(theirs, onConflict: ChangesetMergeConflict.LEAVE_CONFLICT_MARKERS).after
      applied.withChanges(result.changes(from: tree))
    }
    if (merged != null) {
      let ok = merged.git.uncommitted.isEmpty rescue {
        e: Error => null
      }
      if (ok != null) {
        return merged
      }
    }
    let patched = applied.withChanges(
      tree.withPatch(commit.changes.asPatch.contents, onConflict: PatchConflict.LEAVE_CONFLICT_MARKERS).changes(from: tree),
    )
    # Force the apply here; the failure decides which workspace to hand back.
    patched.git.uncommitted.isEmpty rescue {
      e: Error => return null
    }
    patched
  }

  # One round of the rebase: replay `remaining` (origin commits, oldest first)
  # onto `current` up to the first conflict. Everything before it is applied
  # with authorship intact; the conflicting commit lands in the working tree
  # with conflict markers and the rest is remembered for rebaseContinue. With
  # nothing left to replay, the rebase is finished.
  #
  # The plan is recomputed every round rather than once up front: whether a
  # later commit conflicts depends on how the earlier one was resolved.
  let advance(
    llm: LLM!,
    origin: Workspace!,
    current: Workspace!,
    remaining: [String!]!,
    onto: String!,
    ontoSha: String!,
    oldHead: String!,
    branch: String!,
    note: String!,
  ): LLM! {
    let plan = if (remaining.isEmpty) {
      []
    } else {
      current.compareCommitsFrom(source: origin, commits: remaining, maxCommits: replayBound).{{
        commit.{{sha, message}},
        status,
        conflictPaths
      }}
    }
    let ahead = plan.takeWhile { p => p.status != WorkspaceCommitPickStatus.CONFLICT }
    let pickable = ahead
      .filter { p => p.status == WorkspaceCommitPickStatus.PICKABLE }
      .map { p => p.commit.sha }
    let applied = if (pickable.isEmpty) {
      current
    } else {
      current.withCommitsFrom(source: origin, commits: pickable, maxCommits: replayBound)
    }
    # Force the replay HERE, with the commits involved in hand.
    let appliedHead = head(applied).commitSHA rescue {
      e: Error => raise replayError(
        `replaying ${toString(pickable.length)} commit(s) onto ${onto}`,
        onto,
        e.message,
      )
    }
    let dropped = ahead.filter { p => p.status != WorkspaceCommitPickStatus.PICKABLE }
    let progress = [note].filter { n => n != "" }
      + (if (pickable.isEmpty) { [] } else { [`Replayed ${toString(pickable.length)} commit(s): ${pickable.map { s => short(s) }.join(", ")}.`] })
      + (if (dropped.isEmpty) { [] } else { [`Dropped ${toString(dropped.length)} already upstream: ` + dropped.map { p => `${short(p.commit.sha)} ${subject(p.commit.message)}` }.join(", ") + "."] })

    let rest = plan.dropFirst(ahead.length)
    let conflict = rest[0]
    if (conflict == null) {
      return finished(llm, applied, onto, ontoSha, oldHead, branch, progress)
    }

    # Land the conflicting commit as pending edits with markers; when even
    # that is impossible the tree stays clean and the change is the agent's
    # to make by hand from `show`.
    let sha = conflict.commit.sha
    let landed = landConflict(origin, applied, sha)
    let stopped = landed ?? applied
    let how = if (landed == null) {
      `Its changes could not be merged in; the tree is clean. Recreate the change by hand (show(commit: "${short(sha)}") has the patch), then rebaseContinue.`
    } else {
      let marked = conflictedFiles(landed.git.uncommitted.asPatch.contents)
      let where = if (marked.isEmpty) { conflict.conflictPaths } else { marked }
      `Its changes are in your working tree, with conflict markers in ${where.join(", ")}: ` + "between <<<<<<< and ======= is the rebased tree's side, between ======= and >>>>>>> is the commit's. " + `Resolve them (show(commit: "${short(sha)}") shows the original change), then rebaseContinue to record the commit and carry on.`
    }

    let tools = currentNode.{{... on Dagger.Committer!}}.withRebaseState(
      origin: origin,
      remaining: rest.dropFirst.map { p => p.commit.sha },
      stopped: sha,
      stoppedHead: appliedHead,
      onto: onto,
      ontoSha: ontoSha,
      oldHead: oldHead,
      branch: branch,
    )
    print(
      (
        progress + [
          `Rebase onto ${onto} (${short(ontoSha)}) STOPPED at ${short(sha)} "${subject(conflict.commit.message)}"; ` + `${toString(rest.length - 1)} commit(s) still to replay after it.`,
          how,
          "rebaseSkip drops this commit instead; rebaseAbort restores " + `${short(oldHead)}.`,
        ]
      ).join("\n"),
    )
    llm.withTools(tools, except: plumbing).withWorkspace(stopped)
  }

  let finished(
    llm: LLM!,
    result: Workspace!,
    onto: String!,
    ontoSha: String!,
    oldHead: String!,
    branch: String!,
    progress: [String!]!,
  ): LLM! {
    let newHead = head(result).commitSHA
    let onTop = head(result).log(limit: 1000, base: repository(result).ref(name: ontoSha)).{{sha}}.length
    let summary = if (newHead == oldHead) {
      `Already up to date with ${onto} (${short(ontoSha)}); nothing to rebase.`
    } else {
      # Rewinding detached HEAD, so a bare `push` has no branch to go to:
      # spell out the call, branch included.
      let target = if (branch == "") { "<branch>" } else { branch }
      `Rebased onto ${onto} (${short(ontoSha)}): HEAD ${short(oldHead)} -> ${short(newHead)}, ` + `${toString(onTop)} commit(s) on top. ` + (if (branch == "") { "HEAD is detached; " } else { `HEAD is detached from ${branch}; ` }) + `to publish, push(branch: "${target}", expectedRemoteSHA: "<the sha the remote branch has now>") — ` + `the lease is required because the branch's history was rewritten (${short(oldHead)} if nothing was pushed since).`
    }
    let tools = currentNode.{{... on Dagger.Committer!}}.withoutRebaseState
    print((progress + [summary]).join("\n"))
    llm.withTools(tools, except: plumbing).withWorkspace(result)
  }

  # How a ref given by address is named in rebase output: its ref name when
  # it has a meaningful one, else its short commit hash.
  let refLabel(ref: GitRef!, sha: String!): String! {
    let name = ref.name rescue {
      e: Error => ""
    }
    if (name == "" or name == "HEAD" or name.containsMatch(`^[0-9a-f]{40}$`)) {
      return `ref ${short(sha)}`
    }
    name.trimPrefix("refs/heads/").trimPrefix("refs/tags/")
  }

  # The branch a workspace's HEAD is on, or "" when detached (the ref name
  # is then the commit itself).
  let branchOf(source: Workspace!): String! {
    let name = head(source).name rescue {
      e: Error => ""
    }
    if (name.hasPrefix("refs/heads/")) {
      return name.trimPrefix("refs/heads/")
    }
    if (name.containsMatch(`^[0-9a-f]{40}$`) or name == "HEAD") {
      return ""
    }
    name
  }

  # Files in a patch that still carry conflict markers. Only the opening and
  # closing markers count: a line of seven `=` is legitimate content (a
  # setext heading, a comment rule).
  let conflictedFiles(patch: String!): [String!]! {
    let files: [String!]! = []
    let current = ""
    patch.split("\n").each { line =>
      let header = line.match(`^diff --git a/.* b/(.*)$`)
      if (header != null) {
        current = header.captures[0] ?? ""
      }
      if (line.containsMatch(`^\+(<{7}|>{7})( |$)`) and !files.contains(current)) {
        files += [current]
      }
    }
    files
  }

  # Resolve full or abbreviated hashes and named refs through the engine.
  # HEAD/empty uses the tip already resolved by the caller's first read.
  let resolveSpec(source: Workspace!, spec: String!, headSha: String!): String! {
    let want = spec.trimSpace
    if (want == "" or want == "HEAD") {
      return headSha
    }
    repository(source).ref(name: want).commitSHA rescue {
      e: Error => {
        # Mid-rebase, the commits being replayed are only reachable from the
        # workspace the rebase started from: the rewind orphaned them here.
        let origin = rebaseOrigin
        if (origin != null) {
          repository(origin).ref(name: want).commitSHA rescue {
            e2: Error => raise `cannot resolve commit "${spec}": ${plainError(e.message)}`
          }
        } else {
          raise `cannot resolve commit "${spec}": ${plainError(e.message)}`
        }
      }
    }
  }

  # Why a planned cherry-pick would not apply, in the tool's own words.
  let pickConflict(reason: WorkspaceCommitPickReason): String! {
    case (reason) {
      WorkspaceCommitPickReason.DIRTY => "you have uncommitted edits on paths it touches"
      WorkspaceCommitPickReason.CONTENT => "its patch no longer applies to HEAD"
      else => "unknown reason"
    }
  }

  # The way forward for a conflicting commit, as the call to make. The ref
  # is the one already passed as `from`; its address is not recoverable here.
  let pickRecovery(reason: WorkspaceCommitPickReason, sha: String!): String! {
    case (reason) {
      WorkspaceCommitPickReason.DIRTY => "commit or revert your edits on those paths and cherryPick again (keeps the author), "
        + `or cherryPick(from: <the same ref>, commits: ["${sha}"], markers: true) to take it as your own edits`

      WorkspaceCommitPickReason.CONTENT => `cherryPick(from: <the same ref>, commits: ["${sha}"], markers: true) lands it as `
        + "uncommitted edits with conflict markers; resolve them and commit it yourself"

      else => `inspect it with show(commit: "${sha}", from: <the same ref>)`
    }
  }

  let pickLabel(
    status: WorkspaceCommitPickStatus,
    reason: WorkspaceCommitPickReason,
  ): String! {
    case (status) {
      WorkspaceCommitPickStatus.PICKABLE => "new"
      WorkspaceCommitPickStatus.PICKED => "already had"
      WorkspaceCommitPickStatus.REDUNDANT => "redundant"
      WorkspaceCommitPickStatus.CONFLICT => "CONFLICT: " + pickConflict(reason)
      else => "?"
    }
  }

  # cherryPick(markers: true): land one commit of `from` on the working tree
  # as uncommitted edits — `git cherry-pick -n` — with conflict markers
  # where it no longer fits. Deliberately never a commit: a commit must not
  # be recorded with markers inside it, so the resolution is the agent's own.
  let pickWithMarkers(source: Workspace!, from: GitRef!, spec: String!): Workspace! {
    if (spec.trimSpace == "") {
      raise "cherryPick: name the commit to apply with markers, e.g. commits: [\"<sha>\"]"
    }
    let sha = resolveSpecIn(from, spec)
    let theirs = from.asWorkspace
    let target = from.asRepository.commit(id: sha).{{message, authorName, parentShas}}
    if (target.parentShas.length > 1) {
      raise `cherryPick: ${short(sha)} is a merge commit; inspect its first-parent diff with show(commit: "${short(sha)}", from:) and integrate it by hand`
    }
    if (target.parentShas.isEmpty) {
      raise `cherryPick: ${short(sha)} is a root commit with no parent to merge from; restore(from:) its files instead`
    }
    let planned = source.compareCommitsFrom(source: theirs, commits: [sha], maxCommits: replayBound).{{status}} rescue {
      e: Error => raise `cherryPick: planning against the ref failed: ${plainError(e.message)}`
    }
    if (planned.isEmpty or planned.any { p => p.status == WorkspaceCommitPickStatus.PICKED }) {
      print(`HEAD already has ${short(sha)}; nothing to apply.`)
      return source
    }
    # Advisory, not a refusal: a commit that applies cleanly is better taken
    # by a plain cherryPick, which keeps its authorship.
    let clean = planned.any { p => p.status == WorkspaceCommitPickStatus.PICKABLE }
    # The same three-way landing a stopped rebase uses: hunks land where the
    # code has moved to, with markers showing both sides.
    let landed = landConflict(theirs, source, sha)
    if (landed == null) {
      raise `cherryPick: commit ${short(sha)} could not be applied to your tree, not even with conflict markers `
        + "(git refuses to create a file your tree already has — if that is your own uncommitted work, commit or revert it and "
        + `cherryPick(from: <the same ref>, commits: ["${short(sha)}"]) instead; otherwise recreate it from show(commit: "${short(sha)}", from:))`
    }
    let marked = conflictedFiles(landed.git.uncommitted.asPatch.contents)
    let todo = if (marked.isEmpty) {
      "It applied without conflicts: review it with diff, then commit it yourself."
    } else {
      `Conflict markers in ${marked.join(", ")}: between <<<<<<< and ======= is your side, `
        + "between ======= and >>>>>>> is the commit's. Resolve them, then commit it yourself."
    }
    let note = if (clean) {
      "\n\n" + `NOTE: this commit applies cleanly — cherryPick(from: <the same ref>, commits: ["${short(sha)}"]) without markers `
        + `would commit it with ${target.authorName}'s authorship intact. Prefer that unless you meant to make it yours.`
    } else {
      ""
    }
    print(`Applied ${short(sha)} "${subject(target.message)}" as UNCOMMITTED edits; HEAD unchanged. ` + todo + "\n\n"
      + "Original message, to reuse:" + "\n"
      + indent(target.message.trimSpace) + note)
    landed
  }

  # Resolve a spec inside a ref given by address: HEAD (or empty) is the ref's
  # own commit; anything else is looked up in the ref's repository.
  let resolveSpecIn(from: GitRef!, spec: String!): String! {
    let want = spec.trimSpace
    if (want == "" or want == "HEAD") {
      return from.commitSHA
    }
    from.asRepository.ref(name: want).commitSHA rescue {
      e: Error => raise `cannot resolve commit "${spec}" in the given ref: ${plainError(e.message)}`
    }
  }

  # The repository holding `sha`: the workspace's own, or — mid-rebase — the
  # origin workspace's, for the commits the rewind orphaned.
  let repositoryHolding(source: Workspace!, sha: String!): GitRepository! {
    let origin = rebaseOrigin
    if (origin == null) {
      return repository(source)
    }
    repository(source).commit(id: sha).sha rescue {
      e: Error => return repository(origin)
    }
    repository(source)
  }

  let statBlock(
    changes: Changeset!,
    paths: [String!]!,
    max: Int!,
  ): String! {
    let stats = changes.diffStats.{{path, kind, addedLines, removedLines}}
    if (stats.isEmpty) {
      return "(no file changes)"
    }
    let added = stats.reduce(0) { acc, s => acc + (s.addedLines ?? 0) }
    let removed = stats.reduce(0) { acc, s => acc + (s.removedLines ?? 0) }
    let totals = `${toString(stats.length)} file(s) changed, +${toString(added)} -${toString(removed)}`
    let scoped = changes.filter(include: paths).diffStats.{{path, kind, addedLines, removedLines}}
    if (scoped.isEmpty) {
      return totals + "\n" + "  (none under the given paths)"
    }
    let rows = scoped.takeFirst(max).map { s =>
      `  ${renderKind(s.kind)}  +${toString(s.addedLines)}  -${toString(s.removedLines)}  ${s.path}`
    }
    # A comparison across a release can touch five figures of files: never let
    # the file list alone flood the caller's context.
    let omitted = scoped.length - rows.length
    let note = if (omitted > 0) {
      "\n" + `  ... ${toString(omitted)} more file(s) not listed; scope with paths to see them`
    } else {
      ""
    }
    let scopeNote = if (paths.isEmpty) { "" } else { ` (${toString(scoped.length)} under the given paths)` }
    totals + scopeNote + "\n" + rows.join("\n") + note
  }

  # Clamp an already-scoped patch to `max` lines.
  let patchBlock(patch: String, paths: [String!]!, max: Int!): String! {
    let text = patch ?? ""
    if (text.trimSpace == "") {
      if (!paths.isEmpty) {
        return "(no changes under the given paths)"
      }
      return "(this commit records no file changes)"
    }
    clampLines(text, max, "(patch truncated — scope it with paths, or read the file with fileAt)")
  }

  let clampLines(text: String!, max: Int!, note: String!): String! {
    let lines = text.split("\n")
    if (lines.length <= max) {
      return text
    }
    lines.takeFirst(max).join("\n") + "\n\n" + `... ${toString(lines.length - max)} of ${toString(lines.length)} lines not shown. ` + note
  }

  let banner(source: Workspace!): String! {
    let branch = branchOf(source)
    let sha = short(head(source).commitSHA)
    let where = if (branch == "") { `HEAD detached at ${sha}` } else { `On ${branch}, HEAD ${sha}` }
    rebaseBanner + where + "."
  }

  # A line for status and log while a rebase is stopped, so its state is
  # visible without re-reading the rebase tool's own output. Empty otherwise.
  let rebaseBanner: String! {
    if (rebaseOrigin == null) {
      return ""
    }
    `REBASE onto ${rebaseOnto} in progress, stopped at ${short(rebaseStopped)}: resolve the conflict markers, then rebaseContinue (or rebaseSkip / rebaseAbort).` + "\n\n"
  }

  let emptyLog(paths: [String!]!, grep: String): String! {
    if (grep != null) {
      return `No commit message in the last ${toString(searchWindow)} commits matches "${grep ?? ""}"` + (if (paths.isEmpty) { "." } else { " under the given paths." })
    }
    if (paths.isEmpty) {
      return "No commit history in this workspace."
    }
    "No commits have touched the given paths."
  }

  let indent(text: String!): String! {
    text.split("\n").map { line => "    " + line }.join("\n")
  }

  # Validate before touching the workspace. Count Unicode characters, not
  # bytes; never silently truncate a subject or invent a rationale.
  let formatMessage(message: String!): String! {
    let lines = message.replace("\r\n", "\n").split("\n")
    let title = lines.takeFirst.join("")
    if (!title.containsMatch(`^[A-Za-z0-9][A-Za-z0-9_./-]*: \S.*$`) or title != title.trimSpace) {
      raise "commit: use a scoped subject such as 'committer: enforce commit style'"
    }
    if (title.split("").length > 50) {
      raise `commit: subject is ${toString(title.split("").length)} characters; maximum is 50 including scope`
    }
    if (lines.length < 3 or lines[1] != "") {
      raise "commit: follow the subject with a blank line and a brief description"
    }
    let body = lines.dropFirst(2).join("\n")
    if (body.trimSpace == "") {
      raise "commit: add a brief description; explain why when interesting and non-obvious"
    }
    title + "\n\n" + wrapDescription(body)
  }

  # Conservative rather than a Markdown reflow: keep existing line breaks
  # and all indented lines verbatim (including tabs). Fences may contain
  # unindented code. Trailer-like lines must not be split: Git parses them.
  let wrapDescription(body: String!): String! {
    let fence = ""
    body.split("\n").map { line =>
      let trimmed = line.trimLeft(" \t")
      if (fence != "") {
        let closing = trimmed.trimRight(" \t")
        if (closing.hasPrefix(fence) and closing.trim(
          fence.split("").takeFirst.join(""),
        ) == "") {
          fence = ""
        }
        continue line
      }
      let opening = trimmed.match("^(`{3,}|~{3,})")
      if (opening != null) {
        fence = opening.string
        continue line
      }
      if (line == "" or line.hasPrefix(" ") or line.hasPrefix("\t") or line.containsMatch(`^[A-Za-z0-9-]+: `)) {
        continue line
      }
      let marker = line.match(`^(?:[-+*]|[0-9]+[.)]) +`)
      let prefix = if (marker == null) { "" } else { marker.string }
      wrapLine(line.trimPrefix(prefix), prefix)
    }.join("\n")
  }

  let wrapLine(text: String!, prefix: String!): String! {
    if ((prefix + text).split("").length <= 80) {
      return prefix + text
    }
    let result: [String!]! = []
    let line = prefix
    let hasWord = false
    let continuation = "".padRight(prefix.split("").length)
    text.splitMatches(`\s+`).filter { word => word != "" }.each { word =>
      let candidate = line + (if (hasWord) { " " } else { "" }) + word
      if (hasWord and candidate.split("").length > 80) {
        result += [line]
        line = continuation + word
      } else {
        line = candidate
      }
      hasWord = true
    }
    (result + [line]).join("\n")
  }

  let subject(message: String!): String! {
    message.split("\n", 2).takeFirst.join("")
  }

  let short(sha: String!): String! {
    sha.split("", 8).takeFirst(7).join("")
  }

  # RFC3339 in, "2026-08-14 03:15" out: the seconds and the zone are noise in
  # a listing, but the time of day tells you what happened in this session.
  let when(date: String!): String! {
    let parts = date.split("T")
    let day = parts.takeFirst.join("")
    let clock = parts.dropFirst.join("").split("", 6).takeFirst(5).join("")
    if (clock == "") { day } else { day + " " + clock }
  }

  # Nullable: `show`'s stats reach here through a projection of the nullable
  # `changes` field, whose record fields inherit its nullability.
  let renderKind(kind: DiffStatKind): String! {
    case (kind) {
      DiffStatKind.ADDED => "A"
      DiffStatKind.MODIFIED => "M"
      DiffStatKind.REMOVED => "D"
      DiffStatKind.RENAMED => "R"
      else => "?"
    }
  }

  let systemPrompt: String! = """
    You have git tools for this workspace, covering your pending changes, the
    checkout's history, and committing:

    - `status` — a compact per-file overview of your pending changes (change
      kind + added/removed line counts). Start here to see what you've
      touched.
    - `diff` — those same changes as a full Git-style unified patch, when you
      need to read the actual hunks. Scope it with `paths`; an unscoped patch
      can be huge.
    - `restore` — replace selected working-tree files from `ref`
      (default HEAD) without moving HEAD. Required `paths` are globs like
      status/commit; selection covers both trees, so deleted files return and
      additions absent from the source are removed. Other files stay untouched.
      Use `preview: true` to review the proposed patch without applying it.
      Only restore when discarding those edits is intended; there is no index.
    - `commit` — record pending changes as a commit and advance HEAD. Without
      `paths` it commits EVERYTHING `status` lists; with `paths`, only those
      changes, leaving the rest pending.
    - `reset` — move HEAD to a chosen commit, or restore a saved workspace.
      Only use when asked to undo or rewrite commits.
      Read `log`, choose the target, then reset, review `status` / `diff`, and
      commit again. Each reset saves the workspace you leave and prints its
      hash. Resetting to a saved hash restores that workspace's files and
      pending edits; other targets keep your current working tree. Pass
      `hard: true` to replace the working tree with the target commit's tree
      instead, discarding pending edits even for saved targets. The workspace
      being left is still saved for recovery.
      Rewriting published history needs explicit authorization, not an
      automatic force push after a rejection.
    - `rebase` — replay this branch's commits onto another ref, keeping
      authors and dates: `ref:` takes the target by address (see below),
      e.g. "https://github.com/org/repo#main". It stops at the first commit
      that conflicts: the earlier ones are already on the new base, and the
      conflicting one is merged three-way into your working tree with
      <<<<<<< markers. Resolve them with your edit tools —
      do not give up on the commit — then `rebaseContinue` records it
      (original message and author kept; pass `message` to amend) and
      replays the rest, stopping again if needed. `rebaseSkip` drops the
      stopped commit, `rebaseAbort` restores the pre-rebase workspace. Needs
      a clean tree; it does not push, and leaves HEAD detached — the finished
      rebase prints the `push(branch:, expectedRemoteSHA:)` call to publish.
      For a branch stacked on a parent that was rewritten and merged, pass
      `from:` the old parent head to replay only the commits after it
      (`git rebase --onto <ref> <from>`).
    - `cherryPickPlan` — plan taking another ref's commits (`from:`, by
      address) into HEAD. Lists commits in source not in HEAD, oldest first,
      annotated new, already had, redundant, or CONFLICT with reasons and
      recovery hints. `limit` selects the newest N, displayed oldest first.
    - `cherryPick` — take commits from another ref (`from:`, by address)
      onto HEAD with their authorship intact; without `commits` it takes
      every commit HEAD lacks. Conflicting commits are reported, not forced;
      `markers: true` with one commit applies it as uncommitted edits with
      conflict markers instead (see HARVESTING below).
    - `push` — publish committed history to the checkout's remote. Pending
      changes are not pushed: commit first. A rejected push (the remote
      moved) is an error; `expectedRemoteSHA` is the force-with-lease escape
      hatch, for when overwriting the remote is genuinely intended.
    - `log` — commits newest first. Pass `paths` to see who last touched a
      file and why, `grep` to search commit messages, and `full: true` to
      print full message bodies. With `base:`, lists commits reachable from
      our HEAD but not that ref, still newest first; filters and limits apply
      within that selected history. This is history, not a cherry-pick plan.
    - `show` — one commit in full: metadata, message, per-file stats and the
      patch. Takes "HEAD", a short hash from `log`, or a tag; `against` turns
      it into a comparison between two commits.
    - `fileAt` — a file's contents as of a commit, for recovering something
      you deleted or seeing what a file looked like before a change.

    REFS BY ADDRESS: `log(base:)`, `rebase(ref:)`, `cherryPickPlan(from:)`,
    `cherryPick(from:)`, and the `from:` argument of `show`, `fileAt` and
    `restore` take a git ref as an address string — any GitRef address,
    including other agents' histories (FindArtifacts lists them), a workspace
    a `reset` left behind
    (`dag://committer/saved/head?saved-workspace=<sha>`; `reset` prints the
    address, and `saved` lists them), or a git URL with a fragment such as
    "https://github.com/org/repo#main". This is how to read, take, or rebase
    onto commits that exist only in another agent's workspace, or reach
    commits a reset orphaned, without pushing anything.

    HARVESTING commits from another ref:

    1. `cherryPickPlan(from:)` lists the commits HEAD lacks, oldest first,
       each marked new, already had, redundant, or CONFLICT with the reason;
       `show(commit:, from:)` reads one.
    2. `cherryPick(from:)` takes everything that applies cleanly, keeping
       authorship, and reports the rest. Run `cherryPickPlan(from:)` again
       after each round to see what is left.
    3. Per CONFLICT: if your own uncommitted edits are in the way, commit or
       revert them and cherryPick again (the author is kept). Otherwise
       `cherryPick(from:, commits: [<sha>], markers: true)` lands that commit
       as uncommitted edits with conflict markers: resolve them, then
       `commit` it yourself, reusing the printed message.
    4. To put your own commits on top of that history instead of taking it
       into yours, `rebase(ref:)` onto it.

    A history read by address reflects its owner's last completed step:
    work still in flight there is not visible yet.

    The A/M/D/R marks in `status` describe each path relative to the last
    commit, not `git status`'s index model — there is no staging area here,
    so a file git would call untracked is just `A`, and `commit` without
    `paths` includes those, unlike `git commit -a`.

    Committing well: review with `status` / `diff` first; read `log` for scope
    names and wording. Keep each commit focused on one logical change, scoping
    with `paths` when only part of your pending work belongs together.

    Commit style is enforced: use `scope: summary` (e.g. `committer: wrap
    descriptions`), at most 50 characters TOTAL including the scope. Choose
    a meaningful component/area scope. Follow it with a blank line and a brief
    description of the change. Explain why when the motivation or tradeoff is
    interesting and non-obvious; don't restate the subject, invent reasons,
    or add boilerplate just to say "why". The tool wraps prose at 80 characters,
    keeping existing line breaks, indented/fenced code and trailers intact;
    long tokens remain unbroken and lists get hanging indentation.

    Only commit when asked to, or when the task clearly calls for it — and
    only push when asked: a push leaves the workspace and publishes to the
    remote. The reading tools re-read the current state on every call, so
    re-run them after making edits.
  """
}

"""
The workspaces `reset` left behind, as a collection keyed by the HEAD hash
each was at when it was saved. Selected by address as
`dag://committer/saved?saved-workspace=<sha>`.
"""
type Saved @collection {
  # The tool object holding the saved workspaces; private so Committer itself
  # stays out of the collection's schema.
  let committer: Dagger.Committer!

  """
  Full HEAD hashes of the saved workspaces, sorted.
  """
  shas: [String!]! @keys

  new(committer: Dagger.Committer!, shas: [String!]!) {
    self.committer = committer
    self.shas = shas
    self
  }

  """
  The workspace saved at this HEAD hash.
  """
  at(sha: String!): SavedWorkspace! @get {
    SavedWorkspace(sha, committer.savedWorkspace(sha))
  }
}

"""
A workspace as `reset` left it: its HEAD, and the pending edits it had.
"""
type SavedWorkspace {
  """
  The full HEAD hash the workspace was saved under.
  """
  sha: String!

  # Private: a Workspace cannot be stored as a public field on a module object.
  let saved: Workspace!

  new(sha: String!, saved: Workspace!) {
    self.sha = sha
    self.saved = saved
    self
  }

  """
  The saved workspace, pending edits included; what `reset` to its hash
  restores.
  """
  workspace: Workspace! {
    saved
  }

  """
  The saved HEAD as a GitRef — the artifact at
  `dag://committer/saved/head?saved-workspace=<sha>`. Its history stays
  reachable here after the reset that orphaned it.
  """
  head: GitRef! {
    saved.git.head
  }
}
