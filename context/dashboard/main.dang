# context-dashboard: the Contexts you published as gists, as cards on one
# page — for a single user, on their own machine.
#
# The hosted viewer reads one gist whose id you already know. This lists
# every gist of yours with a context.json — secret ones included, which only
# your token can list — and shows each as a card: its title, the Blocks it
# leads with, and its open questions, linking to the hosted viewer.
#
# The token stays in the server (server.cjs); the page only receives the
# distilled cards. Run it with the token gh already holds:
#
#   dagger -m ./context/dashboard call --token=cmd://"gh auth token" \
#     serve up --ports=8080:8080
#
# then open the http://localhost:8080/?key=... link it prints. `up` forwards
# the port on every interface, so the cards also need that key (traded for a
# cookie on first visit), fresh on every start unless you pass serve(key:).
# Cards stream in as each page of gists is listed and summarized, and take
# their place newest first. Listing costs one API request per 100 gists, and
# 304s on the next refresh; each context.json is fetched once per revision
# from its raw URL.

"""
A single-user dashboard of the Contexts you published as GitHub gists.
"""
type ContextDashboard {
  let token: Secret!
  let api: String!

  new(
    """
    A GitHub token that can list your gists, e.g. cmd://"gh auth token".
    Only the server uses it; the page never sees it.
    """
    token: Secret!,
    """
    The GitHub API to list gists from.
    """
    api: String! = "https://api.github.com",
  ) {
    self.token = token
    self.api = api
    self
  }

  """
  The dashboard on port 8080. Open it with the http://localhost:8080/?key=...
  link it prints on start. Other host names are refused, so no other site can
  read it through DNS rebinding, and the cards need the key, since the port
  is forwarded on every interface.
  """
  serve(
    """
    The Context viewer's stylesheet, shared so cards look like the viewer.
    """
    stylesheet: File! @defaultPath(path: "../context.css"),
    """
    A fixed key to open the dashboard with (http://localhost:8080/?key=...),
    so a link survives restarts; percent-encode it in the link unless it is
    URL-safe. Random on every start by default.
    """
    key: Secret = null,
  ): Service! {
    let ctr = container.from("node:22-alpine")
      .withDirectory("/app", currentModule.source, include: ["server.cjs", "index.html", "dashboard.js", "dashboard.css"])
      .withFile("/app/context.css", stylesheet)
      .withEnvVariable("GITHUB_API", api)
      .withSecretVariable("GITHUB_TOKEN", token)
      .withExposedPort(8080)
    if (key != null) {
      ctr = ctr.withSecretVariable("DASHBOARD_KEY", key)
    }
    ctr.asService(args: ["node", "/app/server.cjs"])
  }
}
