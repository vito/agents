# Repository development checks exercise the installable agents through their
# public APIs. No test entry points or test-only tool exclusions live in agents.
type AgentsDev {
  """Check commit-message validation and conservative description wrapping."""
  committerMessages(source: Workspace!): Void @check {
    print(checkCommitterMessages(source))
    null
  }

  """Check rebase onto a remote ref and conflict-marker validation through the API."""
  committerRebaseHelpers: Void @check {
    print(checkCommitterRebaseHelpers)
    null
  }

  """Check rebase planning, replay, conflicts, and resolution on private fixtures."""
  committerRebaseReplay: Void @check {
    print(checkCommitterRebaseReplay)
    null
  }

  """Check rebase replays only the commits after `from`, and rejects a `from` off the branch."""
  committerRebaseFrom: Void @check {
    print(checkCommitterRebaseFrom)
    null
  }

  """Check cherryPickPlan, cherryPick (markers too), rebase, show, fileAt and restore against refs given by value, and the saved-workspace collection."""
  committerRefs: Void @check {
    print(checkCommitterRefs)
    null
  }

  """Check log(base:) history direction, filtering and limits against cherryPickPlan."""
  committerLog: Void @check {
    print(checkCommitterLog)
    null
  }

  """Check treeEqual: identical trees, mode-only and content differences, refs by address."""
  committerTreeEqual: Void @check {
    print(checkCommitterTreeEqual)
    null
  }

  """Check glob filtering and commits on a private frozen workspace."""
  committerFiltering(source: Workspace!): Void @check {
    print(checkCommitterFiltering(source))
    null
  }

  """Check selective restoration, large files, and validation on private fixtures."""
  committerRestore(source: Workspace!): Void @check {
    print(checkCommitterRestore(source))
    null
  }

  """Check promotion preserves special-character metadata and the Markdown payload."""
  contextPromotionMetadata(source: Workspace!): Void @check {
    print(testContextPromotionMetadata(source: source))
    null
  }

  """Check promotion emits empty lists, false pin, and null active status explicitly."""
  contextPromotionDefaults(source: Workspace!): Void @check {
    print(testContextPromotionDefaults(source: source))
    null
  }

  """Check promote refreshes already-promoted files of the blocks it supersedes, so committed context/ imports consistently."""
  contextPromoteSupersedes(source: Workspace!): Void @check {
    print(testContextPromoteSupersedes(source: source))
    null
  }

  """Check regression methods are not exposed as context agent tools."""
  contextTools: Void @check {
    print(testContextTools)
    null
  }

  """Check exportJson, exportMarkdown (nested and flat), exportGist and the workspace path all round-trip through importBlocks."""
  contextExportRoundTrip(source: Workspace!): Void @check {
    print(testContextExportRoundTrip(source: source))
    null
  }

  """Check importBlocks' onConflict modes, imported supersession of session blocks, context.json beside markdown, and that invalid files import nothing."""
  contextImportConflicts(source: Workspace!): Void @check {
    print(testContextImportConflicts(source: source))
    null
  }

  """Check exportHtml's rendering, escaping and links, and what promoteAll lands."""
  contextHtml(source: Workspace!): Void @check {
    print(testContextHtml(source: source))
    null
  }

  """Check exportHtml's curated sections: lead order, open questions (blockers, then pinned), anchorless featured copies, and lead validation."""
  contextHtmlCurated(source: Workspace!): Void @check {
    print(testContextHtmlCurated(source: source))
    null
  }

  """Check questions' Q-numbers: assignment, stability, resolution as ids, export/import and renumbering on clashes, and the HTML labels and links."""
  contextShortIds(source: Workspace!): Void @check {
    print(testContextShortIds(source: source))
    null
  }

  """Check mounts stay out of the GitHub toolbox snapshot."""
  contributorMountsOutsideToolbox: Void @check {
    print(checkContributorMountsOutsideToolbox)
    null
  }

  """Check checkout and mount refs given by value, HEAD state, and kept edits on a local Git fixture."""
  contributorCheckoutRefs: Void @check {
    print(checkContributorCheckoutRefs)
    null
  }

  """Check `gh stack` runs through the gh tool, merge and PR URLs from several repositories are refused, and a failed gh-stack skill install leaves the tools composed."""
  contributorStack: Void @check {
    print(checkContributorStack)
    null
  }

  """Check the read-only contributor role: exactly the read tools, sticky through recomposition and reload, gh write verbs refused, no agent adoption on checkout."""
  contributorReadonly(source: Workspace!): Void @check {
    print(testContributorReadonly(source: source))
    null
  }

  """Check the read-only committer role: no push, kept through reset's own rebind, recomposition and reload."""
  committerReadonly(source: Workspace!): Void @check {
    print(testCommitterReadonly(source: source))
    null
  }

  """Check the escape hatches' glob filtering and literal internal drift paths without model calls."""
  staffFiltering(source: Workspace!): Void @check {
    print(testStaffFiltering(source: source))
    null
  }

  """Check the roster collection: keys, items, subsets, and one unambiguous `member` dimension."""
  staffMembers(source: Workspace!): Void @check {
    print(testStaffMembers(source: source))
    null
  }

  """Check a worker's live roster sees later hires, resolves addresses, and reaches the escape hatches, all derived from `me`."""
  staffPeers(source: Workspace!): Void @check {
    print(testStaffPeers(source: source))
    null
  }

  """Check the chief's tools: orchestration and escape hatches, no git or bookkeeping."""
  staffTools(source: Workspace!): Void @check {
    print(testStaffTools(source: source))
    null
  }

  """Check the worker role: worker tools without chief tools, its name and parent, reload, and explicit promotion."""
  staffWorker(source: Workspace!): Void @check {
    print(testStaffWorker(source: source))
    null
  }

  """Check workers inherit the chief's recorded composition, including later installs, without model calls."""
  staffComposition(source: Workspace!): Void @check {
    print(testStaffComposition(source: source))
    null
  }

  """Check a worker's checkout of a repository installing staff keeps it a worker, takes the target's versions of recorded modules, and composes the target's new agents."""
  staffCheckout(source: Workspace!): Void @check {
    print(testStaffCheckout(source: source))
    null
  }

  """Check the worker role is found through the chief's own staff entry after the chief checks out a repository without staff, and survives reload there."""
  staffRoleWithoutStaff(source: Workspace!): Void @check {
    print(testStaffRoleWithoutStaff(source: source))
    null
  }

  """Check the reviewer's report on canned replies: evidence checks, the editor's merges, drops and decisions, fixes, pre-existing findings, and what was dropped and why."""
  reviewerReport: Void @check {
    print(checkReviewerReport)
    null
  }

  """Check reviewer sub-agents inherit the caller's composition minus staff and reviewer, with read-only contributor and committer, plus the role."""
  reviewerComposition(source: Workspace!): Void @check {
    print(checkReviewerComposition(source))
    null
  }

  """Check the reviewer's tools: only review; roles and plumbing stay out."""
  reviewerTools(source: Workspace!): Void @check {
    print(checkReviewerTools(source))
    null
  }

  """Check the reviewer eval's scorecard arithmetic on canned judge replies, and validate every eval case, without model calls."""
  reviewerEvalScoring(source: Workspace!): Void @check {
    print(checkReviewerEvalScoring(source))
    null
  }

  # The reviewer eval (reviewer-eval.dang) calls models, so it is not a
  # check: these are plain functions, run on demand when reviewer's prompts,
  # tools or model change. The required case name also keeps them out of
  # workspace artifact enumeration.

  """
  Run reviewer on an eval case (agents-dev/evals/<case>/case.json) and score
  what it reports: each finding's value (guardrail, guidance, quick-fix,
  speed-bump, false), alarmism, a value score, noise, length, and recall on
  confirmed and vetted-real issues. Returns the scorecard as a table and
  JSON, then the review. Calls models: the review's sub-agents, then the
  judge. E.g. `dagger call agents-dev reviewer-eval --case-name dang-187`.
  """
  reviewerEval(
    source: Workspace!,
    """
    The case: a directory name under agents-dev/evals.
    """
    caseName: String!,
    """
    How many finders the review runs (1-6).
    """
    finders: Int! = 4,
    """
    Judge samples per finding (1-9); each of a finding's match, value and
    alarmism takes the answer a strict majority gives. Odd numbers avoid ties.
    """
    samples: Int! = 3,
    """
    The judge's model; empty for the engine's default.
    """
    judgeModel: String! = "",
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    runReviewerEval(source, caseName, finders, samples, judgeModel)
  }

  """
  Score any review's text (reviewer's, a baseline's, another tool's) against
  an eval case, as reviewerEval does. Returns the scorecard as a table and JSON.
  Calls the judge model. E.g. `dagger call agents-dev reviewer-eval-score
  --case-name dang-187 --review agents-dev/evals/dang-187/baseline-reviewer-v1.md`.
  """
  reviewerEvalScore(
    source: Workspace!,
    """
    The case: a directory name under agents-dev/evals.
    """
    caseName: String!,
    """
    The review to score, as text.
    """
    review: File!,
    """
    Judge samples per finding (1-9); each of a finding's match, value and
    alarmism takes the answer a strict majority gives. Odd numbers avoid ties.
    """
    samples: Int! = 3,
    """
    The judge's model; empty for the engine's default.
    """
    judgeModel: String! = "",
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    let scored = scoreReviewerEvalText(source, caseName, review.contents, review.name, samples, judgeModel, reviewerEvalNoMeta)
    scored.text + "\n\n--- scorecard.json ---\n" + scored.json
  }

  """Check sandbox sessions: exec, change extraction, continued and fresh sessions."""
  sandboxSessions(source: Workspace!): Void @check {
    print(testSandboxSessions(source: source))
    null
  }

  """Check the sandbox tools, with sandbox definitions reached by address instead."""
  sandboxTools: Void @check {
    print(testSandboxTools)
    null
  }

  """Check sandbox definitions of sibling modules are workspace artifacts exec can run in."""
  sandboxSiblings(source: Workspace!): Void @check {
    print(testSandboxSiblings(source: source))
    null
  }

  """Check sandbox git: .git stays out of changes, and commits come back as history."""
  sandboxGit(source: Workspace!): Void @check {
    print(testSandboxGit(source: source))
    null
  }

  # Browser checks are parked in browser-tests/checks.dang until CI's engine
  # supports their APIs. Keep the browser dependency unwired too: even loading
  # its schema requires the newer engine.
}
