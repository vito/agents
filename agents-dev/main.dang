# Repository development checks exercise the installable agents through their
# public APIs. No test entry points or test-only tool exclusions live in agents.
type AgentsDev {
  """Check commit-message validation and conservative description wrapping."""
  committerMessages(source: Workspace!): Void @check {
    print(checkCommitterMessages(source))
    null
  }

  """Check rebase origin selection and conflict-marker validation through the API."""
  committerRebaseHelpers: Void @check {
    print(checkCommitterRebaseHelpers)
    null
  }

  """Check rebase planning, replay, conflicts, and resolution on private fixtures."""
  committerRebaseReplay: Void @check {
    print(checkCommitterRebaseReplay)
    null
  }

  """Check rebase replays only the commits after `from`, and rejects a `from` off the branch."""
  committerRebaseFrom: Void @check {
    print(checkCommitterRebaseFrom)
    null
  }

  """Check log(from:), cherryPick (markers too), rebase, show, fileAt and restore against refs given by value, and the saved-workspace collection."""
  committerRefs: Void @check {
    print(checkCommitterRefs)
    null
  }

  """Check glob filtering and commits on a private frozen workspace."""
  committerFiltering(source: Workspace!): Void @check {
    print(checkCommitterFiltering(source))
    null
  }

  """Check selective restoration, previews, and validation on private fixtures."""
  committerRestore(source: Workspace!): Void @check {
    print(checkCommitterRestore(source))
    null
  }

  """Check promotion preserves special-character metadata and the Markdown payload."""
  contextPromotionMetadata(source: Workspace!): Void @check {
    print(testContextPromotionMetadata(source: source))
    null
  }

  """Check promotion emits empty lists, false pin, and null active status explicitly."""
  contextPromotionDefaults(source: Workspace!): Void @check {
    print(testContextPromotionDefaults(source: source))
    null
  }

  """Check regression methods are not exposed as context agent tools."""
  contextTools: Void @check {
    print(testContextTools)
    null
  }

  """Check mounts stay out of the GitHub toolbox snapshot."""
  contributorMountsOutsideToolbox: Void @check {
    print(checkContributorMountsOutsideToolbox)
    null
  }

  """Check checkout selection, HEAD state, and kept edits on a local Git fixture."""
  contributorCheckoutRefs: Void @check {
    print(checkContributorCheckoutRefs)
    null
  }

  """Check the escape hatches' glob filtering and literal internal drift paths without model calls."""
  staffFiltering(source: Workspace!): Void @check {
    print(testStaffFiltering(source: source))
    null
  }

  """Check the roster collection: keys, items, subsets, and one unambiguous `member` dimension."""
  staffMembers(source: Workspace!): Void @check {
    print(testStaffMembers(source: source))
    null
  }

  """Check a worker's live roster sees later hires, resolves addresses, and reaches the escape hatches."""
  staffPeers(source: Workspace!): Void @check {
    print(testStaffPeers(source: source))
    null
  }

  """Check the chief's tools: orchestration and escape hatches, no git or bookkeeping."""
  staffTools(source: Workspace!): Void @check {
    print(testStaffTools(source: source))
    null
  }

  """Check retained-origin composition after checkout, without model calls."""
  staffComposition: Void @check {
    print(testStaffComposition)
    null
  }

  # Browser checks are parked in browser-tests/checks.dang until CI's engine
  # supports their APIs. Keep the browser dependency unwired too: even loading
  # its schema requires the newer engine.
}
