let testContextPromotionMetadata(source: Workspace!): String! {
  let tags = [
    "comma,inside", "colon: inside", "double\"quote", "single'quote",
    "line\nbreak", "true", "null", "123", "[brackets]", "# comment",
    "back\\slash", "---\nstatus: forged",
  ]
  let text = "# Payload\n\n---\n\n```yaml\nstatus: unchanged\n```\n  indented\n\n"
  let fixture = context
    .blockWrite("facts/old", ContextBlockKind.FACT, "old")
    .blockWrite("facts/current", ContextBlockKind.DECISION, text, tags: tags,
      pin: true, supersedes: ["facts/old"])
  [fixture, fixture.blockWrite("facts/new", ContextBlockKind.FACT, "new",
    supersedes: ["facts/current"])].each { state, i =>
    let changes = state.promote(source, "facts/current")
    let contents = source.directory("/").withChanges(changes)
      .file("context/facts/current.md").contents
    assert { contents.hasPrefix("---\n") }
    let parts = contents.trimPrefix("---\n").split("\n---\n\n", limit: 2)
    assert { parts.length == 2 }
    let front = parts[0] ?? ""
    let metadata: {{id: String!, kind: String!, tags: [String!]!, pin: Boolean!, supersedes: [String!]!, superseded_by: [String!]!, status: String}}! = YAML.decode(front)
    assert { metadata.id == "facts/current" }
    assert { metadata.kind == "decision" }
    assert { metadata.tags == tags }
    assert { metadata.pin }
    assert { metadata.supersedes == ["facts/old"] }
    let expectedStatus = if (i == 0) { null } else { "superseded" }
    assert { metadata.status == expectedStatus }
    let expectedBy = if (i == 0) { [] :: [String!]! } else { ["facts/new"] }
    assert { metadata.superseded_by == expectedBy }
    assert { parts[1] == text + "\n" }
    let roundtrip: {{id: String!, kind: String!, tags: [String!]!, pin: Boolean!, supersedes: [String!]!, superseded_by: [String!]!, status: String}}! = YAML.decode(YAML.encode(metadata))
    assert { roundtrip == metadata }
  }
  "Promotion metadata and payload checks passed."
}

let testContextPromotionDefaults(source: Workspace!): String! {
  let fixture = context.blockWrite("notes/defaults", ContextBlockKind.NOTE, "plain payload")
  let changes = fixture.promote(source, "notes/defaults")
  let contents = source.directory("/").withChanges(changes)
    .file("context/notes/defaults.md").contents
  let parts = contents.trimPrefix("---\n").split("\n---\n\n", limit: 2)
  assert { contents.hasPrefix("---\n") and parts.length == 2 }
  let front = parts[0] ?? ""
  let metadata: {{kind: String!, tags: [String!]!, pin: Boolean!, supersedes: [String!]!, status: String}}! = YAML.decode(front)
  assert { metadata.kind == "note" }
  assert { metadata.tags.isEmpty and metadata.supersedes.isEmpty }
  assert { !metadata.pin and metadata.status == null }
  assert { front.contains("tags: []") and front.contains("supersedes: []") }
  assert { front.contains("superseded_by: []") and front.contains("id: notes/defaults") }
  assert { front.contains("pin: false") and front.contains("status: null") }
  assert { parts[1] == "plain payload\n" }
  "Promotion default checks passed."
}

# promote facts/old, supersede it, promote facts/new: the committed files
# must import with facts/old superseded. A target never promoted stays out.
let testContextPromoteSupersedes(source: Workspace!): String! {
  let first = context.blockWrite("facts/old", ContextBlockKind.FACT, "old truth")
  let ws1 = source.directory("/").withChanges(first.promote(source, "facts/old"))
  let second = first
    .blockWrite("facts/never", ContextBlockKind.FACT, "never promoted")
    .blockWrite("facts/new", ContextBlockKind.FACT, "new truth", supersedes: ["facts/old", "facts/never"])
  let ws2 = ws1.withChanges(second.promote(ws1.asWorkspace, "facts/new"))
  assert { ws2.file("context/facts/old.md").contents.contains("status: superseded") }
  assert { !ws2.glob("context/facts/*.md").contains("context/facts/never.md") }
  let loaded = context.importBlocks(source: ws2.asWorkspace)
  assert { loaded.blockIndex.contains("facts/old  fact  1 line(s)  superseded by facts/new") }
  assert { !loaded.compose.contains("old truth") }
  "Promote supersession checks passed."
}

# A Context exercising every field: kinds, special-character tags, pins, a
# supersession chain, a dangling supersedes (its target pruned), markdown.
# Ids are written in alphabetical order so map order matches a nested
# directory's (glob) order.
let contextIoFixture: Context! {
  context
    .blockWrite("decisions/pruned", ContextBlockKind.NOTE, "gone soon")
    .blockWrite("decisions/x", ContextBlockKind.DECISION,
      "We **chose** facts/current over `facts/old`; see vito/agents#12 and #34.\n\n- one\n- two\n  continued\n\n| a | b |\n|---|---|\n| <script>alert(1)</script> | https://example.com/?a=1&b=2 |",
      tags: ["io", "colon: inside", "line\nbreak"], pin: true,
      supersedes: ["decisions/pruned"])
    .blockPrune(["decisions/pruned"], forget: true)
    .blockWrite("facts/current", ContextBlockKind.FACT, "current\n\n```\ncode ~~here~~\n```\n", tags: ["io"])
    .blockWrite("facts/old", ContextBlockKind.FACT, "old")
    .blockWrite("facts/z", ContextBlockKind.FACT, "z", supersedes: ["facts/old"])
    .blockWrite("glossary", ContextBlockKind.GLOSSARY, "a single-segment id", tags: ["io"])
}

let sameContext(a: Context!, b: Context!): Boolean! {
  a.blockIndex == b.blockIndex and a.compose == b.compose and
    a.blockRead("facts/old") == b.blockRead("facts/old") and
    a.exportJson.contents == b.exportJson.contents
}

let testContextExportRoundTrip(source: Workspace!): String! {
  let fixture = contextIoFixture
  let json = fixture.exportJson
  let doc: {{version: Int!, blocks: [{{id: String!, status: String, superseded_by: [String!]!, supersedes: [String!]!}}!]!}}! = JSON.decode(json.contents)
  assert { doc.version == 1 and doc.blocks.length == 5 }
  let byId(id: String!): [{{id: String!, status: String, superseded_by: [String!]!, supersedes: [String!]!}}!]! {
    doc.blocks.filter { b => b.id == id }
  }
  assert { byId("facts/old").map { b => b.status } == ["superseded"] }
  assert { byId("facts/old").map { b => b.superseded_by } == [["facts/z"]] }
  assert { byId("decisions/x").map { b => b.supersedes } == [["decisions/pruned"]] }
  assert { byId("decisions/x").map { b => b.superseded_by.isEmpty } == [true] }

  let fromJson = context.importBlocks(source: source, json: json)
  assert { sameContext(fromJson, fixture) }

  let nested = fixture.exportMarkdown
  assert { nested.glob("**/*.md").contains("facts/old.md") }
  assert { sameContext(context.importBlocks(source: source, from: nested), fixture) }

  # Flat files carry their ids in front matter; names are only a fallback.
  let flat = fixture.exportMarkdown(flat: true)
  assert { flat.entries.contains("facts~old.md") and !flat.entries.contains("facts/") }
  assert { sameContext(context.importBlocks(source: source, from: flat), fixture) }

  # Renamed files still import by their front-matter id; a file without an
  # id falls back to its name (~ read as /); stray files are skipped.
  let renamed = directory
    .withFile("one.md", flat.file("facts~old.md"))
    .withNewFile("notes~no-id.md", "---\nkind: note\n---\n\nfrom the name\n")
    .withNewFile("README.md", "# not a block\n")
  let loose = context.importBlocks(source: source, from: renamed)
  assert { loose.blockRead("facts/old").contains("old") }
  assert { loose.blockRead("notes/no-id").contains("from the name") }

  # The workspace path: a promoted context/, and a committed .json export.
  let ws = directory.withDirectory("context", nested).withFile("ctx.json", json).asWorkspace
  assert { sameContext(context.importBlocks(source: ws), fixture) }
  assert { sameContext(context.importBlocks(source: ws, path: "ctx.json"), fixture) }

  # The gist bundle: flat, index.html as the entry point, context.json wins.
  let gist = fixture.exportGist(markdown: true)
  assert { gist.entries.contains("index.html") and gist.entries.contains("context.json") }
  assert { gist.entries.contains("facts~old.md") }
  assert { gist.entries.all { e => !e.hasSuffix("/") } }
  assert { sameContext(context.importBlocks(source: source, from: gist), fixture) }
  assert { sameContext(context.importBlocks(source: source, from: fixture.exportGist), fixture) }
  "Context export/import round-trip checks passed."
}

let testContextImportConflicts(source: Workspace!): String! {
  let json = contextIoFixture.exportJson
  let session = context.blockWrite("facts/current", ContextBlockKind.FACT, "session truth")
  let refused = session.importBlocks(source: source, json: json).blockIndex rescue {
    e: Error => e.message
  }
  assert { refused.contains("already in the Context: facts/current") }
  assert { session.blockIndex.contains("1 block(s)") }
  let kept = session.importBlocks(source: source, json: json, onConflict: ContextImportConflict.KEEP)
  assert { kept.blockRead("facts/current").contains("session truth") }
  assert { kept.blockIndex.contains("decisions/x") }
  let replaced = session.importBlocks(source: source, json: json, onConflict: ContextImportConflict.REPLACE)
  assert { !replaced.blockRead("facts/current").contains("session truth") }

  # An imported supersedes retires the session's Block it names, even one
  # KEEP holds on to: facts/z supersedes facts/old in the export.
  let stale = context.blockWrite("facts/old", ContextBlockKind.FACT, "session old")
  let merged = stale.importBlocks(source: source, json: json, onConflict: ContextImportConflict.KEEP)
  assert { merged.blockRead("facts/old").contains("session old") }
  assert { merged.blockIndex.contains("facts/old  fact  1 line(s)  superseded by facts/z") }
  assert { !merged.compose.contains("session old") }

  # A context.json beside markdown fills in only what the markdown lacks;
  # markdown promote rewrote later wins.
  let older = context
    .blockWrite("facts/a", ContextBlockKind.FACT, "a1")
    .blockWrite("facts/c", ContextBlockKind.FACT, "only in json")
    .exportJson
  let mixed = context
    .blockWrite("facts/a", ContextBlockKind.FACT, "a2")
    .blockWrite("facts/b", ContextBlockKind.FACT, "promoted later")
    .exportMarkdown
    .withFile("context.json", older)
  let fromMixed = context.importBlocks(source: source, from: mixed)
  assert { fromMixed.blockRead("facts/a").contains("a2") }
  assert { fromMixed.blockRead("facts/b").contains("promoted later") }
  assert { fromMixed.blockRead("facts/c").contains("only in json") }

  let bad = directory.withNewFile("facts/bad.md", "---\nkind: rumor\n---\n\nx\n")
  let rejected = context.importBlocks(source: source, from: bad).blockIndex rescue {
    e: Error => e.message
  }
  assert { rejected.contains("facts/bad.md") and rejected.contains("unknown kind") }
  "Context import conflict checks passed."
}

let testContextHtml(source: Workspace!): String! {
  let fixture = contextIoFixture
  let html = fixture.exportHtml(title: "Ctx <&>", repo: "vito/agents").contents
  assert { html.hasPrefix("<!doctype html>") and html.contains("<title>Ctx &lt;&amp;&gt;</title>") }
  assert { html.contains(`id="b-decisions/x"`) and html.contains(`data-kind="decision"`) }
  assert { html.contains(`<a class="chip k-fact" href="#b-facts/current"`) }
  assert { html.contains(`<a class="chip k-fact gone" href="#b-facts/old"`) }
  assert { html.contains(`href="https://github.com/vito/agents/issues/12"`) }
  assert { html.contains(`href="https://github.com/vito/agents/issues/34"`) }
  assert { html.contains(`href="https://example.com/?a=1&amp;b=2"`) }
  assert { html.contains("<b>chose</b>") and html.contains("<li>two\ncontinued</li>") }
  assert { html.contains("<th>a</th>") and html.contains("&lt;script&gt;alert(1)&lt;/script&gt;") }
  assert { !html.contains("<script>alert") }
  assert { html.contains("<pre>code ~~here~~</pre>") }
  assert { html.contains("References → ") and html.contains("Referenced by ← ") }
  assert { html.contains("Superseded by ") and html.contains(`<code>decisions/pruned</code>`) }
  assert { html.contains("📌 pinned") and html.contains("1 superseded") }
  assert { fixture.exportHtml(title: "Ctx <&>", repo: "vito/agents").contents == html }

  # A Block revived by blockWrite after being superseded is active: no
  # superseded_by in its exports, no "Superseded by" on its card.
  let revived = context
    .blockWrite("facts/y", ContextBlockKind.FACT, "y")
    .blockWrite("facts/x", ContextBlockKind.FACT, "x", supersedes: ["facts/y"])
    .blockWrite("facts/y", ContextBlockKind.FACT, "y again")
  let revivedDoc: {{blocks: [{{id: String!, status: String, superseded_by: [String!]!}}!]!}}! = JSON.decode(revived.exportJson.contents)
  assert { revivedDoc.blocks.filter { b => b.id == "facts/y" }.map { b => b.superseded_by.isEmpty and b.status == null } == [true] }
  assert { revived.exportMarkdown.file("facts/y.md").contents.contains("superseded_by: []") }
  assert { !revived.exportHtml.contents.contains("Superseded by") }

  let changes = fixture.promoteAll(source, path: "out", flat: true, html: true, json: true)
  let landed = source.directory("/").withChanges(changes)
  assert { landed.file("out/facts~old.md").contents == fixture.exportMarkdown(flat: true).file("facts~old.md").contents }
  assert { landed.file("out/index.html").contents.hasPrefix("<!doctype html>") }
  assert { landed.file("out/context.json").contents == fixture.exportJson.contents }
  "Context HTML and promoteAll checks passed."
}

# The curated sections: lead Blocks under "At a glance" in the caller's
# order, then every active QUESTION, #blocker first, then pinned.
let testContextHtmlCurated(source: Workspace!): String! {
  let plain = contextIoFixture.exportHtml.contents
  assert { !plain.contains(`id="glance"`) and !plain.contains(`id="questions"`) }

  let fixture = contextIoFixture
    .blockWrite("results/status", ContextBlockKind.RESULT, "| pr | state |\n|---|---|\n| #40 | draft |")
    .blockWrite("questions/a-plain", ContextBlockKind.QUESTION, "plain question")
    .blockWrite("questions/b-blocks", ContextBlockKind.QUESTION, "blocking question", tags: ["blocker"])
    .blockWrite("questions/c-pinned", ContextBlockKind.QUESTION, "pinned question", pin: true)
    .blockWrite("questions/d-led", ContextBlockKind.QUESTION, "led question")
    .blockWrite("questions/e-old", ContextBlockKind.QUESTION, "old question")
    .blockWrite("questions/f-new", ContextBlockKind.QUESTION, "new question", supersedes: ["questions/e-old"])
  let html = fixture.exportHtml(lead: ["results/status", "questions/d-led", "glossary"]).contents

  let afterGlance = html.split(`<h2 id="glance">`)[1] ?? ""
  let glance = afterGlance.split(`<h2 id="questions">`)[0] ?? ""
  let afterQuestions = afterGlance.split(`<h2 id="questions">`)[1] ?? ""
  let questions = afterQuestions.split(`<h2 id="overview">`)[0] ?? ""
  assert { glance != "" and questions != "" and afterQuestions.contains(`<h2 id="overview">`) }
  assert { html.contains(`<a href="#glance">At a glance</a><a href="#questions">Open questions</a>`) }

  # Lead keeps the caller's order; featured cards are anchorless copies.
  let ledOrder = glance.split(`<a class="bid" href="#b-`).dropFirst(1).map { s => s.split(`"`)[0] ?? "" }
  assert { ledOrder == ["results/status", "questions/d-led", "glossary"] }
  assert { glance.contains("<th>pr</th>") }
  assert { html.split(`id="b-results/status"`).length == 2 }

  # Questions: blocker, pinned, then the rest; led and superseded ones out.
  let asked = questions.split(`<a class="bid" href="#b-`).dropFirst(1).map { s => s.split(`"`)[0] ?? "" }
  assert { asked == ["questions/b-blocks", "questions/c-pinned", "questions/a-plain", "questions/f-new"] }
  assert { questions.contains(`<span class="badge">BLOCKER</span>`) and questions.contains("1 blocking") }
  assert { html.split(`<span class="badge">BLOCKER</span>`).length == 3 }

  # The Blocks list stays complete: every active Block has its one card.
  assert { html.split(`id="b-questions/d-led"`).length == 2 }

  let unknown = fixture.exportHtml(lead: ["facts/nope"]).contents rescue { e: Error => e.message }
  assert { unknown.contains(`no block "facts/nope"`) }
  let stale = fixture.exportHtml(lead: ["questions/e-old"]).contents rescue { e: Error => e.message }
  assert { stale.contains("it is superseded") and stale.contains("questions/f-new") }
  let noHtml = source.directory("/").withChanges(fixture.promoteAll(source, lead: ["glossary"])).entries rescue {
    e: Error => [e.message]
  }
  assert { noHtml.any { m => m.contains("pass html: true") } }
  let gist = fixture.exportGist(lead: ["results/status"]).file("index.html").contents
  assert { gist.contains(`<h2 id="glance">`) }
  "Context curated HTML checks passed."
}

# Questions get Q-numbers: assigned in order, kept across rewrites and
# supersession, never reused after a prune, accepted as ids, exported and
# imported, renumbered only on a clash.
let testContextShortIds(source: Workspace!): String! {
  let ctx = context
    .blockWrite("facts/a", ContextBlockKind.FACT, "not a question")
    .blockWrite("questions/one", ContextBlockKind.QUESTION, "first?")
    .blockWrite("questions/two", ContextBlockKind.QUESTION, "second? see Q-1")
  assert { ctx.blockIndex.contains("questions/one  question  Q-1  1 line(s)") }
  assert { ctx.blockIndex.contains("questions/two  question  Q-2  1 line(s)") }
  assert { ctx.blockIndex.contains("facts/a  fact  1 line(s)") }
  assert { ctx.blockRead("Q-2").contains("── questions/two · question · Q-2 ──") }
  assert { ctx.compose(ids: ["Q-1"]).contains("first?") }

  # Rewrites keep the number; forgetting the newest never frees it.
  let rewritten = ctx.blockWrite("questions/one", ContextBlockKind.QUESTION, "first, reworded?")
  assert { rewritten.blockIndex.contains("questions/one  question  Q-1") }
  let pruned = rewritten.blockPrune(["Q-2"], forget: true).blockWrite("questions/three", ContextBlockKind.QUESTION, "third?")
  assert { pruned.blockIndex.contains("questions/three  question  Q-3") }

  # Answering supersedes the question by its number; the number stays.
  let answered = pruned.blockWrite("decisions/one", ContextBlockKind.DECISION, "answered", supersedes: ["Q-1"])
  assert { answered.blockIndex.contains("questions/one  question  Q-1  1 line(s)  superseded by decisions/one") }
  assert { answered.blockRead("Q-1").contains("superseded by decisions/one") }
  let unknown = answered.blockRead("Q-9") rescue { e: Error => e.message }
  assert { unknown.contains("no question Q-9") }

  # Exports carry the number; a fresh session keeps it.
  let md = answered.exportMarkdown.file("questions/three.md").contents
  assert { md.contains("number: 3") }
  assert { answered.exportMarkdown.file("facts/a.md").contents.contains("number: null") }
  let fresh = context.importBlocks(source: source, json: answered.exportJson)
  assert { fresh.blockRead("Q-3").contains("third?") }
  assert { fresh.blockWrite("questions/four", ContextBlockKind.QUESTION, "fourth?").blockIndex.contains("questions/four  question  Q-4") }

  # A clash with the session's own numbers renumbers the import; a
  # question recorded without a number (an older export) gets one.
  let other = context.blockWrite("questions/mine", ContextBlockKind.QUESTION, "mine?")
  let legacy = directory.withNewFile("questions/old.md", "---\nkind: question\n---\n\nolder export\n")
  let merged = other
    .importBlocks(source: source, json: answered.exportJson)
    .importBlocks(source: source, from: legacy)
  assert { merged.blockRead("Q-1").contains("mine?") }
  assert { merged.blockIndex.contains("questions/one  question  Q-4") }
  assert { merged.blockIndex.contains("questions/three  question  Q-3") }
  assert { merged.blockIndex.contains("questions/old  question  Q-5") }

  # The page labels questions and links Q-numbers in text.
  let html = answered.blockWrite("notes/n", ContextBlockKind.NOTE, "open: Q-3 and `Q-1`").exportHtml(lead: ["Q-3"]).contents
  assert { html.contains(`<span class="qn">Q-3</span>`) }
  assert { html.contains(`<a class="chip k-question" href="#b-questions/three" title="questions/three">Q-3</a>`) }
  assert { html.contains(`<a class="chip k-question gone" href="#b-questions/one" title="questions/one">Q-1</a>`) }
  assert { html.contains(`<a class="bid" href="#b-questions/three">`) }

  # blockWrite takes an existing question's Q-number as its id.
  let reworded = answered.blockWrite("Q-3", ContextBlockKind.QUESTION, "third, reworded?")
  assert { reworded.blockRead("questions/three").contains("third, reworded?") }

  # A forgotten number stays retired across an exportJson round trip, and
  # within the session that forgot it.
  let forgetting = context
    .blockWrite("questions/x", ContextBlockKind.QUESTION, "x?")
    .blockWrite("questions/y", ContextBlockKind.QUESTION, "y?")
    .blockPrune(["Q-2"], forget: true)
  let reborn = context.importBlocks(source: source, json: forgetting.exportJson)
    .blockWrite("questions/z", ContextBlockKind.QUESTION, "z?")
  assert { reborn.blockIndex.contains("questions/z  question  Q-3") }
  let stranger = context.blockWrite("questions/other", ContextBlockKind.QUESTION, "other?")
    .blockWrite("questions/second", ContextBlockKind.QUESTION, "second?")
    .exportJson
  let into = forgetting.importBlocks(source: source, json: stranger)
  assert { into.blockIndex.contains("questions/other  question  Q-3") }
  assert { into.blockIndex.contains("questions/second  question  Q-4") }

  # Renumbering carries the imported text's citations along.
  let theirs = context
    .blockWrite("notes/m", ContextBlockKind.NOTE, "blocked on Q-1, not Q-7")
    .blockWrite("questions/theirs", ContextBlockKind.QUESTION, "theirs?")
    .exportJson
  let mine = context.blockWrite("questions/mine", ContextBlockKind.QUESTION, "mine?")
    .importBlocks(source: source, json: theirs)
  assert { mine.blockIndex.contains("questions/theirs  question  Q-2") }
  assert { mine.blockRead("notes/m").contains("blocked on Q-2, not Q-7") }
  assert { mine.blockRead("Q-1").contains("mine?") }

  # Re-importing a legacy file with REPLACE keeps the number it got.
  let once = context.importBlocks(source: source, from: legacy)
  let twice = once.importBlocks(source: source, from: legacy, onConflict: ContextImportConflict.REPLACE)
  assert { twice.blockIndex == once.blockIndex }
  assert { twice.blockIndex.contains("questions/old  question  Q-1") }
  "Context short id checks passed."
}

# blockPrune drops by default: kept, out of composition, exported and
# rendered as dropped, revived by blockWrite. forget deletes outright.
let testContextDrop(source: Workspace!): String! {
  let ctx = context
    .blockWrite("facts/keep", ContextBlockKind.FACT, "still true")
    .blockWrite("results/served", ContextBlockKind.RESULT, "served its purpose")
    .blockWrite("questions/moot", ContextBlockKind.QUESTION, "moot now? see results/served", tags: ["blocker"])
  let dropped = ctx.blockPrune(["results/served", "Q-1"])
  let index = dropped.blockIndex
  assert { index.contains("3 block(s) — 1 active (1 text line(s), 0 pinned), 0 superseded, 2 dropped") }
  assert { index.contains("results/served  result  1 line(s)  dropped") }
  assert { index.contains("questions/moot  question  Q-1  1 line(s)  #blocker  dropped") }
  assert { !dropped.compose.contains("served its purpose") }
  assert { dropped.compose.contains("2 superseded or dropped block(s) held out") }
  assert { dropped.blockRead("results/served").contains("(dropped — kept for the record") }

  # Dropping twice is refused; forget is the explicit way out.
  let again = dropped.blockPrune(["results/served"]).blockIndex rescue { e: Error => e.message }
  assert { again.contains("already dropped") and again.contains("forget: true") }
  let forgotten = dropped.blockPrune(["results/served"], forget: true)
  assert { !forgotten.blockIndex.contains("results/served") }

  # Exports say dropped, and importing them keeps it so.
  let md = dropped.exportMarkdown.file("results/served.md").contents
  assert { md.contains("status: dropped") }
  let back = context.importBlocks(source: source, json: dropped.exportJson)
  assert { back.blockIndex == dropped.blockIndex }
  assert { context.importBlocks(source: source, from: dropped.exportMarkdown).blockIndex == dropped.blockIndex }

  # The page lists them apart, never as open questions or in the matrix.
  let html = dropped.exportHtml.contents
  assert { html.contains(`<h2 id="dropped">Dropped</h2>`) and html.contains("2 dropped") }
  assert { !html.contains(`<h2 id="questions">`) and !html.contains("BLOCKER</span>") }
  assert { html.contains(`<a class="chip k-result gone" href="#b-results/served"`) }
  assert { html.contains("Dropped: stopped mattering") }
  let led = dropped.exportHtml(lead: ["results/served"]).contents rescue { e: Error => e.message }
  assert { led.contains("it is dropped") }

  # blockWrite revives; superseding a dropped Block makes it superseded only.
  let revived = dropped.blockWrite("results/served", ContextBlockKind.RESULT, "useful again")
  assert { revived.blockIndex.contains("results/served  result  1 line(s)\n") }
  let replaced = dropped.blockWrite("decisions/settled", ContextBlockKind.DECISION, "answered after all", supersedes: ["Q-1"])
  assert { replaced.blockIndex.contains("questions/moot  question  Q-1  1 line(s)  #blocker  superseded by decisions/settled") }
  assert { replaced.blockIndex.contains("1 superseded, 1 dropped") }

  # A superseded Block whose replacement was dropped says so.
  let chain = context
    .blockWrite("results/r1", ContextBlockKind.RESULT, "first")
    .blockWrite("results/r2", ContextBlockKind.RESULT, "second", supersedes: ["results/r1"])
    .blockPrune(["results/r2"])
  let read = chain.blockRead("results/r1")
  assert { read.contains("superseded by results/r2 (dropped)") and read.contains("nothing active replaces it now") }

  # Leading with a superseded Block whose replacement was forgotten names
  # no empty pointer.
  let orphan = chain.blockPrune(["results/r2"], forget: true).exportHtml(lead: ["results/r1"]).contents rescue {
    e: Error => e.message
  }
  assert { orphan.contains(`cannot lead with "results/r1": it is superseded`) and !orphan.contains("()") }
  "Context drop checks passed."
}

let testContextTools: String! {
  let tools = context.agent(llm).tools
  assert { tools.contains("promote") and tools.contains("blockWrite") }
  assert { tools.contains("promoteAll") and tools.contains("importBlocks") }
  assert { tools.contains("exportJson") and tools.contains("exportMarkdown") }
  assert { tools.contains("exportHtml") and tools.contains("exportGist") }
  assert { !tools.contains("checkPromotionMetadata") }
  assert { !tools.contains("checkPromotionDefaults") and !tools.contains("checkTools") }
  "Context tool visibility checks passed."
}
