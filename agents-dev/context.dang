# Helpers: exportContext returns a Changeset against a workspace, so the
# checks export into scratch directories and import back from them.

let scratch: Workspace! {
  directory.asWorkspace
}

# Export into a scratch directory's out/ and return out/.
let exportedDir(ctx: Context!, formats: [ContextExportFormat!]!, flat: Boolean! = false): Directory! {
  directory.withChanges(ctx.exportContext(source: scratch, path: "out", formats: formats, flat: flat)).directory("out")
}

let jsonOf(ctx: Context!): File! {
  exportedDir(ctx, [ContextExportFormat.JSON]).file("context.json")
}

let markdownOf(ctx: Context!, flat: Boolean! = false): Directory! {
  exportedDir(ctx, [ContextExportFormat.MARKDOWN], flat: flat)
}

let htmlOf(ctx: Context!, title: String! = "Context", repo: String! = "", lead: [String!]! = []): String! {
  directory.withChanges(ctx.exportContext(source: scratch, path: "out",
    formats: [ContextExportFormat.HTML], offlineHtml: true, title: title, repo: repo, lead: lead)).file("out/index.html").contents
}

let questionsOf(ctx: Context!, repo: String! = ""): String! {
  directory.withChanges(ctx.exportContext(source: scratch, path: "out",
    formats: [ContextExportFormat.HTML], offlineHtml: true, repo: repo)).file("out/questions.html").contents
}

let importDir(ctx: Context!, dir: Directory!, onConflict: ContextImportConflict! = ContextImportConflict.ERROR): Context! {
  ctx.importContext(source: directory.withDirectory("in", dir).asWorkspace, from: "in", onConflict: onConflict)
}

let importJson(ctx: Context!, json: File!, onConflict: ContextImportConflict! = ContextImportConflict.ERROR): Context! {
  ctx.importContext(source: directory.withFile("in.json", json).asWorkspace, from: "in.json", onConflict: onConflict)
}

let readBlock(ctx: Context!, id: String!): String! {
  ctx.compose(ids: [id])
}

# blockWrite requires a QUESTION's priority and summary; checks about
# something else give every question this one.
let p2: ContextQuestionPriority! = ContextQuestionPriority.P2

let testContextExportMetadata(source: Workspace!): String! {
  let tags = [
    "comma,inside", "colon: inside", "double\"quote", "single'quote",
    "line\nbreak", "true", "null", "123", "[brackets]", "# comment",
    "back\\slash", "---\nstatus: forged",
  ]
  let text = "# Payload\n\n---\n\n```yaml\nstatus: unchanged\n```\n  indented\n\n"
  let fixture = context
    .blockWrite("facts/old", ContextBlockKind.FACT, "old")
    .blockWrite("facts/current", ContextBlockKind.DECISION, text, tags: tags,
      pin: true, supersedes: ["facts/old"])
  [fixture, fixture.blockWrite("facts/new", ContextBlockKind.FACT, "new",
    supersedes: ["facts/current"])].each { state, i =>
    let contents = markdownOf(state).file("facts/current.md").contents
    assert { contents.hasPrefix("---\n") }
    let parts = contents.trimPrefix("---\n").split("\n---\n\n", limit: 2)
    assert { parts.length == 2 }
    let front = parts[0] ?? ""
    let metadata: {{id: String!, kind: String!, tags: [String!]!, pin: Boolean!, supersedes: [String!]!, superseded_by: [String!]!, status: String}}! = YAML.decode(front)
    assert { metadata.id == "facts/current" }
    assert { metadata.kind == "decision" }
    assert { metadata.tags == tags }
    assert { metadata.pin }
    assert { metadata.supersedes == ["facts/old"] }
    let expectedStatus = if (i == 0) { null } else { "superseded" }
    assert { metadata.status == expectedStatus }
    let expectedBy = if (i == 0) { [] :: [String!]! } else { ["facts/new"] }
    assert { metadata.superseded_by == expectedBy }
    assert { parts[1] == text + "\n" }
    let roundtrip: {{id: String!, kind: String!, tags: [String!]!, pin: Boolean!, supersedes: [String!]!, superseded_by: [String!]!, status: String}}! = YAML.decode(YAML.encode(metadata))
    assert { roundtrip == metadata }
  }
  # JSON-only gists carry presentation data without changing document v1.
  let questions = context
    .blockWrite("questions/open", ContextBlockKind.QUESTION, "open?", priority: p2, summary: "Open?")
    .blockWrite("questions/foreign", ContextBlockKind.QUESTION, "foreign?", priority: p2, summary: "Foreign?")
    .blockWrite("questions/old", ContextBlockKind.QUESTION, "old?", priority: p2, summary: "Old?")
    .blockWrite("questions/dropped", ContextBlockKind.QUESTION, "dropped?", priority: p2, summary: "Dropped?")
    .blockWrite("notes/lead", ContextBlockKind.NOTE, "At a glance")
  let active = questions
    .blockWrite("decisions/answer", ContextBlockKind.DECISION, "answered", supersedes: ["questions/old"])
    .blockDrop(["questions/dropped"])
  let title = "Review <this> \"title\""
  let repo = "vito/agents"
  let lead = ["notes/lead", "questions/open"]
  let expected = {{version: 1, title: title, repo: repo, lead: lead, ownQuestions: ["questions/foreign", "questions/open"]}}
  # Both optional HTML modes retain identical JSON metadata.
  [false, true].each { offline =>
    let bundle = directory.withChanges(active.exportContext(source: scratch, path: ".",
      formats: [ContextExportFormat.JSON, ContextExportFormat.HTML], offlineHtml: offline,
      title: title, repo: repo, lead: ["notes/lead", "Q-1", "notes/lead"]))
    let doc: {{version: Int!, viewer: {{version: Int!, title: String!, repo: String!, lead: [String!]!, ownQuestions: [String!]!}}!}}! = JSON.decode(bundle.file("context.json").contents)
    assert { doc.version == 1 and doc.viewer == expected }
    assert { importDir(context, bundle).blockIndex == active.blockIndex }
  }
  let onlyJson = directory.withChanges(active.exportContext(source: scratch, path: ".",
    formats: [ContextExportFormat.JSON], title: title, repo: repo, lead: ["notes/lead", "Q-1"]))
  assert { onlyJson.entries == ["context.json"] }
  let doc: {{version: Int!, viewer: {{version: Int!, title: String!, repo: String!, lead: [String!]!, ownQuestions: [String!]!}}!}}! = JSON.decode(onlyJson.file("context.json").contents)
  assert { doc.version == 1 and doc.viewer == expected }
  assert { importDir(context, onlyJson).blockIndex == active.blockIndex }

  # Incidental JSON refreshes from markdown edits keep presentation settings,
  # pruning a dropped lead and recomputing which own questions remain open.
  let edited = active.blockDrop(["notes/lead", "questions/foreign"])
  let incidental = onlyJson.withChanges(edited.exportContext(source: onlyJson.asWorkspace,
    path: ".", ids: ["notes/lead"]))
  let incidentalDoc: {{viewer: {{version: Int!, title: String!, repo: String!, lead: [String!]!, ownQuestions: [String!]!}}!}}! = JSON.decode(incidental.file("context.json").contents)
  assert { incidentalDoc.viewer == {{version: 1, title: title, repo: repo, lead: ["questions/open"], ownQuestions: ["questions/open"]}} }
  let explicit = onlyJson.withChanges(edited.exportContext(source: onlyJson.asWorkspace,
    path: ".", formats: [ContextExportFormat.JSON], ids: ["notes/lead"]))
  let explicitDoc: {{viewer: {{title: String!, repo: String!, lead: [String!]!}}!}}! = JSON.decode(explicit.file("context.json").contents)
  assert { explicitDoc.viewer.title == "Context" and explicitDoc.viewer.repo == "" and explicitDoc.viewer.lead.isEmpty }

  # A fresh selection excludes other live questions, unlike a retained copy.
  let selected = directory.withChanges(active.exportContext(source: scratch, path: ".",
    formats: [ContextExportFormat.JSON], ids: ["Q-1"], lead: ["Q-1"]))
  let selectedDoc: {{viewer: {{lead: [String!]!, ownQuestions: [String!]!}}!}}! = JSON.decode(selected.file("context.json").contents)
  assert { selectedDoc.viewer.lead == ["questions/open"] and selectedDoc.viewer.ownQuestions == ["questions/open"] }
  # Retained own questions stay answerable; foreign, dropped, superseded,
  # and never-exported questions do not become the viewer's own questions.
  let session = active.blockDrop(["questions/foreign"], forget: true)
    .blockWrite("questions/omitted", ContextBlockKind.QUESTION, "omitted?", priority: p2, summary: "Omitted?")
  # An old unnumbered foreign question can coexist without crossing Q-number
  # namespaces (numbered conflicts are covered by the export refresh check).
  let prior = onlyJson.withNewFile("context.json", onlyJson.file("context.json").contents.replaceMatches(`"number"\s*:\s*2`, with: `"number":null`))
    .withNewFile("keep.txt", "unrelated")
    .withNewFile("index.html", "unrelated HTML")
  let refreshed = prior.withChanges(session.exportContext(source: prior.asWorkspace, path: ".",
    formats: [ContextExportFormat.JSON], ids: ["notes/lead"], lead: ["notes/lead"]))
  let refreshedDoc: {{viewer: {{lead: [String!]!, ownQuestions: [String!]!}}!, blocks: [{{id: String!}}!]!}}! = JSON.decode(refreshed.file("context.json").contents)
  assert { refreshedDoc.viewer.lead == ["notes/lead"] and refreshedDoc.viewer.ownQuestions == ["questions/open"] }
  assert { refreshedDoc.blocks.any { b => b.id == "questions/foreign" } }
  assert { !refreshedDoc.blocks.any { b => b.id == "questions/omitted" } }
  assert { refreshed.file("keep.txt").contents == "unrelated" and refreshed.file("index.html").contents == "unrelated HTML" }

  # Viewer settings are optional presentation data, never import state.
  let legacy = directory.withNewFile("context.json", `{ "version": 1, "blocks": [{"id":"notes/legacy","kind":"note","text":"legacy"}] }`)
  let legacyWithViewer = directory.withNewFile("context.json", `{ "version": 1, "viewer": {"version":99,"title":"future"}, "blocks": [{"id":"notes/legacy","kind":"note","text":"legacy"}] }`)
  assert { importDir(context, legacy).blockIndex == importDir(context, legacyWithViewer).blockIndex }
  "Export metadata and payload checks passed."
}

let testContextExportDefaults(source: Workspace!): String! {
  let fixture = context.blockWrite("notes/defaults", ContextBlockKind.NOTE, "plain payload")
  let changes = fixture.exportContext(source: scratch)
  let contents = directory.withChanges(changes).file("context/notes/defaults.md").contents
  let parts = contents.trimPrefix("---\n").split("\n---\n\n", limit: 2)
  assert { contents.hasPrefix("---\n") and parts.length == 2 }
  let front = parts[0] ?? ""
  let metadata: {{kind: String!, tags: [String!]!, pin: Boolean!, supersedes: [String!]!, status: String}}! = YAML.decode(front)
  assert { metadata.kind == "note" }
  assert { metadata.tags.isEmpty and metadata.supersedes.isEmpty }
  assert { !metadata.pin and metadata.status == null }
  assert { front.contains("tags: []") and front.contains("supersedes: []") }
  assert { front.contains("superseded_by: []") and front.contains("id: notes/defaults") }
  assert { front.contains("pin: false") and front.contains("status: null") }
  assert { parts[1] == "plain payload\n" }
  "Export default checks passed."
}

# Export facts/old, supersede it, export only facts/new: the file already
# exported is refreshed, so the committed files import with facts/old
# superseded. A Block never exported stays out.
let testContextExportRefresh(source: Workspace!): String! {
  let first = context.blockWrite("facts/old", ContextBlockKind.FACT, "old truth")
  let d1 = directory.withChanges(first.exportContext(source: scratch, ids: ["facts/old"]))
  let second = first
    .blockWrite("facts/never", ContextBlockKind.FACT, "never exported")
    .blockWrite("facts/new", ContextBlockKind.FACT, "new truth", supersedes: ["facts/old", "facts/never"])
  let d2 = d1.withChanges(second.exportContext(source: d1.asWorkspace, ids: ["facts/new"]))
  assert { d2.file("context/facts/old.md").contents.contains("status: superseded") }
  assert { d2.glob("context/facts/*.md") == ["context/facts/new.md", "context/facts/old.md"] }
  let loaded = context.importContext(source: d2.asWorkspace)
  assert { loaded.blockIndex.contains("facts/old  fact  1 line(s)  superseded by facts/new") }
  assert { !loaded.compose.contains("old truth") }

  # Switching layout moves the files: one per Block, so it still imports.
  let d3 = d2.withChanges(second.exportContext(source: d2.asWorkspace, flat: true))
  assert { d3.glob("context/**/*.md") == ["context/facts~never.md", "context/facts~new.md", "context/facts~old.md"] }
  assert { context.importContext(source: d3.asWorkspace).blockIndex.contains("facts/old  fact  1 line(s)  superseded by facts/new") }

  # An update without MARKDOWN (the gist recipe) still refreshes the
  # markdown already there, which would otherwise win on import.
  let third = second.blockWrite("facts/newer", ContextBlockKind.FACT, "newer truth", supersedes: ["facts/new"])
  let gistFormats = [ContextExportFormat.JSON, ContextExportFormat.HTML]
  let d4 = d3.withChanges(third.exportContext(source: d3.asWorkspace, formats: gistFormats))
  assert { d4.file("context/facts~new.md").contents.contains("status: superseded") }
  assert { context.importContext(source: d4.asWorkspace).blockIndex.contains("facts/new  fact  1 line(s)  superseded by facts/newer") }

  # A narrower JSON export keeps every Block the copy already held, and the
  # entries of Blocks this Context lacks.
  let d5 = d4.withChanges(third.exportContext(source: d4.asWorkspace, formats: [ContextExportFormat.JSON], ids: ["facts/newer"]))
  let doc: {{blocks: [{{id: String!}}!]!}}! = JSON.decode(d5.file("context/context.json").contents)
  assert { doc.blocks.map { b => b.id } == ["facts/never", "facts/new", "facts/newer", "facts/old"] }
  let elsewhere = d5.withFile("context/context.json", jsonOf(context.blockWrite("notes/elsewhere", ContextBlockKind.NOTE, "elsewhere")))
  let d6 = elsewhere.withChanges(third.exportContext(source: elsewhere.asWorkspace, formats: [ContextExportFormat.JSON], ids: ["facts/newer"]))
  let json = d6.file("context/context.json").contents
  assert { json.contains(`"notes/elsewhere"`) and json.contains(`"facts/old"`) }

  # Refresh a JSON+HTML bundle after answering, even when only HTML is
  # requested. A narrow export keeps the old question and foreign Blocks.
  let question = context.blockWrite("questions/ship", ContextBlockKind.QUESTION, "Ready to ship?", priority: p2, summary: "Ship?")
  let bundle = exportedDir(question.blockWrite("notes/foreign", ContextBlockKind.NOTE, "kept from another session"), gistFormats)
  let answered = question.blockWrite("decisions/ship", ContextBlockKind.DECISION, "Ship now.", supersedes: ["questions/ship"])
  let updated = bundle.withChanges(answered.exportContext(source: bundle.asWorkspace, path: ".",
    formats: [ContextExportFormat.HTML], ids: ["decisions/ship"]))
  let updatedDoc: {{viewer: {{ownQuestions: [String!]!}}!}}! = JSON.decode(updated.file("context.json").contents)
  assert { updatedDoc.viewer.ownQuestions.isEmpty }
  let imported = importDir(context, updated)
  assert { imported.compose.contains("Ship now.") and !imported.compose.contains("Ready to ship?") }
  assert { readBlock(imported, "questions/ship").contains("superseded by decisions/ship") }
  assert { readBlock(imported, "notes/foreign").contains("kept from another session") }
  # HTML alone includes its JSON dependency; offline HTML needs no JSON.
  assert { exportedDir(answered, [ContextExportFormat.HTML]).entries == ["boot.js", "context.css", "context.json", "index.html", "interactions.js", "questions.html", "render.js"] }
  assert { directory.withChanges(answered.exportContext(source: scratch, path: "out", formats: [ContextExportFormat.HTML], offlineHtml: true)).directory("out").entries == ["index.html", "questions.html"] }

  # A different session refreshing HTML must not lower the JSON's retired
  # Q-number high-water mark, even when that question no longer has a Block.
  let retired = question.blockWrite("questions/retired", ContextBlockKind.QUESTION, "obsolete", priority: p2, summary: "Obsolete?")
    .blockDrop(["questions/retired"], forget: true)
  let numberedBundle = exportedDir(retired, gistFormats)
  let other = context.blockWrite("notes/other", ContextBlockKind.NOTE, "another session")
  let refreshedBundle = numberedBundle.withChanges(other.exportContext(source: numberedBundle.asWorkspace, path: ".", formats: [ContextExportFormat.HTML]))
  let resumed = importDir(context, refreshedBundle)
    .blockWrite("questions/next", ContextBlockKind.QUESTION, "next", priority: p2, summary: "Next?")
  assert { resumed.blockIndex.contains("questions/next  question  Q-3") }

  # A high-water mark cannot reconcile two different questions already
  # called Q-1. Refuse the refresh rather than corrupting their citations.
  let colliding = context.blockWrite("questions/other", ContextBlockKind.QUESTION, "another Q-1", priority: p2, summary: "Other?")
  let collision = numberedBundle.withChanges(colliding.exportContext(source: numberedBundle.asWorkspace, path: ".", formats: [ContextExportFormat.HTML])).entries rescue {
    e: Error => [e.message]
  }
  assert { collision.any { s => s.contains("import the existing context first") } }

  # A partial import can renumber a question without leaving duplicate
  # numbers, while foreign text still cites the original assignment.
  let citedBundle = exportedDir(question.blockWrite("notes/citation", ContextBlockKind.NOTE, "See Q-1"), gistFormats)
  let partial = importJson(colliding, jsonOf(question))
  let changed = citedBundle.withChanges(partial.exportContext(source: citedBundle.asWorkspace, path: ".", formats: [ContextExportFormat.HTML])).entries rescue {
    e: Error => [e.message]
  }
  assert { changed.any { s => s.contains("question numbers changed") and s.contains("import the existing context first") } }
  # A selective export may keep only a citation, not the question itself.
  # Its high-water mark still reserves that number against unrelated reuse.
  let citationOnly = directory.withChanges(question.blockWrite("notes/citation", ContextBlockKind.NOTE, "See Q-1")
    .exportContext(source: scratch, path: ".", formats: gistFormats, ids: ["notes/citation"]))
  let reused = citationOnly.withChanges(colliding.exportContext(source: citationOnly.asWorkspace, path: ".", formats: [ContextExportFormat.HTML])).entries rescue {
    e: Error => [e.message]
  }
  assert { reused.any { s => s.contains("import the existing context first") } }
  # The opposite selection also conflicts: a session note can cite its
  # omitted question while the copy retains another question with that number.
  let omitted = numberedBundle.withChanges(colliding.blockWrite("notes/new", ContextBlockKind.NOTE, "See Q-1")
    .exportContext(source: numberedBundle.asWorkspace, path: ".", formats: [ContextExportFormat.HTML], ids: ["notes/new"])).entries rescue {
    e: Error => [e.message]
  }
  assert { omitted.any { s => s.contains("import the existing context first") } }
  # After a selective import, only the session high-water mark remembers
  # the cited question. It still reserves that number against foreign reuse.
  let citationSession = importDir(context, citationOnly)
  let unrelatedBundle = exportedDir(colliding, gistFormats)
  let reserved = unrelatedBundle.withChanges(citationSession.exportContext(source: unrelatedBundle.asWorkspace, path: ".", formats: [ContextExportFormat.HTML])).entries rescue {
    e: Error => [e.message]
  }
  assert { reserved.any { s => s.contains("import the existing context first") } }

  # Foreign supersession metadata survives even when the prior selective
  # export omitted the replacement Block itself.
  let resolvedBundle = directory.withChanges(answered.exportContext(source: scratch, path: ".", formats: gistFormats, ids: ["questions/ship"]))
  let foreignRefresh = resolvedBundle.withChanges(other.exportContext(source: resolvedBundle.asWorkspace, path: ".", formats: [ContextExportFormat.HTML]))
  let foreignDoc: {{blocks: [{{id: String!, superseded_by: [String!]!}}!]!}}! = JSON.decode(foreignRefresh.file("context.json").contents)
  assert { foreignDoc.blocks.filter { b => b.id == "questions/ship" }.map { b => b.superseded_by } == [["decisions/ship"]] }
  "Export refresh checks passed."
}

# A Context exercising every field: kinds, special-character tags, pins, a
# supersession chain, a dangling supersedes (its target forgotten),
# markdown. Ids are written in alphabetical order so map order matches a
# nested directory's (glob) order.
let contextIoFixture: Context! {
  context
    .blockWrite("decisions/pruned", ContextBlockKind.NOTE, "gone soon")
    .blockWrite("decisions/x", ContextBlockKind.DECISION,
      "We **chose** facts/current over `facts/old`; see vito/agents#12 and #34.\n\n- one\n- two\n  continued\n\n| a | b |\n|---|---|\n| <script>alert(1)</script> | https://example.com/?a=1&b=2 |",
      tags: ["io", "colon: inside", "line\nbreak"], pin: true,
      supersedes: ["decisions/pruned"])
    .blockDrop(["decisions/pruned"], forget: true)
    .blockWrite("facts/current", ContextBlockKind.FACT, "current\n\n```\ncode ~~here~~\n```\n", tags: ["io"])
    .blockWrite("facts/old", ContextBlockKind.FACT, "old")
    .blockWrite("facts/z", ContextBlockKind.FACT, "z", supersedes: ["facts/old"])
    .blockWrite("glossary", ContextBlockKind.GLOSSARY, "a single-segment id", tags: ["io"])
}

let sameContext(a: Context!, b: Context!): Boolean! {
  a.blockIndex == b.blockIndex and a.compose == b.compose and
    readBlock(a, "facts/old") == readBlock(b, "facts/old") and
    jsonOf(a).contents == jsonOf(b).contents
}

let testContextExportRoundTrip(source: Workspace!): String! {
  let fixture = contextIoFixture
  let json = jsonOf(fixture)
  let doc: {{version: Int!, blocks: [{{id: String!, status: String, superseded_by: [String!]!, supersedes: [String!]!}}!]!}}! = JSON.decode(json.contents)
  assert { doc.version == 1 and doc.blocks.length == 5 }
  let byId(id: String!): [{{id: String!, status: String, superseded_by: [String!]!, supersedes: [String!]!}}!]! {
    doc.blocks.filter { b => b.id == id }
  }
  assert { byId("facts/old").map { b => b.status } == ["superseded"] }
  assert { byId("facts/old").map { b => b.superseded_by } == [["facts/z"]] }
  assert { byId("decisions/x").map { b => b.supersedes } == [["decisions/pruned"]] }
  assert { byId("decisions/x").map { b => b.superseded_by.isEmpty } == [true] }

  assert { sameContext(importJson(context, json), fixture) }

  let nested = markdownOf(fixture)
  assert { nested.glob("**/*.md").contains("facts/old.md") }
  assert { sameContext(importDir(context, nested), fixture) }

  # Flat files carry their ids in front matter; names are only a fallback.
  let flat = markdownOf(fixture, flat: true)
  assert { flat.entries.contains("facts~old.md") and !flat.entries.contains("facts/") }
  assert { sameContext(importDir(context, flat), fixture) }

  # Renamed files still import by their front-matter id; a file without an
  # id falls back to its name (~ read as /); stray files are skipped.
  let renamed = directory
    .withFile("one.md", flat.file("facts~old.md"))
    .withNewFile("notes~no-id.md", "---\nkind: note\n---\n\nfrom the name\n")
    .withNewFile("README.md", "# not a block\n")
  let loose = importDir(context, renamed)
  assert { readBlock(loose, "facts/old").contains("old") }
  assert { readBlock(loose, "notes/no-id").contains("from the name") }

  # The default path: a committed context/.
  let committed = directory.withChanges(fixture.exportContext(source: scratch))
  assert { sameContext(context.importContext(source: committed.asWorkspace), fixture) }

  # A gist's layout: flat markdown, context.json and index.html side by side.
  let gist = exportedDir(fixture, [ContextExportFormat.MARKDOWN, ContextExportFormat.JSON, ContextExportFormat.HTML], flat: true)
  assert { gist.entries.contains("index.html") and gist.entries.contains("context.json") }
  assert { gist.entries.contains("facts~old.md") }
  assert { gist.entries.all { e => !e.hasSuffix("/") } }
  assert { sameContext(importDir(context, gist), fixture) }
  let bundle = exportedDir(fixture, [ContextExportFormat.JSON, ContextExportFormat.HTML])
  assert { bundle.entries == ["boot.js", "context.css", "context.json", "index.html", "interactions.js", "questions.html", "render.js"] }
  assert { sameContext(importDir(context, bundle), fixture) }
  "Context export/import round-trip checks passed."
}

# Selection narrows what is written; the formats and from: are validated.
let testContextExportSelection(source: Workspace!): String! {
  let fixture = contextIoFixture
  let facts = markdownOf(fixture.blockWrite("notes/n", ContextBlockKind.NOTE, "n"))
  assert { facts.glob("**/*.md").length == 6 }
  let onlyZ = directory.withChanges(fixture.exportContext(source: scratch, ids: ["facts/z"])).glob("**/*.md")
  assert { onlyZ == ["context/facts/z.md"] }
  let tagged = directory.withChanges(fixture.exportContext(source: scratch, tags: ["io"])).glob("**/*.md")
  assert { tagged == ["context/decisions/x.md", "context/facts/current.md", "context/glossary.md"] }
  let glossary = directory.withChanges(fixture.exportContext(source: scratch, kinds: [ContextBlockKind.GLOSSARY])).glob("**/*.md")
  assert { glossary == ["context/glossary.md"] }

  let none = directory.withChanges(fixture.exportContext(source: scratch, tags: ["nope"])).entries rescue { e: Error => [e.message] }
  assert { none.any { m => m.contains("nothing matched the selection") } }
  let noFormat = directory.withChanges(fixture.exportContext(source: scratch, formats: [])).entries rescue { e: Error => [e.message] }
  assert { noFormat.any { m => m.contains("name at least one format") } }
  [ContextExportFormat.HTML, ContextExportFormat.JSON].each { format =>
    let leadOut = directory.withChanges(fixture.exportContext(source: scratch, formats: [format],
      ids: ["facts/z"], lead: ["glossary"])).entries rescue { e: Error => [e.message] }
    assert { leadOut.any { m => m.contains("not in the selection") } }
    let stale = directory.withChanges(fixture.exportContext(source: scratch, formats: [format],
      lead: ["facts/old"])).entries rescue { e: Error => [e.message] }
    assert { stale.any { m => m.contains("it is superseded") } }
    let dropped = directory.withChanges(fixture.blockDrop(["glossary"]).exportContext(source: scratch,
      formats: [format], lead: ["glossary"])).entries rescue { e: Error => [e.message] }
    assert { dropped.any { m => m.contains("it is dropped") } }
  }

  # from: a missing workspace path is an error naming it.
  let missing = context.importContext(source: scratch, from: "nowhere").blockIndex rescue { e: Error => e.message }
  assert { missing.contains("nowhere") }
  "Context export selection checks passed."
}

let testContextImportConflicts(source: Workspace!): String! {
  let json = jsonOf(contextIoFixture)
  let session = context.blockWrite("facts/current", ContextBlockKind.FACT, "session truth")
  let refused = importJson(session, json).blockIndex rescue {
    e: Error => e.message
  }
  assert { refused.contains("already in the Context: facts/current") }
  assert { session.blockIndex.contains("1 block(s)") }
  let kept = importJson(session, json, onConflict: ContextImportConflict.KEEP)
  assert { readBlock(kept, "facts/current").contains("session truth") }
  assert { kept.blockIndex.contains("decisions/x") }
  let replaced = importJson(session, json, onConflict: ContextImportConflict.REPLACE)
  assert { !readBlock(replaced, "facts/current").contains("session truth") }

  # An imported supersedes retires the session's Block it names, even one
  # KEEP holds on to: facts/z supersedes facts/old in the export.
  let stale = context.blockWrite("facts/old", ContextBlockKind.FACT, "session old")
  let merged = importJson(stale, json, onConflict: ContextImportConflict.KEEP)
  assert { readBlock(merged, "facts/old").contains("session old") }
  assert { merged.blockIndex.contains("facts/old  fact  1 line(s)  superseded by facts/z") }
  assert { !merged.compose.contains("session old") }

  # A context.json beside markdown fills in only what the markdown lacks;
  # markdown exported later wins.
  let older = jsonOf(context
    .blockWrite("facts/a", ContextBlockKind.FACT, "a1")
    .blockWrite("facts/c", ContextBlockKind.FACT, "only in json"))
  let mixed = markdownOf(context
    .blockWrite("facts/a", ContextBlockKind.FACT, "a2")
    .blockWrite("facts/b", ContextBlockKind.FACT, "exported later"))
    .withFile("context.json", older)
  let fromMixed = importDir(context, mixed)
  assert { readBlock(fromMixed, "facts/a").contains("a2") }
  assert { readBlock(fromMixed, "facts/b").contains("exported later") }
  assert { readBlock(fromMixed, "facts/c").contains("only in json") }

  let bad = directory.withNewFile("facts/bad.md", "---\nkind: rumor\n---\n\nx\n")
  let rejected = importDir(context, bad).blockIndex rescue {
    e: Error => e.message
  }
  assert { rejected.contains("facts/bad.md") and rejected.contains("unknown kind") }
  "Context import conflict checks passed."
}

let testContextHtml(source: Workspace!): String! {
  let fixture = contextIoFixture
  let html = htmlOf(fixture, title: "Ctx <&>", repo: "vito/agents")
  assert { html.hasPrefix("<!doctype html>") and html.contains("<title>Ctx &lt;&amp;&gt;</title>") }
  assert { html.contains(`id="b-decisions/x"`) and html.contains(`data-kind="decision"`) }
  assert { html.contains(`<a class="chip k-fact" href="#b-facts/current"`) }
  assert { html.contains(`<a class="chip k-fact gone" href="#b-facts/old"`) }
  assert { html.contains(`href="https://github.com/vito/agents/issues/12"`) }
  assert { html.contains(`href="https://github.com/vito/agents/issues/34"`) }
  assert { html.contains(`href="https://example.com/?a=1&amp;b=2"`) }
  assert { html.contains("<b>chose</b>") and html.contains("<li>two\ncontinued</li>") }
  assert { html.contains("<th>a</th>") and html.contains("&lt;script&gt;alert(1)&lt;/script&gt;") }
  assert { !html.contains("<script>alert") }
  assert { html.contains("<pre>code ~~here~~</pre>") }
  assert { html.contains("References → ") and html.contains("Referenced by ← ") }
  assert { html.contains("Superseded by ") and html.contains(`<code>decisions/pruned</code>`) }
  assert { html.contains("📌 pinned") and html.contains("1 superseded") }
  assert { htmlOf(fixture, title: "Ctx <&>", repo: "vito/agents") == html }

  # A Block revived by blockWrite after being superseded is active: no
  # superseded_by in its exports, no "Superseded by" on its card.
  let revived = context
    .blockWrite("facts/y", ContextBlockKind.FACT, "y")
    .blockWrite("facts/x", ContextBlockKind.FACT, "x", supersedes: ["facts/y"])
    .blockWrite("facts/y", ContextBlockKind.FACT, "y again")
  let revivedDoc: {{blocks: [{{id: String!, status: String, superseded_by: [String!]!}}!]!}}! = JSON.decode(jsonOf(revived).contents)
  assert { revivedDoc.blocks.filter { b => b.id == "facts/y" }.map { b => b.superseded_by.isEmpty and b.status == null } == [true] }
  assert { markdownOf(revived).file("facts/y.md").contents.contains("superseded_by: []") }
  assert { !htmlOf(revived).contains("Superseded by") }
  "Context HTML checks passed."
}

# The curated sections: lead Blocks under "At a glance" in the caller's
# order, then every active QUESTION by priority (unprioritized last), each
# priority #blocker first, then pinned.
let testContextHtmlCurated(source: Workspace!): String! {
  let plain = htmlOf(contextIoFixture)
  assert { !plain.contains(`id="glance"`) and !plain.contains(`id="questions"`) }

  # Questions recorded before priorities existed: unprioritized, #blocker
  # still first among them.
  let legacy = directory
    .withNewFile("questions/g-legacy.md", "---\nkind: question\ntags: [blocker]\n---\n\nlegacy blocking question\n")
    .withNewFile("questions/h-legacy.md", "---\nkind: question\n---\n\nlegacy question\n")
  let written = contextIoFixture
    .blockWrite("results/status", ContextBlockKind.RESULT, "| pr | state |\n|---|---|\n| #40 | draft |")
    .blockWrite("questions/a-plain", ContextBlockKind.QUESTION, "plain question", priority: ContextQuestionPriority.P1, summary: "plain?")
    .blockWrite("questions/b-blocks", ContextBlockKind.QUESTION, "blocking question", tags: ["blocker"], priority: p2, summary: "blocking?")
    .blockWrite("questions/c-pinned", ContextBlockKind.QUESTION, "pinned question", pin: true, priority: p2, summary: "pinned?")
    .blockWrite("questions/d-led", ContextBlockKind.QUESTION, "led question", priority: ContextQuestionPriority.P0, summary: "led?")
    .blockWrite("questions/e-old", ContextBlockKind.QUESTION, "old question", priority: ContextQuestionPriority.P3, summary: "old?")
    .blockWrite("questions/f-new", ContextBlockKind.QUESTION, "new question", supersedes: ["questions/e-old"],
      priority: ContextQuestionPriority.P3, summary: "new?")
  let fixture = importDir(written, legacy)
  let html = htmlOf(fixture, lead: ["results/status", "questions/d-led", "glossary"])

  let afterGlance = html.split(`<h2 id="glance">`)[1] ?? ""
  let glance = afterGlance.split(`<h2 id="questions">`)[0] ?? ""
  let afterQuestions = afterGlance.split(`<h2 id="questions">`)[1] ?? ""
  let questions = afterQuestions.split(`<h2 id="overview">`)[0] ?? ""
  assert { glance != "" and questions != "" and afterQuestions.contains(`<h2 id="overview">`) }
  assert { html.contains(`<a href="#glance">At a glance</a><a href="#questions">Open questions</a>`) }

  # Lead keeps the caller's order; featured cards are anchorless copies.
  let ledOrder = glance.split(`<a class="bid" href="#b-`).dropFirst(1).map { s => s.split(`"`)[0] ?? "" }
  assert { ledOrder == ["results/status", "questions/d-led", "glossary"] }
  assert { glance.contains("<th>pr</th>") }
  assert { html.split(`id="b-results/status"`).length == 2 }

  # Questions: by priority, blocker then pinned within one, unprioritized
  # last; led and superseded ones out.
  let asked = questions.split(`<a class="bid" href="#b-`).dropFirst(1).map { s => s.split(`"`)[0] ?? "" }
  assert { asked == ["questions/a-plain", "questions/b-blocks", "questions/c-pinned", "questions/f-new", "questions/g-legacy", "questions/h-legacy"] }
  assert { questions.contains(`<span class="badge">BLOCKER</span>`) and questions.contains("2 blocking") }
  assert { html.split(`<span class="badge">BLOCKER</span>`).length == 5 }
  assert { questions.contains(`<span class="prio p1">P1</span>`) and questions.contains(`<span class="prio pn">unprioritized</span>`) }
  assert { questions.contains(`<a href="questions.html">Answer them in questions.html</a>`) }

  # The Blocks list stays complete: every active Block has its one card.
  assert { html.split(`id="b-questions/d-led"`).length == 2 }

  let unknown = htmlOf(fixture, lead: ["facts/nope"]) rescue { e: Error => e.message }
  assert { unknown.contains(`no block "facts/nope"`) }
  let stale = htmlOf(fixture, lead: ["questions/e-old"]) rescue { e: Error => e.message }
  assert { stale.contains("it is superseded") and stale.contains("questions/f-new") }
  let noHtml = directory.withChanges(fixture.exportContext(source: scratch, lead: ["glossary"])).entries rescue {
    e: Error => [e.message]
  }
  assert { noHtml.any { m => m.contains("add JSON or HTML to formats") } }
  "Context curated HTML checks passed."
}

# Questions get Q-numbers: assigned in order, kept across rewrites and
# supersession, never reused after forget, accepted as ids, exported and
# imported, renumbered only on a clash.
let testContextShortIds(source: Workspace!): String! {
  let ctx = context
    .blockWrite("facts/a", ContextBlockKind.FACT, "not a question")
    .blockWrite("questions/one", ContextBlockKind.QUESTION, "first?", priority: p2, summary: "q")
    .blockWrite("questions/two", ContextBlockKind.QUESTION, "second? see Q-1", priority: p2, summary: "q")
  assert { ctx.blockIndex.contains("questions/one  question  Q-1  P2  3 line(s)") }
  assert { ctx.blockIndex.contains("questions/two  question  Q-2  P2  3 line(s)") }
  assert { ctx.blockIndex.contains("facts/a  fact  1 line(s)") }
  assert { readBlock(ctx, "Q-2").contains("── questions/two · question · Q-2 · P2 ──") }
  assert { ctx.compose(ids: ["Q-1"]).contains("first?") }

  # Rewrites keep the number; forgetting the newest never frees it.
  let rewritten = ctx.blockWrite("questions/one", ContextBlockKind.QUESTION, "first, reworded?", priority: p2, summary: "q")
  assert { rewritten.blockIndex.contains("questions/one  question  Q-1") }
  let pruned = rewritten.blockDrop(["Q-2"], forget: true).blockWrite("questions/three", ContextBlockKind.QUESTION, "third?", priority: p2, summary: "q")
  assert { pruned.blockIndex.contains("questions/three  question  Q-3") }

  # Answering supersedes the question by its number; the number stays.
  let answered = pruned.blockWrite("decisions/one", ContextBlockKind.DECISION, "answered", supersedes: ["Q-1"])
  assert { answered.blockIndex.contains("questions/one  question  Q-1  P2  3 line(s)  superseded by decisions/one") }
  assert { readBlock(answered, "Q-1").contains("superseded by decisions/one") }
  let unknown = readBlock(answered, "Q-9") rescue { e: Error => e.message }
  assert { unknown.contains("no question Q-9") }

  # Exports carry the number; a fresh session keeps it.
  let md = markdownOf(answered).file("questions/three.md").contents
  assert { md.contains("number: 3") }
  assert { markdownOf(answered).file("facts/a.md").contents.contains("number: null") }
  let fresh = importJson(context, jsonOf(answered))
  assert { readBlock(fresh, "Q-3").contains("third?") }
  assert { fresh.blockWrite("questions/four", ContextBlockKind.QUESTION, "fourth?", priority: p2, summary: "q").blockIndex.contains("questions/four  question  Q-4") }

  # A clash with the session's own numbers renumbers the import; a
  # question recorded without a number (an older export) gets one.
  let other = context.blockWrite("questions/mine", ContextBlockKind.QUESTION, "mine?", priority: p2, summary: "q")
  let legacy = directory.withNewFile("questions/old.md", "---\nkind: question\n---\n\nolder export\n")
  let merged = importDir(importJson(other, jsonOf(answered)), legacy)
  assert { readBlock(merged, "Q-1").contains("mine?") }
  assert { merged.blockIndex.contains("questions/one  question  Q-4") }
  assert { merged.blockIndex.contains("questions/three  question  Q-3") }
  assert { merged.blockIndex.contains("questions/old  question  Q-5") }

  # The page labels questions and links Q-numbers in text.
  let html = htmlOf(answered.blockWrite("notes/n", ContextBlockKind.NOTE, "open: Q-3 and `Q-1`"), lead: ["Q-3"])
  assert { html.contains(`<span class="qn">Q-3</span>`) }
  assert { html.contains(`<a class="chip k-question" href="#b-questions/three" title="questions/three">Q-3</a>`) }
  assert { html.contains(`<a class="chip k-question gone" href="#b-questions/one" title="questions/one">Q-1</a>`) }
  assert { html.contains(`<a class="bid" href="#b-questions/three">`) }

  # blockWrite takes an existing question's Q-number as its id.
  let reworded = answered.blockWrite("Q-3", ContextBlockKind.QUESTION, "third, reworded?", priority: p2, summary: "q")
  assert { readBlock(reworded, "questions/three").contains("third, reworded?") }

  # A forgotten number stays retired across a context.json round trip, and
  # within the session that forgot it.
  let forgetting = context
    .blockWrite("questions/x", ContextBlockKind.QUESTION, "x?", priority: p2, summary: "q")
    .blockWrite("questions/y", ContextBlockKind.QUESTION, "y?", priority: p2, summary: "q")
    .blockDrop(["Q-2"], forget: true)
  let reborn = importJson(context, jsonOf(forgetting))
    .blockWrite("questions/z", ContextBlockKind.QUESTION, "z?", priority: p2, summary: "q")
  assert { reborn.blockIndex.contains("questions/z  question  Q-3") }
  let stranger = jsonOf(context.blockWrite("questions/other", ContextBlockKind.QUESTION, "other?", priority: p2, summary: "q")
    .blockWrite("questions/second", ContextBlockKind.QUESTION, "second?", priority: p2, summary: "q"))
  let into = importJson(forgetting, stranger)
  assert { into.blockIndex.contains("questions/other  question  Q-3") }
  assert { into.blockIndex.contains("questions/second  question  Q-4") }

  # Renumbering carries the imported text's citations along.
  let theirs = jsonOf(context
    .blockWrite("notes/m", ContextBlockKind.NOTE, "blocked on Q-1, not Q-7")
    .blockWrite("questions/theirs", ContextBlockKind.QUESTION, "theirs?", priority: p2, summary: "q"))
  let mine = importJson(context.blockWrite("questions/mine", ContextBlockKind.QUESTION, "mine?", priority: p2, summary: "q"), theirs)
  assert { mine.blockIndex.contains("questions/theirs  question  Q-2") }
  assert { readBlock(mine, "notes/m").contains("blocked on Q-2, not Q-7") }
  assert { readBlock(mine, "Q-1").contains("mine?") }

  # ... and a question's own fields along (questions/first is Q-1 there,
  # Q-3 here).
  let deps = jsonOf(context
    .blockWrite("questions/first", ContextBlockKind.QUESTION, "first?", priority: p2, summary: "q")
    .blockWrite("questions/then", ContextBlockKind.QUESTION, "then?", priority: ContextQuestionPriority.P1,
      summary: "after Q-1", blocks: "Q-1", options: ["wait for Q-1"], recommended: "A"))
  let followed = readBlock(importJson(context.blockWrite("questions/mine", ContextBlockKind.QUESTION, "mine?", priority: p2, summary: "q"), deps), "questions/then")
  assert { followed.contains("· blocks: Q-3 ──\nTL;DR: after Q-3\n") and followed.contains("A. wait for Q-3  (recommended)") }

  # KEEP leaves a clashing question out; citations of it follow the
  # session's number for it (questions/theirs is Q-2 in mine, Q-1 there).
  let kept = importJson(mine, jsonOf(context
    .blockWrite("notes/k", ContextBlockKind.NOTE, "about Q-1")
    .blockWrite("questions/theirs", ContextBlockKind.QUESTION, "theirs?", priority: p2, summary: "q")), onConflict: ContextImportConflict.KEEP)
  assert { readBlock(kept, "notes/k").contains("about Q-2") }

  # Re-importing a legacy file with REPLACE keeps the number it got.
  let once = importDir(context, legacy)
  let twice = importDir(once, legacy, onConflict: ContextImportConflict.REPLACE)
  assert { twice.blockIndex == once.blockIndex }
  assert { twice.blockIndex.contains("questions/old  question  Q-1") }
  "Context short id checks passed."
}

# blockDrop drops by default: kept, out of composition, readable by id,
# exported and rendered as dropped, revived by blockWrite. forget deletes.
let testContextDrop(source: Workspace!): String! {
  let ctx = context
    .blockWrite("facts/keep", ContextBlockKind.FACT, "still true")
    .blockWrite("results/served", ContextBlockKind.RESULT, "served its purpose")
    .blockWrite("questions/moot", ContextBlockKind.QUESTION, "moot now? see results/served", tags: ["blocker"], priority: p2, summary: "moot?")
  let dropped = ctx.blockDrop(["results/served", "Q-1"])
  let index = dropped.blockIndex
  assert { index.contains("3 block(s) — 1 active (1 text line(s), 0 pinned), 0 superseded, 2 dropped") }
  assert { index.contains("results/served  result  1 line(s)  dropped") }
  assert { index.contains("questions/moot  question  Q-1  P2  3 line(s)  #blocker  dropped") }
  assert { !dropped.compose.contains("served its purpose") }
  assert { dropped.compose.contains("2 superseded or dropped block(s) held out") }
  let named = readBlock(dropped, "results/served")
  assert { named.contains("served its purpose") and named.contains("(dropped — kept for the record") }
  assert { named.contains("composed 1 of 3 block(s)") }

  # Focused reads add pins only by explicit opt-in.
  let pinned = dropped.blockWrite("facts/pinned", ContextBlockKind.FACT, "always here", pin: true)
  assert { !readBlock(pinned, "results/served").contains("always here") }
  assert { pinned.compose.contains("always here") }
  assert { !pinned.compose(tags: ["nope"]).contains("always here") }
  assert { pinned.compose(tags: ["nope"], includePins: true).contains("always here") }

  # Dropping twice is refused; forget is the explicit way out.
  let again = dropped.blockDrop(["results/served"]).blockIndex rescue { e: Error => e.message }
  assert { again.contains("already dropped") and again.contains("forget: true") }
  let forgotten = dropped.blockDrop(["results/served"], forget: true)
  assert { !forgotten.blockIndex.contains("results/served") }

  # Exports say dropped, and importing them keeps it so.
  assert { markdownOf(dropped).file("results/served.md").contents.contains("status: dropped") }
  assert { importJson(context, jsonOf(dropped)).blockIndex == dropped.blockIndex }
  assert { importDir(context, markdownOf(dropped)).blockIndex == dropped.blockIndex }

  # The page lists them apart, never as open questions or in the matrix.
  let html = htmlOf(dropped)
  assert { html.contains(`<h2 id="dropped">Dropped</h2>`) and html.contains("2 dropped") }
  assert { !html.contains(`<h2 id="questions">`) and !html.contains("BLOCKER</span>") }
  assert { html.contains(`<a class="chip k-result gone" href="#b-results/served"`) }
  assert { html.contains("Dropped: stopped mattering") }
  let led = htmlOf(dropped, lead: ["results/served"]) rescue { e: Error => e.message }
  assert { led.contains("it is dropped") }

  # blockWrite revives; superseding a dropped Block makes it superseded only.
  let revived = dropped.blockWrite("results/served", ContextBlockKind.RESULT, "useful again")
  assert { revived.blockIndex.contains("results/served  result  1 line(s)\n") }
  let replaced = dropped.blockWrite("decisions/settled", ContextBlockKind.DECISION, "answered after all", supersedes: ["Q-1"])
  assert { replaced.blockIndex.contains("questions/moot  question  Q-1  P2  3 line(s)  #blocker  superseded by decisions/settled") }
  assert { replaced.blockIndex.contains("1 superseded, 1 dropped") }

  # A superseded Block whose replacement was dropped says so.
  let chain = context
    .blockWrite("results/r1", ContextBlockKind.RESULT, "first")
    .blockWrite("results/r2", ContextBlockKind.RESULT, "second", supersedes: ["results/r1"])
    .blockDrop(["results/r2"])
  let read = readBlock(chain, "results/r1")
  assert { read.contains("superseded by results/r2 (dropped)") and read.contains("nothing active replaces it now") }

  # Leading with a superseded Block whose replacement was forgotten names
  # no empty pointer.
  let orphan = htmlOf(chain.blockDrop(["results/r2"], forget: true), lead: ["results/r1"]) rescue {
    e: Error => e.message
  }
  assert { orphan.contains(`cannot lead with "results/r1": it is superseded`) and !orphan.contains("()") }
  "Context drop checks passed."
}

# Structured questions: blockWrite's requirements, ordering by priority in
# blockIndex and compose, exact round trips through every format, defaults
# for older exports, and questions.html.
let testContextQuestions(source: Workspace!): String! {
  let failure(ctx: Context!): String! { ctx.blockIndex rescue { e: Error => e.message } }

  # A QUESTION needs a priority and a summary; other kinds take neither,
  # and a recommendation must name an option.
  let bare = failure(context.blockWrite("questions/bare", ContextBlockKind.QUESTION, "bare?"))
  assert { bare.contains(`question "questions/bare" needs a priority (P0, P1, P2 or P3) and a summary`) }
  let unsummarized = failure(context.blockWrite("questions/bare", ContextBlockKind.QUESTION, "bare?", priority: p2, summary: " \n "))
  assert { unsummarized.contains("needs a summary") and !unsummarized.contains("a priority") }
  let onFact = failure(context.blockWrite("facts/f", ContextBlockKind.FACT, "f", priority: p2, options: ["x"]))
  assert { onFact.contains(`priority, options: only a QUESTION takes these, and "facts/f" is a fact`) }
  let stray = failure(context.blockWrite("questions/q", ContextBlockKind.QUESTION, "q", priority: p2, summary: "q",
    options: ["a", "b"], recommended: "C"))
  assert { stray.contains(`recommended "C" names no option of "questions/q": its options are A, B`) }
  let blank = failure(context.blockWrite("questions/q", ContextBlockKind.QUESTION, "q", priority: p2, summary: "q", options: ["a", " "]))
  assert { blank.contains("option B of \"questions/q\" is empty") }

  # Question details are freeform Markdown, without prescribed headings.
  let land = "See facts/a and #12.\n\nEveryone is affected.\n\nBefore beta.25."
  let ctx = context
    .blockWrite("facts/a", ContextBlockKind.FACT, "a fact")
    .blockWrite("questions/later", ContextBlockKind.QUESTION, "whenever", priority: ContextQuestionPriority.P3, summary: "Later?")
    .blockWrite("questions/land", ContextBlockKind.QUESTION, land, priority: ContextQuestionPriority.P0,
      blocks: "the  beta.25\nrelease", summary: " How do we land it? ",
      options: ["Wait for the tag, then restack", "Restack now: see Q-1", "Merge as is"], recommended: "a")
    .blockWrite("questions/mid", ContextBlockKind.QUESTION, "mid", priority: p2, summary: "Mid?", options: ["yes", "no"])

  # Open questions by priority, everywhere; the headline counts them. A
  # question's size counts its summary and options, as compose prints them.
  let index = ctx.blockIndex
  assert { index.contains("; 3 open question(s), 1 P0") }
  assert { index.contains("questions/land  question  Q-2  P0  blocks: the beta.25 release  12 line(s)") }
  assert { index.contains("questions/mid  question  Q-3  P2  7 line(s)") }
  let budgeted = ctx.compose(budget: 4)
  assert { budgeted.contains("composed 2 of 4 block(s), 4 text line(s)") and !budgeted.contains("Options:") }
  let listed = index.split("\n").dropFirst(1).map { l => l.trimSpace.split("  ")[0] ?? "" }
  assert { listed == ["facts/a", "questions/land", "questions/mid", "questions/later"] }
  let composed = ctx.compose
  assert { composed.contains("── questions/land · question · Q-2 · P0 · blocks: the beta.25 release ──\nTL;DR: How do we land it?\n\nSee facts/a and #12.") }
  assert { composed.contains("Before beta.25.\n\nOptions:\n  A. Wait for the tag, then restack  (recommended)\n  B. Restack now: see Q-1\n  C. Merge as is") }
  let afterLand = composed.split("── questions/land ")[1] ?? ""
  assert { afterLand.contains("── questions/mid ") and (afterLand.split("── questions/mid ")[1] ?? "").contains("── questions/later ") }

  # Every format carries the fields, exactly; markdown only on questions.
  let answered = ctx.blockWrite("decisions/later", ContextBlockKind.DECISION, "Later, then.", supersedes: ["Q-1"])
  assert { answered.blockIndex.contains("questions/later  question  Q-1  P3  3 line(s)  superseded by decisions/later") }
  let same(a: Context!, b: Context!): Boolean! {
    a.blockIndex == b.blockIndex and a.compose == b.compose and readBlock(a, "Q-1") == readBlock(b, "Q-1") and
      jsonOf(a).contents == jsonOf(b).contents
  }
  assert { same(importJson(context, jsonOf(answered)), answered) }
  assert { same(importDir(context, markdownOf(answered)), answered) }
  assert { same(importDir(context, markdownOf(answered, flat: true)), answered) }
  let md = markdownOf(answered).file("questions/land.md").contents
  let front = md.trimPrefix("---\n").split("\n---\n\n", limit: 2)[0] ?? ""
  let meta: {{priority: String, blocks: String!, summary: String!, options: [{{key: String!, text: String!, recommended: Boolean!}}!]!}}! = YAML.decode(front)
  assert { meta.priority == "P0" and meta.blocks == "the beta.25 release" and meta.summary == "How do we land it?" }
  assert { meta.options == [
    {{key: "A", text: "Wait for the tag, then restack", recommended: true}},
    {{key: "B", text: "Restack now: see Q-1", recommended: false}},
    {{key: "C", text: "Merge as is", recommended: false}},
  ] }
  assert { !markdownOf(answered).file("facts/a.md").contents.contains("priority") }
  let doc: {{blocks: [{{id: String!, priority: String, options: [{{key: String!}}!]!}}!]!}}! = JSON.decode(jsonOf(answered).contents)
  assert { doc.blocks.filter { b => b.id == "questions/mid" }.map { b => [b.priority ?? ""] + b.options.map { o => o.key } } == [["P2", "A", "B"]] }
  assert { doc.blocks.filter { b => b.id == "facts/a" }.map { b => b.priority == null and b.options.isEmpty } == [true] }

  # Older exports: questions without the fields load unprioritized, listed
  # last; a rewrite must add them. Malformed fields import nothing.
  let legacy = directory
    .withNewFile("questions/old.md", "---\nkind: question\n---\n\nolder export\n")
    .withNewFile("context.json", `{"version": 1, "blocks": [{"id": "questions/older", "kind": "question", "text": "from json"}]}`)
  let loaded = importDir(ctx, legacy)
  assert { loaded.blockIndex.contains("; 5 open question(s), 1 P0, 2 unprioritized") }
  assert { loaded.blockIndex.contains("unprioritized  1 line(s)") }
  let asked = loaded.blockIndex.split("\n").map { l => l.trimSpace.split("  ")[0] ?? "" }.filter { id => id.hasPrefix("questions/") }
  assert { asked == ["questions/land", "questions/mid", "questions/later", "questions/old", "questions/older"] }
  assert { same(importJson(context, jsonOf(loaded)), loaded) }
  assert { failure(loaded.blockWrite("questions/old", ContextBlockKind.QUESTION, "reworded")).contains("needs a priority") }
  let onFactFile = failure(importDir(context, directory.withNewFile("facts/x.md", "---\nkind: fact\npriority: P1\n---\n\nx\n")))
  assert { onFactFile.contains("belong to a question") }
  let badPriority = failure(importDir(context, directory.withNewFile("questions/x.md", "---\nkind: question\npriority: P9\n---\n\nx\n")))
  assert { badPriority.contains(`unknown priority "P9"`) }

  # index.html badges questions and links to questions.html.
  let html = htmlOf(answered)
  assert { html.contains(`<a href="questions.html">Answer questions ↗</a>`) and html.contains(`<a href="questions.html">Answer them in questions.html</a>`) }
  assert { html.contains(`<span class="prio p0">P0</span>`) and html.contains(`<span class="holds">blocks: the beta.25 release</span>`) }
  assert { html.contains(`<p class="tldr">How do we land it?</p>`) }
  assert { html.contains(`<li><b>A.</b> Wait for the tag, then restack<span class="rec">RECOMMENDED</span></li>`) }

  # questions.html: open questions by priority, written beside index.html
  # (flat too), self-contained and deterministic.
  assert { exportedDir(answered, [ContextExportFormat.HTML], flat: true).entries == ["boot.js", "context.css", "context.json", "index.html", "interactions.js", "questions.html", "render.js"] }
  let page = questionsOf(answered, repo: "vito/agents")
  assert { page.hasPrefix("<!doctype html>") and !page.contains("<link") and !page.contains(" src=") }
  assert { questionsOf(answered, repo: "vito/agents") == page }
  let cards = page.split(`<section class="blk k-question q" id="q-`).dropFirst(1).map { s => s.split(`"`)[0] ?? "" }
  assert { cards == ["questions/land", "questions/mid"] }
  assert { page.contains(`data-id="questions/land" data-q="Q-2"`) and page.contains(`<span class="prio p0">P0</span>`) }
  assert { page.contains(`<p class="tldr">How do we land it?</p><details><summary>More details</summary>`) }
  assert { page.contains("<p>Everyone is affected.</p>") and page.contains("<p>Before beta.25.</p>") }
  assert { questionsOf(loaded).contains("<details open><summary>More details</summary><p>older export</p>") }
  assert { page.contains(`<input type="radio" name="q-questions/land" value="A" data-text="Wait for the tag, then restack">`) }
  assert { page.split(`<span class="rec">RECOMMENDED</span>`).length == 2 }
  assert { page.contains(`<a class="chip k-fact" href="index.html#b-facts/a"`) }
  assert { page.contains(`href="index.html#b-questions/later" title="questions/later">Q-1</a>`) }
  assert { page.contains(`href="https://github.com/vito/agents/issues/12"`) }
  assert { page.contains("writing the DECISION that settles it") and page.contains("localStorage") }
  assert { questionsOf(context.blockWrite("facts/a", ContextBlockKind.FACT, "a")).contains("No open questions.") }
  # A question only an earlier context.json at the path holds stays on
  # index.html, but is not offered for answering: the session lacks it.
  let elsewhere = directory.withFile("out/context.json",
    jsonOf(ctx.blockWrite("questions/foreign", ContextBlockKind.QUESTION, "foreign?", priority: p2, summary: "f")))
  let mixed = elsewhere.withChanges(answered.exportContext(source: elsewhere.asWorkspace, path: "out", formats: [ContextExportFormat.HTML], offlineHtml: true))
  assert { mixed.file("out/index.html").contents.contains(`id="b-questions/foreign"`) }
  assert { !mixed.file("out/questions.html").contents.contains(`id="q-questions/foreign"`) }
  "Context question checks passed."
}

# Retrieval budgets count complete rendered Blocks, not merely payloads.
let composedBody(doc: String!): String! {
  doc.split("\n\n", limit: 2)[1] ?? ""
}

let testContextRetrieval: String! {
  let ctx = context
    .blockWrite("facts/pin", ContextBlockKind.FACT, "orientation payload", tags: ["global"], pin: true)
    .blockWrite("notes/task", ContextBlockKind.NOTE, "task payload", tags: ["task"])
    .blockWrite("notes/old", ContextBlockKind.NOTE, "old payload", pin: true)
    .blockWrite("notes/new", ContextBlockKind.NOTE, "new payload", supersedes: ["notes/old"])
    .blockWrite("notes/dropped", ContextBlockKind.NOTE, "dropped payload", pin: true)
    .blockDrop(["notes/dropped"])
  [ctx.compose(tags: ["task"]), ctx.compose(kinds: [ContextBlockKind.NOTE]),
    ctx.compose(ids: ["notes/task"])].each { doc =>
    assert { doc.contains("task payload") and !doc.contains("orientation payload") }
    assert { !doc.contains("old payload") and !doc.contains("dropped payload") }
  }
  [ctx.compose(tags: ["task"], includePins: true),
    ctx.compose(kinds: [ContextBlockKind.NOTE], includePins: true),
    ctx.compose(ids: ["notes/task"], includePins: true), ctx.compose].each { doc =>
    assert { doc.contains("task payload") and doc.contains("orientation payload") }
    assert { !doc.contains("old payload") and !doc.contains("dropped payload") }
  }
  assert { ctx.compose(ids: ["notes/old", "notes/dropped"]).contains("old payload") }
  assert { ctx.compose(ids: ["notes/old", "notes/dropped"]).contains("dropped payload") }
  assert { ctx.compose(ids: ["facts/pin"], tags: ["task"]).contains("orientation payload") }

  let huge = "LONG-SINGLE-LINE".padRight(13000)
  let large = context.blockWrite("facts/huge", ContextBlockKind.FACT, huge, pin: true)
    .blockWrite("notes/small", ContextBlockKind.NOTE, "small payload")
  let limited = large.compose
  assert { !limited.contains(huge) and limited.contains("small payload") }
  assert { limited.contains("facts/huge") and limited.contains("exceeds character budget") }
  assert { large.compose(ids: ["facts/huge"]).contains("composed 0 of 2") }
  assert { large.compose(ids: ["facts/huge"], maxChars: 0).contains(huge) }
  assert { large.compose(maxChars: 0, budget: 1).contains(huge) }
  assert { !large.compose(maxChars: 0, budget: 1).contains("small payload") }

  let lines = context.blockWrite("facts/lines", ContextBlockKind.FACT, "first\nsecond", pin: true)
    .blockWrite("notes/small", ContextBlockKind.NOTE, "small payload")
  let lineLimited = lines.compose(budget: 1)
  assert { !lineLimited.contains("first\nsecond") and lineLimited.contains("exceeds line budget") }
  assert { lineLimited.contains("small payload") }
  assert { lines.compose(budget: 1, maxChars: 1).contains("exceeds line budget and character budget") }

  # Exact admission boundaries include headers, unicode, question fields,
  # status notes and inter-block separators. The manifest is excluded.
  let question = context.blockWrite("questions/q", ContextBlockKind.QUESTION, "é🙂 payload", pin: true,
    tags: ["tag"], priority: p2, summary: "Summary", blocks: "release", options: ["yes", "no"], recommended: "A")
  let full = question.compose(maxChars: 0)
  let cost = composedBody(full).length
  assert { question.compose(maxChars: cost) == full }
  assert { !question.compose(maxChars: cost - 1).contains("é🙂 payload") }
  assert { question.compose(maxChars: cost).length > cost }
  assert { question.blockIndex.contains(`active pin rendered cost: ${toString(cost)} character(s)`) }
  let dropped = question.blockDrop(["Q-1"])
  let history = dropped.compose(ids: ["Q-1"], maxChars: 0)
  let historyCost = composedBody(history).length
  assert { dropped.compose(ids: ["Q-1"], maxChars: historyCost) == history }
  assert { !dropped.compose(ids: ["Q-1"], maxChars: historyCost - 1).contains("é🙂 payload") }
  let pair = question.blockWrite("notes/second", ContextBlockKind.NOTE, "second payload")
  let pairFull = pair.compose(maxChars: 0)
  let pairCost = composedBody(pairFull).length
  assert { pair.compose(maxChars: pairCost) == pairFull }
  assert { !pair.compose(maxChars: pairCost - 1).contains("second payload") }
  [context, question].each { state =>
    assert { (state.compose(maxChars: -1) rescue { e: Error => e.message }).contains("nonnegative") }
    assert { (state.compose(budget: -1) rescue { e: Error => e.message }).contains("nonnegative") }
    assert { (state.compose(ids: ["missing"]) rescue { e: Error => e.message }).contains("no block") }
  }
  assert { large.blockIndex.contains("warning: active pins exceed") and large.blockIndex.contains("blockPin") }
  assert { !large.blockPin(["facts/huge"], false).blockIndex.contains("warning:") }
  assert { !large.blockDrop(["facts/huge"]).blockIndex.contains("warning:") }
  "Context focused retrieval checks passed."
}

let testContextOrient: String! {
  assert { context.orient.contains("0 of 0 active pin(s)") }
  assert { context.orient.length <= 12000 }
  let ctx = context
    .blockWrite("facts/huge", ContextBlockKind.FACT, "HUGE".padRight(13000), pin: true)
    .blockWrite("facts/small", ContextBlockKind.FACT, "small orientation", pin: true)
    .blockWrite("notes/unpinned", ContextBlockKind.NOTE, "not orientation")
    .blockWrite("notes/old", ContextBlockKind.NOTE, "old orientation", pin: true)
    .blockWrite("notes/new", ContextBlockKind.NOTE, "new unpinned", supersedes: ["notes/old"])
    .blockWrite("notes/dropped", ContextBlockKind.NOTE, "dropped orientation", pin: true)
    .blockDrop(["notes/dropped"])
  let doc = ctx.orient
  assert { doc.length <= 12000 and doc.contains("1 of 2 active pin(s); 1 omitted") }
  assert { doc.contains("small orientation") and !doc.contains("HUGE") }
  assert { !doc.contains("not orientation") and !doc.contains("old orientation") and !doc.contains("dropped orientation") }
  assert { doc.contains("blockIndex") and doc.contains("maxChars: 0") }
  assert { ctx.orient(maxChars: 14000).contains("HUGE") }
  assert { ctx.orient(maxChars: 14000).length <= 14000 }

  # Entire-output boundaries: metadata can push a body that fits over budget.
  let pin = context.blockWrite("facts/pin", ContextBlockKind.FACT, "WHOLE".padRight(300), pin: true)
  let full = pin.orient
  let cost = full.length
  assert { pin.orient(maxChars: cost) == full }
  let short = pin.orient(maxChars: cost - 1)
  assert { short.length <= cost - 1 and short.contains("1 omitted") and !short.contains("WHOLE") }
  let bodyCost = composedBody(pin.compose(maxChars: 0)).length
  assert { !pin.orient(maxChars: bodyCost).contains("WHOLE") }

  # Many individually oversized pins, with huge metadata as well as bodies:
  # no per-omission ids or index lines can escape the total-output budget.
  let records = "".padRight(100).split("").map { _, i =>
    {{id: `facts/pin-${toString(i)}`, kind: "fact", text: "PAYLOAD".padRight(1500),
      tags: ["metadata".padRight(1500).replace(" ", "x")], pin: true}}
  }
  let many = importDir(context, directory.withNewFile("context.json", JSON.encode({{version: 1, blocks: records}})))
  [256, 500, 12000].each { ceiling =>
    let result = many.orient(maxChars: ceiling)
    assert { result.length <= ceiling and result.contains("omitted") }
    assert { !result.contains("facts/pin-99") }
  }
  let tiny = many.orient(maxChars: 256)
  assert { tiny.contains("0 of 100 active pin(s); 100 omitted") and !tiny.contains("PAYLOAD") }
  # Metadata alone must fit, even when the payload itself is tiny.
  let metadata = context.blockWrite("notes/meta", ContextBlockKind.NOTE, "BODY", tags: ["tag".padRight(13000).replace(" ", "x")], pin: true)
  assert { metadata.orient.length <= 12000 and !metadata.orient.contains("BODY") }
  [context, pin].each { state =>
    [-1, 0, 1, 255].each { ceiling =>
      assert { (state.orient(maxChars: ceiling) rescue { e: Error => e.message }).contains("at least 256") }
    }
    assert { state.orient(maxChars: 256).length <= 256 }
  }
  "Context bounded orientation checks passed."
}

let testContextPin: String! {
  let ctx = context
    .blockWrite("facts/prior", ContextBlockKind.FACT, "old fact", tags: ["history"], pin: true)
    .blockWrite("questions/q", ContextBlockKind.QUESTION, "details\nQ-1", tags: ["blocker", "history"],
      pin: true, supersedes: ["facts/prior"], priority: p2, blocks: "release", summary: "Question?",
      options: ["yes", "no"], recommended: "B")
    .blockWrite("notes/drop", ContextBlockKind.NOTE, "dropped text", pin: true)
    .blockDrop(["notes/drop"])
  let ids = ["facts/prior", "Q-1", "notes/drop"]
  let off = ctx.blockPin(ids + ["questions/q"], false)
  # Exact exported JSON equality after changing only true pin fields proves
  # text, links, status, question fields and high-water mark all survive.
  assert { jsonOf(off).contents == jsonOf(ctx).contents.rewriteMatches(`"pin"\s*:\s*true`) { m => m.string.replace("true", "false") } }
  assert { off.blockPin(ids, true).blockIndex == ctx.blockIndex }
  assert { jsonOf(off.blockPin(ids, true)).contents == jsonOf(ctx).contents }
  assert { jsonOf(off.blockPin(ids, false)).contents == jsonOf(off).contents }
  assert { off.compose(ids: ["Q-1"]).contains("details\nQ-1") }
  assert { off.orient.contains("0 of 0 active pin(s)") }
  assert { off.blockIndex.contains("1 superseded, 1 dropped") }
  assert { off.blockPin(ids, true).orient.contains("1 of 1 active pin(s)") }
  assert { off.blockWrite("questions/next", ContextBlockKind.QUESTION, "next?", priority: p2, summary: "Next?").blockIndex.contains("Q-2") }
  # Toggling historical questions must not revive them or strip options,
  # priority, summary, blockers, Q-number or supersession links.
  [ctx.blockDrop(["Q-1"]),
    ctx.blockWrite("decisions/answer", ContextBlockKind.DECISION, "answered", supersedes: ["Q-1"])].each { historical =>
    let curated = historical.blockPin(ids, false)
    assert { jsonOf(curated).contents == jsonOf(historical).contents.rewriteMatches(`"pin"\s*:\s*true`) { m => m.string.replace("true", "false") } }
    assert { jsonOf(curated.blockPin(ids, true)).contents == jsonOf(historical).contents }
    assert { curated.blockPin(ids, true).orient.contains("0 of 0 active pin(s)") }
  }
  let before = jsonOf(ctx).contents
  assert { (ctx.blockPin([], false).blockIndex rescue { e: Error => e.message }).contains("at least one") }
  assert { (ctx.blockPin(["Q-1", "missing"], false).blockIndex rescue { e: Error => e.message }).contains("no block") }
  assert { (ctx.blockPin(["Q-1", "Q-99"], false).blockIndex rescue { e: Error => e.message }).contains("no question Q-99") }
  assert { jsonOf(ctx).contents == before }
  "Context metadata-only pin checks passed."
}

# The agent sees eight tools: curate, query, move.
let testContextTools: String! {
  let tools = context.agent(llm).tools
  ["blockWrite", "blockPin", "blockDrop", "blockIndex", "orient", "compose", "exportContext", "importContext"].each { t =>
    assert(message: t) { tools.contains(t) }
  }
  ["blockRead", "blockPrune", "promote", "importBlocks", "exportJson", "exportMarkdown", "exportHtml", "exportGist"].each { t =>
    assert(message: t) { !tools.contains(t) }
  }
  "Context tool visibility checks passed."
}
