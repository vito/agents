let testBrowserWorkspace(ws: Workspace!): Void {
  # Private workspace forks: the check never returns workspace changes.
  let root = "/browser-check-" + Random.string
  let testScript = """
    await check('starts blank', async () => assert.equal(page.url(), 'about:blank'));
    await page.goto(baseURL);
    await check('pending title', async () => await expect(page).toHaveTitle('pending-first'));
    await screenshot('named');
  """
  let first = ws.withNewFile(root + "/index.html", "<title>pending-first</title>")
    .withNewFile(root + "/test.cjs", testScript)
  let a = browserSnapshot(browser.run(first, root: root, scriptPath: root + "/test.cjs"))
  let aID = browserObservation(a, browser)
  let firstReport = a.artifact(aID, "results.json").contents
  assert { firstReport.contains("\"ok\": true") }
  assert { firstReport.contains(first.directory(root).digest) }
  assert { a.artifacts(aID).contains("trace.zip") }
  assert { a.artifact(aID, "screenshot.png").size > 0 }
  assert { a.readArtifact(aID, offset: 1, limit: 2).split("\n").length == 2 }

  # Inspect queued media without calling a model. The continuation keeps the
  # caller's history/tools and adds a caption and real image bytes in order.
  let beforeView = llm.withTools(browser).withPrompt("preserve this history")
  let viewed = a.viewScreenshot(beforeView, aID)
  let messages = viewed.messages.{{role, content.{{kind, text, mimeType, data}}}}
  assert { messages.length == 2 }
  assert { messages[0].content[0].text == "preserve this history" }
  assert { messages[1].role == LLMMessageRole.USER }
  assert { messages[1].content.length == 2 }
  assert { messages[1].content[0].kind == LLMContentBlockKind.TEXT }
  assert { messages[1].content[0].text.contains(aID) }
  assert { messages[1].content[0].text.contains("screenshot.png") }
  let image = messages[1].content[1]
  assert { image.kind == LLMContentBlockKind.IMAGE }
  assert { image.mimeType == "image/png" }
  assert { image.data.hasPrefix("iVBOR") }
  assert { !viewed.transcript.contains(image.data ?? "") }
  assert { viewed.tools == beforeView.tools }
  let named = a.viewScreenshot(beforeView, aID, "named.png")
  assert { named.messages.{{content.{{kind}}}}[1].content[1].kind == LLMContentBlockKind.IMAGE }
  assert { a.artifact(aID, "results.json").contents == firstReport }
  ["../screenshot.png", "/screenshot.png", ""].each { invalid =>
    let rejected = a.viewScreenshot(beforeView, aID, invalid).transcript rescue { e: Error => e.message }
    assert { rejected.contains("artifact path must be relative") }
  }
  let unknown = a.viewScreenshot(beforeView, "missing-run").transcript rescue { e: Error => e.message }
  assert { unknown.contains("unknown run") }
  let notImage = a.viewScreenshot(beforeView, aID, "results.json").transcript rescue { e: Error => "rejected non-image" }
  assert { notImage == "rejected non-image" }

  # Captures default to the viewport; full-page captures of long pages are
  # refused whole rather than scaled illegibly, and viewable by region.
  let tallScript = """
    await page.setContent('<div style="height:20000px">tall</div>');
    await screenshot('tall', {fullPage: true});
  """
  let t = browserSnapshot(browser.run(ws, url: "about:blank", script: tallScript))
  let tID = browserObservation(t, browser)
  let viewportCaption = t.viewScreenshot(beforeView, tID).messages.{{content.{{text}}}}[1].content[0].text ?? ""
  assert { viewportCaption.contains("1280x720 image") }
  let refused = t.viewScreenshot(beforeView, tID, "tall.png").transcript rescue { e: Error => e.message }
  assert { refused.contains("too small to read") }
  let bandCaption = t.viewScreenshot(beforeView, tID, "tall.png", y: 1000, height: 2000).messages.{{content.{{text}}}}[1].content[0].text ?? ""
  assert { bandCaption.contains("1280x2000 region at 0,1000") }

  let second = first.withNewFile(root + "/index.html", "<title>pending-second</title>")
  let b = browserSnapshot(a.run(second, root: root, script: testScript, timeoutMs: 1500))
  let bID = browserObservation(b, a)
  let secondReport = b.artifact(bID, "results.json").contents
  assert { secondReport.contains("\"ok\": false") }
  assert { secondReport.contains(second.directory(root).digest) }
  assert { first.directory(root).digest != second.directory(root).digest }
  assert { b.artifact(aID, "results.json").contents == firstReport }

  let service = container.from("node:22-bookworm-slim")
    .withDefaultArgs(["node", "-e", "require('http').createServer((q,r)=>r.end('<title>service</title>')).listen(8080,'0.0.0.0')"])
    .withExposedPort(8080).asService
  let c = browserSnapshot(browser.run(ws, url: "http://app:8080", service: service, script: "await page.goto(baseURL); await check('bound service', async () => await expect(page).toHaveTitle('service'));"))
  let cID = browserObservation(c, browser)
  assert { c.artifact(cID, "results.json").contents.contains("\"ok\": true") }
  null
}

# readPage against a bound service: reader-view extraction, paging, plain text,
# script-built pages falling back to Chromium, and HTTP errors. No model calls.
let testBrowserReadPage: Void {
  let server = """
    const paragraphs = Array.from({length: 40}, (_, i) => '<p>Paragraph ' + i + ' of the durable article, long enough to look like prose to Readability.</p>').join('');
    const pages = {
      '/post': '<html><head><title>Durable Post</title></head><body><nav>MENU HOME ABOUT</nav><article><h1>Durable Post</h1><h2 id="why">Why<a href="#why"></a></h2>' + paragraphs + '<pre><code>npm install durable</code></pre></article><footer>FOOTER LINKS</footer></body></html>',
      '/spa': '<html><head><title>App</title></head><body><div id="root"></div><script>document.getElementById("root").innerHTML = "<article><h1>Rendered</h1>" + "<p>Script-built content that only exists after JavaScript runs in a browser.</p>".repeat(20) + "</article>";</script></body></html>',
    };
    require('http').createServer((q, r) => {
      if (q.url === '/notes.txt') { r.setHeader('Content-Type', 'text/plain'); return r.end('plain notes'); }
      if (q.url === '/old') { r.writeHead(301, {Location: '/post'}); return r.end(); }
      const body = pages[q.url];
      if (!body) { r.writeHead(404, {'Content-Type': 'text/html'}); return r.end('<title>Missing</title><p>gone</p>'); }
      r.setHeader('Content-Type', 'text/html; charset=utf-8'); r.end(body);
    }).listen(8080, '0.0.0.0');
  """
  let service = container.from("node:22-bookworm-slim")
    .withDefaultArgs(["node", "-e", server])
    .withExposedPort(8080).asService

  let a = browserSnapshot(browser.readPage("http://app:8080/old", service: service, limit: 1000))
  let aID = browserObservation(a, browser)
  let view = a.artifact(aID, "view.md").contents
  assert { view.contains("Title: Durable Post") }
  assert { view.contains("redirected from http://app:8080/old") }
  assert { view.contains("Readability") }
  assert { view.contains("untrusted") }
  assert { view.contains("Continue with readPage(url, offset: ") }
  let content = a.artifact(aID, "content.md").contents
  assert { content.contains("Paragraph 39") }
  assert { content.contains("npm install durable") }
  assert { !content.contains("MENU HOME") }
  assert { !content.contains("[](#why)") }

  let tail = browserSnapshot(a.readPage("http://app:8080/post", service: service, offset: content.length - 50))
  assert { tail.artifact(browserObservation(tail, a), "view.md").contents.contains("Showing characters") }

  let text = browserSnapshot(browser.readPage("http://app:8080/notes.txt", service: service))
  assert { text.artifact(browserObservation(text, browser), "view.md").contents.contains("plain notes") }

  let spa = browserSnapshot(browser.readPage("http://app:8080/spa", service: service))
  let spaView = spa.artifact(browserObservation(spa, browser), "view.md").contents
  assert { spaView.contains("rendered in Chromium") }
  assert { spaView.contains("Script-built content") }

  let missing = browser.readPage("http://app:8080/nope", service: service).observations rescue { e: Error => [e.message] }
  assert { (missing[0] ?? "").contains("HTTP 404") }
  let misuse = browser.readPage("http://app:8080/post", prompt: "why?").observations rescue { e: Error => [e.message] }
  assert { (misuse[0] ?? "").contains("summarize: true") }
  null
}

let testBrowserBrowsers: Void {
  browser.prepared.withExec(["node", "-e", """
    (async () => {
      for (const name of ['chromium', 'firefox', 'webkit']) {
        const browser = await require('@playwright/test')[name].launch();
        const page = await browser.newPage();
        await page.setContent('<title>ready</title>');
        require('node:assert/strict').equal(await page.title(), 'ready');
        console.log(name + ': ' + browser.version());
        await browser.close();
      }
    })().catch(error => { console.error(error); process.exit(1); });
  """]).sync
  null
}

let testBrowserTools: Void {
  let tools = browser.agent(llm).tools
  assert { ["prepared", "checkRunner", "checkTools", "checkWorkspace", "checkBrowsers", "checkSessionRunner", "checkSessions"].all { tool => !tools.contains(tool) } }
  assert { ["start", "exec", "inspect", "syncWorkspace", "sessions", "stop", "viewScreenshot", "observations", "readPage", "mountArtifacts", "unmountArtifacts"].all { tool => tools.contains(tool) } }
  null
}

let browserPendingPaths(ws: Workspace!): [String!]! {
  ws.git.uncommitted.diffStats.{{path}}.map { s => s.path }
}

let browserMountMissing(ws: Workspace!, path: String!): Boolean! {
  ws.file(path).size rescue { e: Error => return true }
  false
}

# mountArtifacts mounts retained evidence read-only into a workspace: readable
# at the expected path with the run's bytes, visible to the contributor's gh
# toolbox (unlike mnt/), absent from the pending changeset, and removable.
let testBrowserArtifactMounts: Void {
  let ws = container
    .from("alpine:3.22")
    .withExec(["apk", "add", "--no-cache", "git"])
    .withWorkdir("/repo")
    .withExec(["sh", "-eu", "-c", "git init -b main; git -c user.name=Test -c user.email=test@example.com commit --allow-empty -m base"])
    .directory("/repo")
    .asGit
    .head
    .asWorkspace
    .withNewFile("tmp/body.md", "draft\n")
  let pending = browserPendingPaths(ws)
  assert { pending.contains("tmp/body.md") }
  # Serve the page from a private fork; mounts go into ws, whose pending
  # changeset is the baseline.
  let site = ws.withNewFile("site/index.html", "<title>attach</title><h1>evidence</h1>")
  let state = browserSnapshot(browser.run(site, root: "site", script: """
    await page.goto(baseURL);
    await screenshot('named');
  """))
  let id = browserObservation(state, browser)
  let shot = state.artifact(id, "screenshot.png").digest(excludeMetadata: true)
  let named = state.artifact(id, "named.png").digest(excludeMetadata: true)
  let dir = "tmp/browser/" + id

  # The whole run, at the default location.
  let mounted = state.mountArtifacts(ws, id)
  assert { mounted.file(dir + "/screenshot.png").digest(excludeMetadata: true) == shot }
  assert { mounted.file(dir + "/named.png").digest(excludeMetadata: true) == named }
  assert { mounted.file(dir + "/results.json").contents == state.artifact(id, "results.json").contents }
  assert { mounted.file("tmp/body.md").contents == "draft\n" }
  assert { browserPendingPaths(mounted) == pending }
  assert { mounted.changes.diffStats.{{path}}.map { s => s.path } == ws.changes.diffStats.{{path}}.map { s => s.path } }

  # gh reads -F files before making a request; the final missing file keeps
  # this offline. A mounted artifact must not be the file it fails to open.
  let gh = contributor(githubToken: setSecret("browser-mount-test-token", "not-a-real-token")).gh(
    source: mounted,
    args: ["api", "graphql", "-F", "shot=@" + dir + "/screenshot.png", "-F", "guard=@always-missing"],
  ) rescue {
    e: Error => e.message
  }
  assert(message: gh) { gh.contains("open always-missing: no such file or directory") }
  assert(message: gh) { !gh.contains("open " + dir) }

  let unmounted = state.unmountArtifacts(mounted, run: id)
  assert { browserMountMissing(unmounted, dir + "/screenshot.png") }
  assert { unmounted.file("tmp/body.md").contents == "draft\n" }
  assert { browserPendingPaths(unmounted) == pending }

  # One artifact, at the default location and at a chosen one.
  let one = state.mountArtifacts(ws, id, path: "named.png")
  assert { one.file(dir + "/named.png").digest(excludeMetadata: true) == named }
  assert { browserMountMissing(one, dir + "/screenshot.png") }
  assert { browserPendingPaths(one) == pending }
  assert { browserMountMissing(state.unmountArtifacts(one, run: id), dir + "/named.png") }
  let custom = state.mountArtifacts(ws, id, path: "screenshot.png", at: "docs/evidence.png")
  assert { custom.file("docs/evidence.png").digest(excludeMetadata: true) == shot }
  assert { browserMountMissing(state.unmountArtifacts(custom, at: "docs/evidence.png"), "docs/evidence.png") }
  let customDir = state.mountArtifacts(ws, id, at: "evidence/")
  assert { customDir.file("evidence/named.png").digest(excludeMetadata: true) == named }
  assert { browserMountMissing(state.unmountArtifacts(customDir, at: "evidence"), "evidence/named.png") }

  # Validation, before anything is mounted.
  ["../x", "/abs", "a/../../b", "."].each { invalid =>
    let rejected = state.mountArtifacts(ws, id, at: invalid).file("tmp/body.md").contents rescue { e: Error => e.message }
    assert(message: rejected) { rejected.contains("relative workspace path") }
  }
  let badPath = state.mountArtifacts(ws, id, path: "../screenshot.png").file("tmp/body.md").contents rescue { e: Error => e.message }
  assert(message: badPath) { badPath.contains("artifact path must be relative") }
  let absent = state.mountArtifacts(ws, id, path: "absent.png").file("tmp/body.md").contents rescue { e: Error => e.message }
  assert(message: absent) { absent.contains("no artifact absent.png") }
  let unknown = state.mountArtifacts(ws, "missing-run").file("tmp/body.md").contents rescue { e: Error => e.message }
  assert(message: unknown) { unknown.contains("unknown run") }
  let neither = state.unmountArtifacts(ws).file("tmp/body.md").contents rescue { e: Error => e.message }
  assert(message: neither) { neither.contains("exactly one of run or at") }
  null
}
