# Reviewer checks without model calls. tallyReplies runs everything `review`
# does after its sub-agents reply (evidence checks, voting, severity,
# reconciliation, the summary) on canned replies; composition and the tool
# surface are inspected directly. The recorded-turn pipeline check, which
# does spawn sub-agents, runs through agents-dev/reviewer-driver.

# A git fixture: `main`, `feature` (adds discount() on top of calc.py, which
# keeps a pre-existing eval far from the change, plus a file REVIEW.md
# skips), and `shifted` (feature plus three lines at the top of calc.py, so
# every line below moves).
let reviewerFixture: {{main: GitRef!, feature: GitRef!, shifted: GitRef!}}! {
  let repo = container
    .from("alpine:3.22")
    .withExec(["apk", "add", "--no-cache", "git"])
    .withWorkdir("/repo")
    .withExec(["sh", "-eu", "-c", reviewerFixtureScript])
    .directory("/repo")
    .asGit
  {{main: repo.branch("main"), feature: repo.branch("feature"), shifted: repo.branch("shifted")}}
}

let reviewerFixtureScript: String! = """
  git init -q -b main
  git config user.name 'Review Test'
  git config user.email review@example.com
  export GIT_AUTHOR_DATE=2026-09-15T12:00:00Z
  export GIT_COMMITTER_DATE=$GIT_AUTHOR_DATE
  printf '%s\n' 'def total(items):' '    result = 0' '    for item in items:' '        result += item.price' '    return result' '' 'def one():' '    return 1' '' 'def two():' '    return 2' '' 'def legacy(x):' '    return eval(x)' > calc.py
  printf '%s\n' '# Review rules' '' '- skip: generated/**' '- nit cap: 1' > REVIEW.md
  printf '%s\n' 'Money is always a Decimal.' > CLAUDE.md
  seq 1 30 | sed 's/^/line /' > notes.txt
  mkdir generated
  echo one > generated/out.txt
  git add .
  git commit -q -m 'fixture: base'
  git checkout -q -b feature
  { printf '%s\n' 'def discount(total, percent):' '    rate = percent / 10' '    return total - total * rate' ''; cat calc.py; } > calc.new
  mv calc.new calc.py
  sed -i -e '2s/.*/++ plus/' -e '25s/.*/changed/' notes.txt
  echo two > generated/out.txt
  git commit -q -am 'calc: add discount'
  git checkout -q -b shifted
  { printf '%s\n' '# calc: pricing helpers' '# (header added later)' ''; cat calc.py; } > calc.new
  mv calc.new calc.py
  git commit -q -am 'calc: add a header'
"""

# One finding as a finder reports it.
let reviewerFindingJson(path: String!, line: Int!, claim: String!, evidence: String!, category: String!, severity: String!): String! {
  JSON.encode({{path: path, line: line, claim: claim, evidence: evidence, category: category, severity: severity}})
}

let reviewerFindingsReply(findings: [String!]!): String! {
  "{\"findings\": [" + findings.join(", ") + "]}"
}

let reviewerVote(verdict: String!, severity: String!): String! {
  JSON.encode({{verdict: verdict, severity: severity, reason: "checked"}})
}

# A finding in the multi-location form, and one of its locations.
let reviewerCitedJson(severity: String!, claim: String!, category: String!, caused: Boolean!, locations: [String!]!): String! {
  let head = JSON.encode({{severity: severity, claim: claim, category: category, causedByChange: caused}})
  head.trimSpace.trimSuffix("}") + ", \"locations\": [" + locations.join(", ") + "]}"
}

let reviewerLocationJson(path: String!, line: Int!, evidence: String!): String! {
  JSON.encode({{path: path, line: line, evidence: evidence}})
}

let reviewerCausedVote(verdict: String!, severity: String!, caused: Boolean!): String! {
  JSON.encode({{verdict: verdict, severity: severity, causedByChange: caused, reason: "checked"}})
}

# The fingerprint findingsList prints for the finding at `where` (path:line).
let reviewerFingerprintAt(listing: String!, where: String!): String! {
  let pattern = "  " + where.replace(".", "\\.") + "  \\[([0-9a-f]+)\\]"
  let m = listing.match(pattern :: Regexp!)
  if (m != null) { m.captures[0] ?? "" } else { "" }
}

let reviewerDiscountClaim: String! = "percent / 10 divides by ten instead of a hundred, so a 50 percent discount takes off five times the total"
let reviewerEvalClaim: String! = "legacy passes its argument to eval, so any caller-supplied string runs as code"

let checkReviewerScreening: String! {
  let fx = reviewerFixture
  let finder = reviewerFindingsReply([
    # Real, cited one line off: anchored where the evidence is (line 2).
    reviewerFindingJson("calc.py", 3, reviewerDiscountClaim, "rate = percent / 10", "correctness", "IMPORTANT"),
    # The same finding again: one finding.
    reviewerFindingJson("calc.py", 2, reviewerDiscountClaim, "rate = percent / 10", "correctness", "IMPORTANT"),
    # Real nits; whitespace in the quote does not matter. The cap is 1.
    reviewerFindingJson("calc.py", 3, "the parameter total shadows the function total, so discount cannot call it", "  return total -   total * rate ", "correctness", "NIT"),
    reviewerFindingJson("calc.py", 1, "discount does not validate percent, so a negative value raises the price", "def discount(total, percent):", "correctness", "NIT"),
    # Pre-existing: outside every hunk. Multi-line quote, read-tool prefixes.
    reviewerFindingJson("calc.py", 18, reviewerEvalClaim, "    17→def legacy(x):\n    18→    return eval(x)", "security", "IMPORTANT"),
    # Real but voted down.
    reviewerFindingJson("calc.py", 8, "an item without a price raises AttributeError", "result += item.price", "correctness", "IMPORTANT"),
    # Dropped mechanically.
    reviewerFindingJson("calc.py", 2, "rate is a vague name", "rate = percent / 10", "naming", "NIT"),
    reviewerFindingJson("nope.py", 1, "nope.py is broken", "x = 1", "correctness", "IMPORTANT"),
    reviewerFindingJson("calc.py", 99, "line 99 is broken", "rate = percent / 10", "correctness", "IMPORTANT"),
    reviewerFindingJson("calc.py", 18, "legacy evaluates y", "return eval(y)", "security", "IMPORTANT"),
    reviewerFindingJson("generated/out.txt", 1, "generated output is stale", "two", "correctness", "IMPORTANT"),
  ])
  let votes = [
    reviewerVote("CONFIRM", "IMPORTANT"),
    reviewerVote("CONFIRM", "NIT"),
    "CONFIRM. It is a nit.",
    reviewerVote("CONFIRM", "IMPORTANT"),
    reviewerVote("REJECT", "IMPORTANT"),
  ]
  let reviewed = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: [finder],
    voterReplies: votes,
  )
  let summary = reviewed.lastSummary
  let open = reviewed.findingsList(status: ReviewerFindingStatus.OPEN)
  let lines = summary.split("\n")
  assert(message: summary) { (lines[0] ?? "") == "1 important, 1 nit, 1 pre-existing" }
  # Severity sections in order, each finding as path:line with its claim.
  assert(message: summary) { summary.contains("IMPORTANT:\n- calc.py:2 — " + reviewerDiscountClaim) }
  assert(message: summary) { summary.contains("NIT:\n- calc.py:3 — the parameter total shadows") }
  assert(message: summary) { summary.contains("PRE-EXISTING") and summary.contains("- calc.py:18 — " + reviewerEvalClaim) }
  assert(message: summary) { summary.contains("votes: 1/1 confirmed") }
  # The mechanical drops, each with its reason.
  assert(message: summary) { summary.contains("Dropped by the evidence checks (5):") }
  # The duplicate is merged, and listed so a distinct claim is not lost.
  assert(message: summary) { summary.contains("Merged into an earlier finding quoting the same code (1):\n  - calc.py:2 (general): " + reviewerDiscountClaim) }
  assert(message: summary) { summary.contains("calc.py:2 (general): style only (naming)") }
  assert(message: summary) { summary.contains("nope.py:1 (general): path does not exist at head") }
  assert(message: summary) { summary.contains("calc.py:99 (general): line does not exist at head") }
  assert(message: summary) { summary.contains("calc.py:18 (general): quoted evidence does not appear") }
  assert(message: summary) { summary.contains("generated/out.txt:1 (general): path skipped per REVIEW.md") }
  assert(message: summary) { summary.contains("Skipped per REVIEW.md: generated/out.txt") }
  assert(message: summary) { summary.contains("Below quorum (1 of 1): calc.py:8 (0/1 confirmed)") }
  assert(message: summary) { summary.contains("1 more nit over the nit cap (1) not reported.") }
  assert(message: summary) { summary.contains("Reviewed ") and summary.contains("1 commit, 2 files changed, at QUICK depth") }
  # No synthesizer ran, so no verdict; the reproductions note is there.
  assert(message: summary) { !summary.contains("Verdict:") and summary.contains("are the reviewers' own reproductions") }
  # A finding outside the hunks that no voter says the change caused is
  # PRE-EXISTING, without the caused-by-the-change note.
  assert(message: summary) { !summary.contains("though the change causes it") }
  # State: exactly the three reported findings are OPEN.
  assert(message: open) { open.split("\n").filter { l => l.hasPrefix("OPEN") }.length == 3 }
  assert(message: open) { open.contains("OPEN  IMPORTANT  calc.py:2  [") and open.contains("OPEN  NIT  calc.py:3  [") and open.contains("OPEN  PREEXISTING  calc.py:18  [") }

  # The empty case says so plainly.
  let none = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: ["```json\n{\"findings\": []}\n```"],
    voterReplies: [],
  ).lastSummary
  assert(message: none) { (none.split("\n")[0] ?? "") == "Nothing to fix." }
  assert(message: none) { !none.contains("Answer every finding") }
  # A reply without the JSON is reported, not silently empty.
  let prose = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: ["Looks good to me!"],
    voterReplies: [],
  ).lastSummary
  assert(message: prose) { (prose.split("\n")[0] ?? "") == "Nothing to fix." and prose.contains("finder \"general\" replied without the findings JSON") }
  assert(message: prose) { (prose.split("\n")[1] ?? "").hasPrefix("Incomplete: a finder did not answer") }
  assert(message: none) { !none.contains("Incomplete") }

  # Prose votes: a refusal that mentions confirming is not a confirmation.
  let refused = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: [reviewerFindingsReply([reviewerFindingJson("calc.py", 2, reviewerDiscountClaim, "rate = percent / 10", "correctness", "IMPORTANT")])],
    voterReplies: ["I cannot confirm this; it looks UNCONFIRMED to me."],
  ).lastSummary
  assert(message: refused) { (refused.split("\n")[0] ?? "") == "Nothing to fix." and refused.contains("calc.py:2 (0/1 confirmed)") }

  # Hunks: an added "++ plus" line reads "+++ plus" in the diff; it is
  # content, so the later hunk at line 25 still belongs to notes.txt.
  let plus = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: [reviewerFindingsReply([reviewerFindingJson("notes.txt", 25, "line 25 lost its number, so readers cannot cite it", "changed", "correctness", "IMPORTANT")])],
    voterReplies: [reviewerVote("CONFIRM", "IMPORTANT")],
  ).lastSummary
  assert(message: plus) { (plus.split("\n")[0] ?? "") == "1 important" }
  "Reviewer screening checks passed."
}

let reviewerConcernClaim: String! = "discount now trusts percent to be a whole number, an assumption no caller states, so a fraction silently becomes a tiny discount"

let checkReviewerConcerns: String! {
  let fx = reviewerFixture
  let finder = reviewerFindingsReply([
    # A concern citing four places: two hold (one in a hunk, so it anchors
    # there), two do not, and those are named rather than fatal.
    reviewerCitedJson("CONCERN", reviewerConcernClaim, "design", true, [
      reviewerLocationJson("calc.py", 18, "return eval(x)"),
      reviewerLocationJson("calc.py", 2, "rate = percent / 10"),
      reviewerLocationJson("calc.py", 99, "rate = percent / 10"),
      reviewerLocationJson("nope.py", 1, "x = 1"),
    ]),
    # A concern none of whose locations hold is dropped, with every reason.
    reviewerCitedJson("CONCERN", "nothing here holds", "design", true, [
      reviewerLocationJson("calc.py", 99, "rate = percent / 10"),
      reviewerLocationJson("nope.py", 1, "x = 1"),
    ]),
    # Docs the change leaves stale: outside the hunks, but caused by the
    # change, as the voter confirms, so not PRE-EXISTING.
    reviewerCitedJson("NIT", "notes.txt line 10 still describes the old numbering the change replaced", "docs", true, [
      reviewerLocationJson("notes.txt", 10, "line 10"),
    ]),
    # Asserted as caused by the change, but the voter says it was there
    # before: PRE-EXISTING.
    reviewerCitedJson("IMPORTANT", "notes.txt line 15 is out of date", "docs", true, [
      reviewerLocationJson("notes.txt", 15, "line 15"),
    ]),
  ])
  let votes = [
    reviewerCausedVote("CONFIRM", "CONCERN", true),
    reviewerCausedVote("CONFIRM", "NIT", true),
    reviewerCausedVote("CONFIRM", "IMPORTANT", false),
  ]
  let synthesis = JSON.encode({{
    verdict: "The change adds a discount helper, but its rate is off by a factor of ten.",
    sound: ["total() still sums prices as before", "  ", "legacy() is untouched"],
  }})
  let reviewed = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: [finder],
    voterReplies: votes,
    synthesisReply: synthesis,
  )
  let summary = reviewed.lastSummary
  let open = reviewed.findingsList(status: ReviewerFindingStatus.OPEN)
  let lines = summary.split("\n")
  assert(message: summary) { (lines[0] ?? "") == "1 concern, 1 nit, 1 pre-existing" }
  # The verdict sits right after the count line, then the findings; what
  # was found sound follows them, cleaned up, then the provenance.
  assert(message: summary) { (lines[1] ?? "") == "" }
  assert(message: summary) { (lines[2] ?? "") == "Verdict: The change adds a discount helper, but its rate is off by a factor of ten." }
  assert(message: summary) { (lines[3] ?? "") == "" and (lines[4] ?? "") == "CONCERN:" }
  assert(message: summary) { summary.contains("\n\nChecked and found sound:\n- total() still sums prices as before\n- legacy() is untouched\n\nReviewed ") }
  assert(message: summary) { (summary.split("Checked and found sound:")[0] ?? "").contains("PRE-EXISTING") }
  # The concern, between IMPORTANT and NIT, anchored in the hunk, with its
  # other location (unquoted) and the ones that did not hold.
  assert(message: summary) { summary.contains("CONCERN:\n- calc.py:2 — " + reviewerConcernClaim + "\n  evidence:\n      rate = percent / 10\n  also at calc.py:18\n") }
  assert(message: summary) { summary.contains("  cited but not found at head: calc.py:99 (line does not exist at head (calc.py has 18 lines)); nope.py:1 (path does not exist at head)") }
  assert(message: summary) { summary.contains("votes: 1/1 confirmed · design (general)") }
  assert(message: summary) { (summary.split("CONCERN:")[1] ?? "").contains("Sub-agents composed from") and (summary.split("CONCERN:")[1] ?? "").contains("NIT:") }
  # The dropped concern names every location's reason.
  assert(message: summary) { summary.contains("Dropped by the evidence checks (1):") }
  assert(message: summary) { summary.contains("calc.py:99 (general): no cited location holds: calc.py:99 (line does not exist at head (calc.py has 18 lines)); nope.py:1 (path does not exist at head)") }
  # Stale docs caused by the change: a NIT, marked as outside the hunks.
  assert(message: summary) { summary.contains("NIT:\n- notes.txt:10 — ") }
  assert(message: summary) { summary.contains("outside the change's hunks, though the change causes it: GitHub cannot anchor a line comment there") }
  assert(message: summary) { summary.split("though the change causes it").length == 2 }
  # Not confirmed as caused by the change: PRE-EXISTING.
  assert(message: summary) { summary.contains("PRE-EXISTING (outside the change's hunks and not caused by it; GitHub cannot anchor a line comment there):\n- notes.txt:15 — ") }
  assert(message: open) { open.contains("OPEN  CONCERN  calc.py:2  [") and open.contains("OPEN  NIT  notes.txt:10  [") and open.contains("OPEN  PREEXISTING  notes.txt:15  [") }

  # Asserted by the finder alone is not enough: a voter who does not say the
  # change caused it leaves the stale line PRE-EXISTING.
  let unconfirmed = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: [reviewerFindingsReply([reviewerCitedJson("NIT", "notes.txt line 10 is stale", "docs", true, [reviewerLocationJson("notes.txt", 10, "line 10")])])],
    voterReplies: [reviewerVote("CONFIRM", "NIT")],
  ).lastSummary
  assert(message: unconfirmed) { (unconfirmed.split("\n")[0] ?? "") == "1 pre-existing" }

  # A malformed optional field loses only itself: the finding stays, and a
  # voter's confirmation still places it.
  let sloppy = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: ["{\"findings\": [{\"severity\": \"NIT\", \"claim\": \"notes.txt line 10 is stale\", \"category\": \"docs\", \"causedByChange\": \"yes\", \"path\": \"notes.txt\", \"line\": 10, \"evidence\": \"line 10\"}], \"checked\": [{\"what\": \"not a string\"}]}"],
    voterReplies: [reviewerCausedVote("CONFIRM", "NIT", true)],
  ).lastSummary
  assert(message: sloppy) { (sloppy.split("\n")[0] ?? "") == "1 nit" and sloppy.contains("though the change causes it") }

  # Each finding says why it is worth the time; nits are compact quick
  # fixes, without a quoted evidence block.
  let worthy = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: ["{\"findings\": [{\"severity\": \"NIT\", \"claim\": \"notes.txt line 10 still uses the old numbering; renumber it\", \"worth\": \"readers follow the notes\", \"category\": \"docs\", \"locations\": [{\"path\": \"notes.txt\", \"line\": 10, \"evidence\": \"line 10\"}, {\"path\": \"notes.txt\", \"line\": 11, \"evidence\": \"line 11\"}]}]}"],
    voterReplies: [reviewerCausedVote("CONFIRM", "NIT", true)],
  ).lastSummary
  assert(message: worthy) { worthy.contains("NIT:\n- notes.txt:10 — notes.txt line 10 still uses the old numbering; renumber it\n  worth it: readers follow the notes\n  also at notes.txt:11\n  outside the change's hunks") }
  assert(message: worthy) { !worthy.contains("evidence:") }

  # At most three concerns, the strongest: of four confirmed at STANDARD,
  # the one with two of three votes goes.
  let four = reviewerFindingsReply([
    reviewerCitedJson("CONCERN", "concern one", "design", true, [reviewerLocationJson("calc.py", 1, "def discount(total, percent):")]),
    reviewerCitedJson("CONCERN", "concern two", "design", true, [reviewerLocationJson("calc.py", 2, "rate = percent / 10")]),
    reviewerCitedJson("CONCERN", "concern three", "design", true, [reviewerLocationJson("calc.py", 3, "return total - total * rate")]),
    reviewerCitedJson("CONCERN", "concern four", "design", true, [reviewerLocationJson("notes.txt", 25, "changed")]),
  ])
  let yes = reviewerCausedVote("CONFIRM", "CONCERN", true)
  let no = reviewerCausedVote("REJECT", "CONCERN", true)
  let capped = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.STANDARD,
    finderReplies: [four, reviewerFindingsReply([]), reviewerFindingsReply([])],
    voterReplies: [yes, yes, no, yes, yes, yes, yes, yes, yes, yes, yes, yes],
  ).lastSummary
  assert(message: capped) { (capped.split("\n")[0] ?? "") == "3 concerns" }
  assert(message: capped) { !capped.contains("— concern one") and capped.contains("— concern two") and capped.contains("— concern four") }
  assert(message: capped) { capped.contains("1 weaker concern over the concern cap (3) not reported: calc.py:1") }

  # A location's line given as text still reads ("2-3" is line 2); a line
  # that reads as neither number nor text loses the locations, so the
  # review is incomplete rather than a clean pass that closes findings.
  let texted = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: ["{\"findings\": [{\"severity\": \"CONCERN\", \"claim\": \"" + reviewerConcernClaim + "\", \"category\": \"design\", \"locations\": [{\"path\": \"calc.py\", \"line\": \"2-3\", \"evidence\": \"rate = percent / 10\"}]}]}"],
    voterReplies: [reviewerCausedVote("CONFIRM", "CONCERN", true)],
  ).lastSummary
  assert(message: texted) { (texted.split("\n")[0] ?? "") == "1 concern" and texted.contains("- calc.py:2 — " + reviewerConcernClaim) }
  let unreadable = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: ["{\"findings\": [{\"severity\": \"CONCERN\", \"claim\": \"x\", \"category\": \"design\", \"locations\": [{\"path\": \"calc.py\", \"line\": {\"from\": 2}, \"evidence\": \"rate = percent / 10\"}]}]}"],
    voterReplies: [],
  ).lastSummary
  assert(message: unreadable) { (unreadable.split("\n")[1] ?? "").hasPrefix("Incomplete: a finder did not answer") }
  assert(message: unreadable) { unreadable.contains("finder \"general\": its findings' locations could not be read") and unreadable.contains("(no location) (general): no location") }

  # With nothing found, the synthesis still leads; a prose or failed
  # synthesizer reply is shown for what it is.
  let quiet = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: ["{\"findings\": [], \"checked\": [\"discount handles a zero percent\"]}"],
    voterReplies: [],
    synthesisReply: "```json\n{\"verdict\": \"Small, and it does what it says.\", \"sound\": []}\n```",
  ).lastSummary
  let quietLines = quiet.split("\n")
  assert(message: quiet) { (quietLines[0] ?? "") == "Nothing to fix." and (quietLines[2] ?? "") == "Verdict: Small, and it does what it says." }
  assert(message: quiet) { (quietLines[3] ?? "") == "" and (quietLines[4] ?? "") == "Checked and found sound: nothing listed." }
  assert(message: quiet) { !quiet.contains("Answer every finding") }
  let prose = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: [reviewerFindingsReply([])],
    voterReplies: [],
    synthesisReply: "Looks right to me.",
  ).lastSummary
  assert(message: prose) { (prose.split("\n")[2] ?? "") == "Verdict: Looks right to me." }
  let failed = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: [reviewerFindingsReply([])],
    voterReplies: [],
    synthesisReply: "REVIEWER SUB-AGENT FAILED: the model timed out",
  ).lastSummary
  assert(message: failed) { (failed.split("\n")[2] ?? "") == "Verdict: none; the synthesizer failed: the model timed out" }
  assert(message: failed) { !failed.contains("\n\n\n") and !prose.contains("\n\n\n") }
  "Reviewer concern, causedByChange and synthesis checks passed."
}

let checkReviewerReconcile: String! {
  let fx = reviewerFixture
  let first = reviewer.tallyReplies(
    source: fx.feature.asWorkspace,
    head: fx.feature,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: [reviewerFindingsReply([
      reviewerFindingJson("calc.py", 2, reviewerDiscountClaim, "rate = percent / 10", "correctness", "IMPORTANT"),
      reviewerFindingJson("calc.py", 3, "the parameter total shadows the function total, so discount cannot call it", "return total - total * rate", "correctness", "NIT"),
      reviewerFindingJson("calc.py", 18, reviewerEvalClaim, "return eval(x)", "security", "IMPORTANT"),
    ])],
    voterReplies: [reviewerVote("CONFIRM", "IMPORTANT"), reviewerVote("CONFIRM", "NIT"), reviewerVote("CONFIRM", "IMPORTANT")],
  )
  let before = first.findingsList(status: ReviewerFindingStatus.OPEN)
  let discountFp = reviewerFingerprintAt(before, "calc.py:2")
  let nitFp = reviewerFingerprintAt(before, "calc.py:3")
  let evalFp = reviewerFingerprintAt(before, "calc.py:18")
  assert(message: before) { discountFp != "" and nitFp != "" and evalFp != "" }

  # resolve needs a reason and a known fingerprint.
  let noReason = first.resolve(fingerprint: evalFp, reason: " ").lastSummary rescue { e: Error => e.message }
  assert(message: noReason) { noReason.contains("needs a reason") }
  let unknown = first.resolve(fingerprint: "000000000000", reason: "x").lastSummary rescue { e: Error => e.message }
  assert(message: unknown) { unknown.contains("no finding with fingerprint") }
  let resolved = first.resolve(fingerprint: evalFp, reason: "legacy only ever sees trusted input")

  # Re-review after three lines were added above everything: the discount
  # finding moved to line 5 and, reworded by the new run, keeps its
  # fingerprint, so it stays OPEN; the nit is not found again, so it is
  # FIXED; the resolved eval finding is found again at line 21 and stays
  # RESOLVED.
  let again = resolved.tallyReplies(
    source: fx.shifted.asWorkspace,
    head: fx.shifted,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: [reviewerFindingsReply([
      reviewerFindingJson("calc.py", 5, "the rate divides by ten, so every discount is ten times too big", "rate = percent / 10", "correctness", "IMPORTANT"),
      reviewerFindingJson("calc.py", 21, reviewerEvalClaim, "return eval(x)", "security", "IMPORTANT"),
    ])],
    voterReplies: [reviewerVote("CONFIRM", "IMPORTANT"), reviewerVote("CONFIRM", "IMPORTANT")],
  )
  let out = again.{{
    summary: lastSummary,
    open: findingsList(status: ReviewerFindingStatus.OPEN),
    fixed: findingsList(status: ReviewerFindingStatus.FIXED),
    done: findingsList(status: ReviewerFindingStatus.RESOLVED),
    all: findingsList,
  }}
  assert(message: out.summary) { (out.summary.split("\n")[0] ?? "") == "1 important" }
  assert(message: out.open) { reviewerFingerprintAt(out.open, "calc.py:5") == discountFp }
  assert(message: out.open) { out.open.split("\n").filter { l => l.hasPrefix("OPEN") }.length == 1 }
  assert(message: out.fixed) { reviewerFingerprintAt(out.fixed, "calc.py:3") == nitFp }
  assert(message: out.done) { reviewerFingerprintAt(out.done, "calc.py:21") == evalFp and out.done.contains("legacy only ever sees trusted input") }
  assert(message: out.summary) { out.summary.contains("No longer reproduced, now FIXED: " + nitFp) }
  assert(message: out.summary) { out.summary.contains("Found again but already RESOLVED: " + evalFp) }
  assert(message: out.all) { out.all.split("\n").filter { l => l.hasPrefix("OPEN") or l.hasPrefix("FIXED") or l.hasPrefix("RESOLVED") }.length == 3 }

  # A FIXED finding that comes back is OPEN again.
  let back = again.tallyReplies(
    source: fx.shifted.asWorkspace,
    head: fx.shifted,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: [reviewerFindingsReply([
      reviewerFindingJson("calc.py", 6, "the parameter total shadows the function total, so discount cannot call it", "return total - total * rate", "correctness", "NIT"),
    ])],
    voterReplies: [reviewerVote("CONFIRM", "NIT")],
  ).findingsList(status: ReviewerFindingStatus.OPEN)
  assert(message: back) { reviewerFingerprintAt(back, "calc.py:6") == nitFp }

  # Absence is not a fix when the review did not look: a finder that failed
  # to answer, or a range that does not touch the file, leaves OPEN alone.
  let unanswered = again.tallyReplies(
    source: fx.shifted.asWorkspace,
    head: fx.shifted,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: ["I ran out of time."],
    voterReplies: [],
  )
  # JSON without a findings list is no answer either.
  let errored = unanswered.tallyReplies(
    source: fx.shifted.asWorkspace,
    head: fx.shifted,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: ["{\"error\": \"timed out\"}"],
    voterReplies: [],
  )
  assert(message: errored.lastSummary) { !errored.lastSummary.contains("now FIXED") and errored.lastSummary.contains("replied without the findings JSON") }
  let elsewhere = errored.tallyReplies(
    source: fx.main.asWorkspace,
    head: fx.main,
    base: fx.main,
    depth: ReviewerDepth.QUICK,
    finderReplies: [reviewerFindingsReply([])],
    voterReplies: [],
  )
  let stillOpen = elsewhere.findingsList(status: ReviewerFindingStatus.OPEN)
  assert(message: stillOpen) { reviewerFingerprintAt(stillOpen, "calc.py:5") == discountFp }
  assert(message: unanswered.lastSummary) { !unanswered.lastSummary.contains("now FIXED") }
  "Reviewer reconciliation checks passed."
}

let checkReviewerComposition(source: Workspace!): String! {
  # Default composition picks the reviewer's agent, never its roles.
  let defaults = source.artifacts.filterTypes(types: ["Expertise"]).filterPathPattern(pattern: "reviewer/**").items.{{ uri }}.map { a => a.uri }
  assert(message: defaults.join(", ")) { defaults.any { u => u.contains("reviewer/agent") } }
  assert(message: defaults.join(", ")) { !defaults.any { u => u.contains("reviewer/finder") or u.contains("reviewer/voter") or u.contains("reviewer/synthesizer") } }

  let chief = llm.withWorkspace(source).spawn(
    name: "reviewer-composition-chief",
    expertise: expertiseAt(source, "dag://committer/agent")
      + expertiseAt(source, "dag://contributor/agent")
      + expertiseAt(source, "dag://staff/agent")
      + expertiseAt(source, "dag://reviewer/agent"),
  )
  let picked = reviewer.subagentExpertise(caller: chief, role: "finder").{{ id, artifact.{{ uri }} }}
  let selected = picked.map { e => node(id: e.id).{{ ... on Expertise! }} }
  let voters = reviewer.subagentExpertise(caller: chief, role: "voter").{{ artifact.{{ uri }} }}.map { e => e.artifact.uri }
  let synth = reviewer.subagentExpertise(caller: chief, role: "synthesizer").{{ artifact.{{ uri }} }}.map { e => e.artifact.uri }
  let finder = llm.withWorkspace(source).spawn(name: "reviewer-composition-finder", expertise: selected);
  {
    # Staff and reviewer are gone; contributor and committer are read-only.
    let uris = picked.map { e => e.artifact.uri }
    assert(message: uris.join(", ")) { uris.length == 3 }
    assert(message: uris.join(", ")) { (uris[0] ?? "").contains("committer/readonly") and (uris[1] ?? "").contains("contributor/readonly") and (uris[2] ?? "").contains("reviewer/finder") }
    assert(message: voters.join(", ")) { voters.length == 3 and (voters[2] ?? "").contains("reviewer/voter") }
    assert(message: synth.join(", ")) { synth.length == 3 and (synth[2] ?? "").contains("reviewer/synthesizer") }

    let conversation = finder.snapshot.sync
    assert(message: recordedUris(conversation).join(", ")) { recordedUris(conversation) == uris }
    let names = composedToolNames(conversation, llm.withWorkspace(source))
    ["gh", "reviewComments", "checkout", "commit", "cherryPick", "diff"].each { n =>
      assert(message: names.join(", ")) { names.any { t => t == n or t.hasSuffix("_" + n) } }
    }
    ["push", "comment", "updateComment", "pushBranch", "review", "resolve", "spawn", "sendTo", "askChief"].each { n =>
      assert(message: names.join(", ")) { !names.any { t => t == n or t.hasSuffix("_" + n) } }
    }
    let prompts = systemTexts(conversation)
    assert { prompts.any { t => t.contains("You are an adversarial reviewer in a code review") } }
    assert { prompts.any { t => t.contains("READ-ONLY GitHub tools") } }
    assert { !prompts.any { t => t.contains("You can hire and direct a staff") or t.contains("You have a code reviewer") } }

    # Without a reviewer entry there is no role to compose.
    let bare = llm.withWorkspace(source).spawn(name: "reviewer-composition-bare", expertise: expertiseAt(source, "dag://committer/agent"))
    let missing = reviewer.subagentExpertise(caller: bare, role: "finder").{{ id }}.length rescue { e: Error => -1 }
    bare.stop
    assert { missing == -1 }

    # A committer entry discovered in a workspace whose committer has no
    # read-only role (an older one) gets the role from where reviewer's
    # entry came from, never the full agent.
    let older = directory
      .withNewFile("dagger.toml", "[modules.committer]\nsource = \"committer\"\n")
      .withDirectory("committer", agentModule("committer", "Committer", "older committer", "olderRead"))
      .asWorkspace
    let mixed = llm.withWorkspace(source).spawn(
      name: "reviewer-composition-mixed",
      expertise: expertiseAt(older, "dag://committer/agent") + expertiseAt(source, "dag://reviewer/agent"),
    )
    let fallback = reviewer.subagentExpertise(caller: mixed, role: "voter").{{ artifact.{{ uri }} }}.map { e => e.artifact.uri } rescue {
      err: Error => {
        mixed.stop
        raise err.message
      }
    }
    mixed.stop
    assert(message: fallback.join(", ")) { fallback.length == 2 and (fallback[0] ?? "").contains("committer/readonly") and (fallback[1] ?? "").contains("reviewer/voter") }
    null
  } rescue { e: Error => {
    finder.stop
    chief.stop
    raise e.message
  }}
  finder.stop
  chief.stop
  "Reviewer composition checks passed."
}

let checkReviewerTools(source: Workspace!): String! {
  let plumbing = ["finder", "voter", "synthesizer", "subagentExpertise", "tallyReplies", "withRecordedReplies", "lastSummary", "agent"]
  # review takes the calling agent, which only an owning agent supplies.
  let unowned = composedToolNames(reviewer.agent(llm.withWorkspace(source)), llm.withWorkspace(source))
  assert(message: unowned.join(", ")) { unowned.contains("findingsList") and unowned.contains("resolve") and !unowned.contains("review") }
  let caller = llm.withWorkspace(source).spawn(name: "reviewer-tools-caller", expertise: expertiseAt(source, "dag://reviewer/agent"))
  let conversation = caller.snapshot.sync
  caller.stop
  let names = composedToolNames(conversation, llm.withWorkspace(source))
  assert(message: names.join(", ")) { names.length == 3 and names.contains("review") and names.contains("findingsList") and names.contains("resolve") }
  plumbing.each { n =>
    assert(message: names.join(", ")) { !names.contains(n) }
  }
  assert { systemTexts(conversation).any { t => t.contains("REVIEW YOUR OWN CHANGE") and t.contains("THE REVIEWERS' REPRODUCTIONS") } }
  "Reviewer tool visibility checks passed."
}

# Run reviewer-driver's pipeline check (agents-dev/reviewer-driver) in a
# plain-directory fixture workspace holding the driver, this repository's
# reviewer, and committer and contributor for the caller to compose, so the
# sub-agents have read-only roles to swap in.
#
# A plain directory, not this git checkout: LLM.allowed (core/llm.go) gates
# LLM.loop/step made from a git-sourced module behind an interactive "Allow
# LLM access?" prompt, which a check cannot answer, so it hangs.
let checkReviewerPipeline(source: Workspace!): String! {
  let fixture = directory
    .withNewFile("dagger.toml", [
      "[modules.committer]", `source = "committer"`, "",
      "[modules.contributor]", `source = "contributor"`, "",
      "[modules.reviewer]", `source = "reviewer"`, "",
      "[modules.reviewer-driver]", `source = "driver"`, "",
    ].join("\n"))
    .withDirectory("committer", source.directory("/committer"))
    .withDirectory("contributor", source.directory("/contributor"))
    .withDirectory("reviewer", source.directory("/reviewer"))
    .withDirectory("driver", source.directory("/agents-dev/reviewer-driver"))
    .asWorkspace
  let checks = fixture.artifacts.filterTypes(types: ["Check"]).filterPathPattern(pattern: "reviewer-driver/pipeline").asChecks.{{ id }}
  assert(message: `expected one reviewer-driver/pipeline check, got ${toString(checks.length)}`) { checks.length == 1 }
  checks.each { ref =>
    let c = node(id: ref.id).{{ ... on Check! }}
    if (!c.pass) {
      let why = c.error.message rescue { e: Error => e.message }
      raise `reviewer-driver/pipeline failed: ${why}`
    }
  }
  "Reviewer pipeline checks passed."
}
