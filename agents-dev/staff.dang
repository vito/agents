let testStaffFiltering(source: Workspace!): String! {
  let root = "staff-glob-check-" + Random.string
  let base = source.git.head.asWorkspace
  let working = base
    .withNewFile(root + "/one.go", "one\n")
    .withNewFile(root + "/nested/two.go", "two\n")
    .withNewFile(root + "/nested/keep.txt", "unselected\n")
  let worker = llm.withWorkspace(working).spawn(name: "filter-fixture")
  let fixture = staff.withWorker("fixture", worker)
  let patch = fixture.pendingOf(name: "fixture", paths: [root + "/**/*.go"])
  assert { patch.contains("+one") and patch.contains("+two") }
  assert { !patch.contains("keep.txt") }
  let none = fixture.pendingOf(name: "fixture", paths: [root + "/**/*.rs"])
  assert { none.contains("no uncommitted changes") }
  # The escape hatch points committed work at its address, not at a verb.
  assert { none.contains("dag://staff/members/head?staff-member=fixture") }
  worker.stop

  # Exercise literal drift filtering through salvagePending. All other pending
  # changes are already present in the chief: interpreting a filename as a glob
  # would try to reapply those additions and fail (or take the wrong files).
  let seeded = base
    .withNewFile(root + "/old name.txt", "rename\n")
    .withNewFile(root + "/delete me.txt", "remove\n")
  let before = seeded.withCommit(changes: seeded.git.uncommitted,
    message: "fixture", date: "2026-09-15T12:00:00Z")
  let after = before.withoutFile(root + "/old name.txt").withoutFile(root + "/delete me.txt")
    .withNewFile(root + "/new name.txt", "rename\n")
  let names = [
    "space name.txt", "tab\tname.txt", "line\nname.txt", "quote\"name.txt",
    "back\\slash.txt", "[literal].txt", "*.txt", "?.txt", "!literal.txt",
    " leading.txt", "trailing.txt ", "a/inside.txt", "a/nested/leaf.txt", "outside.txt"
  ]
  names.each { name =>
    let tree = after.directory("/")
    after = after.withChanges(tree.withNewFile(root + "/" + name, "added\n").changes(from: tree))
  }
  let literalWorker = llm.withWorkspace(after).spawn(name: "literal-filter-fixture")
  let literalFixture = staff.withWorker("fixture", literalWorker);
  {
    names.each { name =>
      # Directory.withoutFile accepts globs; build the sibling set explicitly
      # so names such as *.txt remain literal fixture data.
      let siblings = directory.withNewFile("new name.txt", "rename\n")
      names.filter { candidate => candidate != name }.each { sibling =>
        siblings = siblings.withNewFile(sibling, "added\n")
      }
      let tree = after.directory("/")
      let chief = after.withChanges(tree.withoutDirectory(root).withDirectory(root, siblings).changes(from: tree))
      let selected = literalFixture.salvagePending(source: chief, name: "fixture")
      assert { selected.diffStats.{{path}}.map { s => s.path }.filter { p => !p.hasSuffix("/") } == [root + "/" + name] }
      assert { selected.asPatch.contents.contains("+added") }
      assert { chief.directory("/").withChanges(selected).changes(from: after.directory("/")).isEmpty }
    }
    let withoutDir = after.withoutDirectory(root + "/a")
    let directoryDelta = literalFixture.salvagePending(source: withoutDir, name: "fixture")
    assert { directoryDelta.diffStats.{{path}}.map { s => s.path }.filter { p => !p.hasSuffix("/") } == [root + "/a/inside.txt", root + "/a/nested/leaf.txt"] }
    assert { literalFixture.salvagePending(source: after, name: "fixture").isEmpty }
    assert { literalFixture.salvagePending(source: before, name: "fixture").asPatch.contents == after.git.uncommitted.asPatch.contents }
    let undeleted = after.withNewFile(root + "/delete me.txt", "remove\n")
    assert { literalFixture.salvagePending(source: undeleted, name: "fixture").removedPaths == [root + "/delete me.txt"] }
    let oldOnly = after.withNewFile(root + "/old name.txt", "rename\n")
    assert { literalFixture.salvagePending(source: oldOnly, name: "fixture").removedPaths == [root + "/old name.txt"] }
    let newOnly = after.withoutFile(root + "/new name.txt")
    assert { literalFixture.salvagePending(source: newOnly, name: "fixture").addedPaths == [root + "/new name.txt"] }
    let unrenamed = newOnly.withNewFile(root + "/old name.txt", "rename\n")
    let renamed = literalFixture.salvagePending(source: unrenamed, name: "fixture")
    assert { renamed.diffStats.{{kind}}.map { s => s.kind } == [DiffStatKind.RENAMED] }
    null
  } rescue { e: Error => {
    literalWorker.stop
    raise e.message
  }}
  literalWorker.stop
  "Staff filtering checks passed."
}

let testStaffMembers(source: Workspace!): String! {
  let base = source.git.head.asWorkspace
  let root = "staff-members-check-" + Random.string
  let edited = base.withNewFile(root + "/note.txt", "member\n")
  let committed = edited.withCommit(
    changes: edited.git.uncommitted,
    message: "fixture: member commit",
    date: "2026-09-15T12:00:00Z",
  )
  let idle = llm.withWorkspace(base).spawn(name: "members-idle")
  let ahead = llm.withWorkspace(committed).spawn(name: "members-ahead")
  let roster = staff.withWorker("idle", idle).withWorker("ahead", ahead);
  {
    # The engine projects a @collection to keys/list/get/subset.
    let members = roster.members
    assert { members.keys == ["ahead", "idle"] }
    assert { members.list.{{name}}.map { m => m.name } == ["ahead", "idle"] }
    let picked = members.get(key: "ahead")
    assert { picked.name == "ahead" }
    assert { picked.head.commitSHA == committed.git.head.commitSHA }
    assert { picked.workspace.file(root + "/note.txt").contents == "member\n" }
    assert { members.get(key: "idle").head.commitSHA == base.git.head.commitSHA }
    assert { members.subset(keys: ["ahead"]).keys == ["ahead"] }
    let missing = members.get(key: "nobody").name rescue { e: Error => e.message }
    assert { missing.contains("nobody") }
    # An empty roster is an empty collection, not an error.
    assert { staff.members.keys == [] }

    # A member's head is an artifact: the collection field on the module's
    # main object contributes a `staff-member` dimension (the engine
    # namespaces the item type by module) to the workspace schema, and
    # `head` is a GitRef path under it.
    let selected = source.artifacts.filterPathPattern(pattern: "staff/**")
    let dimensions = selected.dimensionDefinitions.{{identifier, name, itemType}}
    assert { dimensions.any { d => d.identifier == "/staff/members" and d.name == "staff-member" and d.itemType == "StaffMember" } }
    let paths = selected.pathDefinitions.{{uri, dimensions}}
    assert { paths.any { p => p.uri == "dag://?git-ref=staff/members/head" and p.dimensions.contains("/staff/members") and p.dimensions.contains("type:GitRef") } }
    # Exactly one `members` tree: the worker's Peers is minted by a function
    # with a required argument, so it adds no second `staff-member` dimension
    # (no staff/pull-tools/members) that would make the address ambiguous.
    # The item type's own `type:StaffMember` dimension shares the name, but
    # collection aliases win over type names when resolving.
    assert { dimensions.filter { d => d.name == "staff-member" and !d.identifier.hasPrefix("type:") }.map { d => d.identifier } == ["/staff/members"] }
    assert { !paths.any { p => p.uri.contains("pull-tools") or p.uri.contains("peers") } }

    # In a chief's scope the address resolves against its live roster, even
    # though the chief does not get `members` as a tool.
    let scope = llm.withWorkspace(base).withTools(roster, except: ["members"]).artifacts(include: ["staff/members"])
    assert { scope.dimensionKeys(dimension: "staff-member") == ["ahead", "idle"] }
    let head = scope.filterUri(uri: "dag://staff/members/head?staff-member=ahead").one.value.{{... on GitRef!}}
    assert { head.commitSHA == committed.git.head.commitSHA }
    null
  } rescue { e: Error => {
    idle.stop
    ahead.stop
    raise e.message
  }}
  idle.stop
  ahead.stop
  "Staff members collection checks passed."
}

let testStaffPeers(source: Workspace!): String! {
  let base = source.git.head.asWorkspace
  let root = "staff-peers-check-" + Random.string
  let edited = base.withNewFile(root + "/chief.txt", "chief\n")
  let chiefWorkspace = edited.withCommit(
    changes: edited.git.uncommitted,
    message: "fixture: chief commit",
    date: "2026-09-15T12:00:00Z",
  )
  # The chief's conversation binds its Staff, as Staff.agent does; the
  # roster a worker sees is read from there. It starts with no workers: the
  # chief must exist before a worker can name it as its parent.
  let chief = llm.withWorkspace(chiefWorkspace).withTools(staff, except: ["members"]).spawn(name: "peers-chief")
  let early = spawnUnder(chief, llm.withWorkspace(base), "early", [])
  let late = llm.withWorkspace(base.withNewFile(root + "/late.txt", "unfinished\n")).spawn(name: "late")
  let hiredEarly = staff.withWorker("early", early)
  # Peers holds only the worker itself; chief and name come from it.
  let peers = staff.peers(me: early);
  {
    chief.reseed(conversation: llm.withWorkspace(chiefWorkspace).withTools(hiredEarly, except: ["members"]))
    # The worker itself is left out; the chief is always there.
    assert { peers.members.keys == ["chief"] }
    let own = peers.members.get(key: "early").name rescue { e: Error => e.message }
    assert { own.contains("early") }

    # The chief hires `late` after `early` was spawned: its next committed
    # step binds the grown roster. Reseeding stands in for that step without
    # a model call. The SAME Peers object now sees the new worker.
    chief.reseed(conversation: llm.withWorkspace(chiefWorkspace).withTools(hiredEarly.withWorker("late", late), except: ["members"]))
    assert { peers.members.keys == ["chief", "late"] }
    assert { peers.members.get(key: "chief").head.commitSHA == chiefWorkspace.git.head.commitSHA }
    assert { peers.members.get(key: "late").head.commitSHA == base.git.head.commitSHA }

    # A worker's scope resolves the same addresses through its bound Peers,
    # bound as the worker role binds it: `members` is not a tool, yet still
    # a tree.
    let scope = llm.withWorkspace(base).withTools(peers, except: ["members"]).artifacts(include: ["staff/members"])
    assert { scope.dimensionKeys(dimension: "staff-member") == ["chief", "late"] }
    let head = scope.filterUri(uri: "dag://staff/members/head?staff-member=chief").one.value.{{... on GitRef!}}
    assert { head.commitSHA == chiefWorkspace.git.head.commitSHA }

    # The escape hatches reach any member, chief included.
    let pending = peers.pendingOf(name: "late")
    assert { pending.contains(root + "/late.txt") and pending.contains("+unfinished") }
    assert { peers.pendingOf(name: "chief").contains("no uncommitted changes") }
    assert { peers.salvagePending(source: base, name: "late").addedPaths.filter { p => !p.hasSuffix("/") } == [root + "/late.txt"] }

    # Workers get the roster, the escape hatches and the line home, never
    # orchestration. The roster is reached by address, not as a tool.
    let tools = llm.withWorkspace(base).withTools(peers, except: ["members"]).tools
    ["pendingOf", "salvagePending", "askChief"].each { name =>
      assert { tools.contains("## " + name + "\n") }
    }
    ["spawn", "sendTo", "interruptWorker", "logOf", "pullPending", "members", "me", "chief"].each { name =>
      assert { !tools.contains("## " + name + "\n") }
    }

    # A root agent has no chief: Peers says so instead of guessing.
    let orphan = staff.peers(me: late).members.keys rescue { e: Error => [e.message] }
    assert { orphan.length == 1 and (orphan[0] ?? "").contains("no chief") }
    null
  } rescue { e: Error => {
    early.stop
    late.stop
    chief.stop
    raise e.message
  }}
  early.stop
  late.stop
  chief.stop
  "Staff peers checks passed."
}

# A worker whose parent is `chief`, without a model call. A chief's spawn
# tool records the calling chief as parent; a check has no calling agent, so
# restore under a fresh handle with the chief as the recorded parent instead.
# The expertise is composed after that identity exists, as spawn does.
let spawnUnder(chief: Agent!, conversation: LLM!, name: String!, expertise: [Expertise!]!): Agent! {
  conversation.spawn(
    name: name,
    handle: "staff-check-" + name + "-" + Random.string,
    parentHandle: chief.handle,
    expertise: expertise,
  )
}

# The expertise selected by a DAG address, reloaded by ID so it can be passed
# on as a concrete [Expertise!]! argument.
let expertiseAt(ws: Workspace!, uri: String!): [Expertise!]! {
  ws.artifacts.filterUri(uri: uri).asExpertise.{{ id }}.map { node(id: _.id).{{ ... on Expertise! }} }
}

let recordedUris(conversation: LLM!): [String!]! {
  conversation.expertise.{{ artifact.{{ uri }} }}.map { e => e.artifact.uri }
}

# Reload, as Editor's reload does: bind `ws`, then compose every recorded
# entry again, each looked up by its URI in `ws` and falling back to the
# recorded entry where `ws` doesn't address it. A looked-up entry refreshes
# its recorded one in place, so the record keeps its order.
let reloadIn(conversation: LLM!, ws: Workspace!): LLM! {
  let entries = conversation.expertise.{{ id, artifact.{{ uri }} }}.map { e =>
    let found = ws.artifacts.filterUri(uri: e.artifact.uri).asExpertise.{{ id }}.map { f => f.id }
    node(id: found[0] ?? e.id).{{ ... on Expertise! }}
  }
  conversation.withWorkspace(ws).compose(expertise: entries)
}

# Reload an agent's current conversation in its own bound workspace.
let reload(agent: Agent!): LLM! {
  let conversation = agent.snapshot.sync
  reloadIn(conversation, conversation.workspace)
}

let systemTexts(conversation: LLM!): [String!]! {
  let texts: [String!]! = []
  conversation.messages.{{role, content.{{text}}}}
    .filter { m => m.role == LLMMessageRole.SYSTEM }
    .each { m => m.content.each { c => texts += [c.text ?? ""] } }
  texts
}

let testStaffWorker(source: Workspace!): String! {
  let workerLine = `Your staff name is "check-worker"`
  # Default composition picks the chief role, never the worker role.
  let defaults = source.artifacts.filterTypes(types: ["Expertise"]).filterPathPattern(pattern: "staff/**").items.{{ uri }}.map { a => a.uri }
  assert("staff/agent is a default expertise") { defaults.any { u => u.contains("staff/agent") } }
  assert("staff/worker is not a default expertise") { !defaults.any { u => u.contains("staff/worker") } }

  # A chief composed from this workspace: git tools plus the staff chief role.
  let chief = llm.withWorkspace(source).spawn(
    name: "worker-check-chief",
    expertise: expertiseAt(source, "dag://committer/agent") + expertiseAt(source, "dag://staff/agent"),
  )
  # Spawn inherits the chief's record minus staff's own entries, then adds
  # the worker role. A module call returns a lazy list: select once, then
  # reload each entry by ID.
  let picked = staff.workerExpertise(chief: chief).{{ id, artifact.{{ uri }} }}
  let selected = picked.map { e => node(id: e.id).{{ ... on Expertise! }} }
  let worker = spawnUnder(chief, llm.withWorkspace(source), "check-worker", selected);
  {
    let uris = picked.map { e => e.artifact.uri }
    assert("the worker inherits committer/agent and adds staff/worker") { uris.length == 2 and (uris[0] ?? "").contains("committer/agent") and (uris[1] ?? "").contains("staff/worker") }

    let parent = worker.parent
    # A nullable object field stays a lazy selection in Dang: force a scalar
    # off it to learn whether the parent exists.
    parent.handle rescue {
      e: Error => raise "the worker has no parent"
    }
    if (parent == null) {
      raise "the worker has no parent"
    }
    assert { parent.handle == chief.handle }
    assert { worker.name == "check-worker" }

    # The worker has the inherited git tools and the worker tools, and no
    # chief tools. Tool names may be namespaced when several objects are
    # bound, so match names rather than headings.
    let conversation = worker.snapshot.sync
    assert { recordedUris(conversation) == uris }
    let tools = conversation.tools
    assert { tools.contains("askChief") and tools.contains("pendingOf") and tools.contains("salvagePending") }
    assert { tools.contains("cherryPick") }
    assert { !tools.contains("interruptWorker") and !tools.contains("sendTo") }
    # The worker prompt carries its staff name; the chief prompt is absent.
    let prompts = systemTexts(conversation)
    assert { prompts.filter { t => t.contains("You are a worker agent on a staff") }.length == 1 }
    assert { prompts.any { t => t.contains(workerLine) } }
    assert { !prompts.any { t => t.contains("You can hire and direct a staff") } }
    # `me` is the worker, whose parent is the chief: the roster resolves.
    let scope = conversation.artifacts(include: ["staff/members"])
    assert { scope.dimensionKeys(dimension: "staff-member") == ["chief"] }

    # Reload looks every recorded entry up again in the bound workspace and
    # composes it, refreshing it in place; `me` is the owning agent. The
    # worker stays a worker: the same record, one worker prompt, no chief
    # tools.
    let reloaded = reload(worker)
    assert { recordedUris(reloaded) == uris }
    let reloadedTools = reloaded.tools
    assert { reloadedTools.contains("askChief") and reloadedTools.contains("cherryPick") }
    assert { !reloadedTools.contains("interruptWorker") and !reloadedTools.contains("sendTo") }
    let reloadedPrompts = systemTexts(reloaded)
    assert { reloadedPrompts.filter { t => t.contains(workerLine) }.length == 1 }
    assert { !reloadedPrompts.any { t => t.contains("You can hire and direct a staff") } }

    # Becoming a chief is explicit, and survives another reload. Reseeding
    # applies the promotion to the worker itself, as a reload tool's
    # committed step would.
    let promoted = worker.snapshot.compose(expertise: expertiseAt(source, "dag://staff/agent")).sync
    assert { recordedUris(promoted).length == 3 }
    let promotedTools = promoted.tools
    assert { promotedTools.contains("interruptWorker") and promotedTools.contains("sendTo") }
    assert { promotedTools.contains("askChief") }
    worker.reseed(conversation: promoted)
    let again = reload(worker)
    assert { recordedUris(again).length == 3 }
    assert { again.tools.contains("interruptWorker") and again.tools.contains("askChief") }
    assert { systemTexts(again).filter { t => t.contains(workerLine) }.length == 1 }

    # Composing an entry that is already recorded refreshes it in place
    # rather than recording it twice, and composing nothing changes nothing.
    let twice = worker.snapshot.compose(expertise: expertiseAt(source, "dag://staff/agent"))
    assert { recordedUris(twice) == recordedUris(again) }
    assert { recordedUris(worker.snapshot.compose(expertise: [])) == recordedUris(again) }
    null
  } rescue { e: Error => {
    worker.stop
    chief.stop
    raise e.message
  }}
  worker.stop
  chief.stop
  "Staff worker role checks passed."
}

let testStaffTools(source: Workspace!): String! {
  # LLM.tools renders one "## <name>" heading per tool. spawn takes the
  # calling chief as an Agent argument, which only an owning agent supplies:
  # compose the chief role onto a spawned agent so the conversation has one.
  let unowned = staff.agent(llm.withWorkspace(source)).tools
  assert { !unowned.contains("## spawn\n") and unowned.contains("## sendTo\n") }
  let chief = llm.withWorkspace(source).spawn(name: "tools-check-chief", expertise: expertiseAt(source, "dag://staff/agent"))
  let tools = chief.snapshot.sync.tools
  chief.stop
  ["spawn", "sendTo", "status", "read", "interruptWorker", "pendingOf", "salvagePending"].each { name =>
    assert { tools.contains("## " + name + "\n") }
  }
  # Git operations live in git tools, by address; the roster is reached by
  # address too; bookkeeping and the worker role stay out.
  ["logOf", "diffOf", "pull", "pullConflicted", "pullPending", "pullTools", "peers", "members", "memberAgent", "memberOf", "worker", "workerExpertise", "workerPrompt", "askChief"].each { name =>
    assert { !tools.contains("## " + name + "\n") }
  }
  assert { !tools.contains("withWorker") }
  assert { !tools.contains("checkComposition") }
  assert { !tools.contains("checkFiltering") and !tools.contains("checkTools") }
  "Staff tool visibility checks passed."
}

let testStaffComposition(source: Workspace!): String! {
  # The chief gains a module after staff was composed, from another
  # workspace: the probe stands in for an Editor install. The worker inherits
  # it from the chief's record, still from that origin, while working in the
  # chief's current workspace.
  let origin = directory
    .withNewFile("dagger.toml", """
      [modules.probe]
      source = "probe"
      """)
    .withNewFile("probe/dagger-module.toml", """
      name = "probe"
      engineVersion = "v1.0.0-0"
      [runtime]
      source = "dang"
      """)
    .withNewFile("probe/main.dang", """
      type Probe {
        agent(base: LLM!): LLM! @agent {
          base.withTools(currentNode).withSystemPrompt("origin capabilities")
        }
        originRead(source: Workspace!): String! {
          source.file("marker").contents
        }
      }
      """)
    .asWorkspace
  let chief = llm.withWorkspace(source).spawn(name: "composition-chief", expertise: expertiseAt(source, "dag://staff/agent"))
  chief.reseed(conversation: chief.snapshot.sync.compose(expertise: expertiseAt(origin, "dag://probe/agent")))
  let picked = staff.workerExpertise(chief: chief).{{ id, artifact.{{ moduleName }} }}
  let selected = picked.map { e => node(id: e.id).{{ ... on Expertise! }} }
  let worker = spawnUnder(chief, llm.withWorkspace(source), "composition-worker", selected);
  {
    let modules = picked.map { e => e.artifact.moduleName }
    assert("the worker inherits the chief's probe entry plus staff") { modules == ["probe", "staff"] }
    let conversation = worker.snapshot.sync
    assert { conversation.tools.contains("originRead") and conversation.tools.contains("askChief") }
    assert { systemTexts(conversation).any { t => t == "origin capabilities" } }
    # The worker works in the chief's current workspace, not the origin.
    assert { conversation.workspace.file("staff/main.dang").contents == source.file("staff/main.dang").contents }
    # That workspace has no probe, so reload keeps the recorded entry.
    let reloaded = reload(worker)
    assert { recordedUris(reloaded) == recordedUris(conversation) }
    assert { reloaded.tools.contains("originRead") and reloaded.tools.contains("askChief") }
    null
  } rescue { e: Error => {
    worker.stop
    chief.stop
    raise e.message
  }}
  worker.stop
  chief.stop
  "Staff composition inheritance checks passed."
}

# A Dang module directory: `typeName`'s @agent binds it with `prompt`, and
# its one tool `tool` reads the workspace's marker file.
let agentModule(name: String!, typeName: String!, prompt: String!, tool: String!): Directory! {
  directory
    .withNewFile("dagger-module.toml", [
      `name = "${name}"`,
      `engineVersion = "v1.0.0-0"`,
      "[runtime]",
      `source = "dang"`,
      "",
    ].join("\n"))
    .withNewFile("main.dang", [
      `type ${typeName} {`,
      "  agent(base: LLM!): LLM! @agent {",
      `    base.withTools(currentNode).withSystemPrompt("${prompt}")`,
      "  }",
      `  ${tool}(source: Workspace!): String! {`,
      `    source.file("marker").contents`,
      "  }",
      "}",
      "",
    ].join("\n"))
}

let testStaffCheckout(source: Workspace!): String! {
  let workerLine = `Your staff name is "checkout-worker"`
  # The worker's probe entry is recorded from an origin workspace.
  let origin = directory
    .withNewFile("dagger.toml", "[modules.probe]\nsource = \"probe\"\n")
    .withDirectory("probe", agentModule("probe", "Probe", "origin capabilities", "originRead"))
    .asWorkspace
  # The checkout target installs staff (this repository's), its own version
  # of probe, and a module the worker has never had.
  let tree = directory
    .withNewFile("dagger.toml", [
      "[modules.staff]", `source = "staff"`, "",
      "[modules.probe]", `source = "probe"`, "",
      "[modules.extra]", `source = "extra"`, "",
    ].join("\n"))
    .withNewFile("marker", "target\n")
    .withDirectory("staff", source.directory("/staff"))
    .withDirectory("probe", agentModule("probe", "Probe", "target capabilities", "targetRead"))
    .withDirectory("extra", agentModule("extra", "Extra", "extra capabilities", "extraRead"))
  let fixtureContainer = container
    .from("alpine:3.22")
    .withExec(["apk", "add", "--no-cache", "git", "git-daemon"])
    .withDirectory("/repo", tree)
    .withWorkdir("/repo")
    .withExec(["sh", "-eu", "-c", """
      git init -b main
      git config user.name 'Checkout Test'
      git config user.email checkout@example.com
      export GIT_AUTHOR_DATE=2026-09-15T12:00:00Z
      export GIT_COMMITTER_DATE=$GIT_AUTHOR_DATE
      git add .
      git commit -m target
    """])
  let server = contributorCheckoutServer(fixtureContainer)
  let repo = server.endpoint(port: 9418, scheme: "git") + "/repo"

  let chief = llm.withWorkspace(source).spawn(name: "checkout-chief", expertise: expertiseAt(source, "dag://staff/agent"))
  let worker = spawnUnder(chief, llm.withWorkspace(source), "checkout-worker",
    expertiseAt(origin, "dag://probe/agent") + expertiseAt(source, "dag://staff/worker"));
  {
    let before = worker.snapshot.sync
    assert { before.tools.contains("originRead") and before.tools.contains("askChief") }
    # Pin the continuation: checkout is uncached.
    let switched = contributor.checkout(
      llm: before,
      source: before.workspace,
      repo: contributorCheckoutRef(repo, ""),
    ).sync
    assert { switched.workspace.file("marker").contents == "target\n" }

    # The record keeps its entries and gains only the new module's default:
    # staff is already recorded (as the worker role), so the target's
    # `staff/agent` is not composed and the worker stays a worker.
    let uris = recordedUris(switched)
    assert("checkout adds only the new module's entry") { uris.length == 3 }
    assert("checkout keeps probe and the worker role, then adds extra") { (uris[0] ?? "").contains("probe/agent") and (uris[1] ?? "").contains("staff/worker") and (uris[2] ?? "").contains("extra/agent") }
    assert("checkout does not compose the target's staff/agent") { !uris.any { u => u.contains("staff/agent") } }
    let tools = switched.tools
    assert { tools.contains("askChief") and tools.contains("pendingOf") }
    assert { !tools.contains("interruptWorker") and !tools.contains("sendTo") }
    let prompts = systemTexts(switched)
    assert { prompts.filter { t => t.contains(workerLine) }.length == 1 }
    assert { !prompts.any { t => t.contains("You can hire and direct a staff") } }
    # `me` is still the worker: its chief resolves.
    assert { switched.artifacts(include: ["staff/members"]).dimensionKeys(dimension: "staff-member") == ["chief"] }

    # The recorded probe entry now comes from the target, which provides the
    # same module; the new module's agent is composed on top.
    assert { tools.contains("targetRead") and !tools.contains("originRead") }
    assert { prompts.any { t => t == "target capabilities" } }
    assert { !prompts.any { t => t == "origin capabilities" } }
    assert { tools.contains("extraRead") and prompts.any { t => t == "extra capabilities" } }
    null
  } rescue { e: Error => {
    worker.stop
    chief.stop
    server.stop
    raise e.message
  }}
  worker.stop
  chief.stop
  server.stop
  "Staff checkout adoption checks passed."
}

let testStaffRoleWithoutStaff(source: Workspace!): String! {
  let workerLine = `Your staff name is "roleless-worker"`
  # The checkout target installs only a probe module: no staff.
  let tree = directory
    .withNewFile("dagger.toml", "[modules.probe]\nsource = \"probe\"\n")
    .withNewFile("marker", "target\n")
    .withDirectory("probe", agentModule("probe", "Probe", "target capabilities", "targetRead"))
  let fixtureContainer = container
    .from("alpine:3.22")
    .withExec(["apk", "add", "--no-cache", "git", "git-daemon"])
    .withDirectory("/repo", tree)
    .withWorkdir("/repo")
    .withExec(["sh", "-eu", "-c", """
      git init -b main
      git config user.name 'Checkout Test'
      git config user.email checkout@example.com
      export GIT_AUTHOR_DATE=2026-09-15T12:00:00Z
      export GIT_COMMITTER_DATE=$GIT_AUTHOR_DATE
      git add .
      git commit -m target
    """])
  let server = contributorCheckoutServer(fixtureContainer)
  let repo = server.endpoint(port: 9418, scheme: "git") + "/repo"

  # A chief composed from this workspace checks out the staff-less fixture,
  # adopting its probe, and continues from there.
  let chief = llm.withWorkspace(source).spawn(
    name: "roleless-chief",
    expertise: expertiseAt(source, "dag://committer/agent") + expertiseAt(source, "dag://staff/agent"),
  )
  # Pin the continuation: checkout is uncached.
  let here = contributor.checkout(
    llm: chief.snapshot.sync,
    source: source,
    repo: contributorCheckoutRef(repo, ""),
  ).sync
  chief.reseed(conversation: here)
  # The role is found through the chief's own staff entry, not the chief's
  # current workspace, which has no staff at all.
  let picked = staff.workerExpertise(chief: chief).{{ id, artifact.{{ uri, moduleName }} }}
  let selected = picked.map { e => node(id: e.id).{{ ... on Expertise! }} }
  let worker = spawnUnder(chief, llm.withWorkspace(here.workspace), "roleless-worker", selected);
  {
    assert { here.workspace.file("marker").contents == "target\n" }
    let modules = picked.map { e => e.artifact.moduleName }
    assert("the worker inherits committer and probe plus staff") { modules == ["committer", "probe", "staff"] }
    let uris = picked.map { e => e.artifact.uri }
    assert("the worker role comes from the chief's staff entry") { (uris[2] ?? "").contains("staff/worker") }
    assert { here.workspace.artifacts.filterUri(uri: "dag://staff/worker").asExpertise.{{ id }}.isEmpty }

    let conversation = worker.snapshot.sync
    let tools = conversation.tools
    assert { tools.contains("askChief") and tools.contains("pendingOf") and tools.contains("targetRead") and tools.contains("cherryPick") }
    assert { !tools.contains("interruptWorker") and !tools.contains("sendTo") }
    let prompts = systemTexts(conversation)
    assert { prompts.filter { t => t.contains(workerLine) }.length == 1 }
    assert { !prompts.any { t => t.contains("You can hire and direct a staff") } }
    assert { conversation.artifacts(include: ["staff/members"]).dimensionKeys(dimension: "staff-member") == ["chief"] }

    # Reload in that staff-less workspace keeps the recorded role: the
    # lookup finds no dag://staff/worker there and falls back to the record.
    let reloaded = reload(worker)
    assert { recordedUris(reloaded) == recordedUris(conversation) }
    let reloadedTools = reloaded.tools
    assert { reloadedTools.contains("askChief") and reloadedTools.contains("pendingOf") and reloadedTools.contains("targetRead") and reloadedTools.contains("cherryPick") }
    assert { !reloadedTools.contains("interruptWorker") and !reloadedTools.contains("sendTo") }
    let reloadedPrompts = systemTexts(reloaded)
    assert { reloadedPrompts.filter { t => t.contains(workerLine) }.length == 1 }
    assert { !reloadedPrompts.any { t => t.contains("You can hire and direct a staff") } }
    null
  } rescue { e: Error => {
    worker.stop
    chief.stop
    server.stop
    raise e.message
  }}
  worker.stop
  chief.stop
  server.stop
  "Staff worker role without staff checks passed."
}
