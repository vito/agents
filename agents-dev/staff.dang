let testStaffFiltering(source: Workspace!): String! {
  let root = "staff-glob-check-" + Random.string
  let base = source.git.head.asWorkspace
  let working = base
    .withNewFile(root + "/one.go", "one\n")
    .withNewFile(root + "/nested/two.go", "two\n")
    .withNewFile(root + "/nested/keep.txt", "unselected\n")
  let worker = llm.withWorkspace(working).spawn(name: "filter-fixture")
  let fixture = staff.withWorker("fixture", worker)
  let patch = fixture.pendingOf(name: "fixture", paths: [root + "/**/*.go"])
  assert { patch.contains("+one") and patch.contains("+two") }
  assert { !patch.contains("keep.txt") }
  let none = fixture.pendingOf(name: "fixture", paths: [root + "/**/*.rs"])
  assert { none.contains("no uncommitted changes") }
  # The escape hatch points committed work at its address, not at a verb.
  assert { none.contains("dag://staff/members/head?member=fixture") }
  worker.stop

  # Exercise literal drift filtering through salvagePending. All other pending
  # changes are already present in the chief: interpreting a filename as a glob
  # would try to reapply those additions and fail (or take the wrong files).
  let seeded = base
    .withNewFile(root + "/old name.txt", "rename\n")
    .withNewFile(root + "/delete me.txt", "remove\n")
  let before = seeded.withCommit(changes: seeded.git.uncommitted,
    message: "fixture", date: "2026-09-15T12:00:00Z")
  let after = before.withoutFile(root + "/old name.txt").withoutFile(root + "/delete me.txt")
    .withNewFile(root + "/new name.txt", "rename\n")
  let names = [
    "space name.txt", "tab\tname.txt", "line\nname.txt", "quote\"name.txt",
    "back\\slash.txt", "[literal].txt", "*.txt", "?.txt", "!literal.txt",
    " leading.txt", "trailing.txt ", "a/inside.txt", "a/nested/leaf.txt", "outside.txt"
  ]
  names.each { name =>
    let tree = after.directory("/")
    after = after.withChanges(tree.withNewFile(root + "/" + name, "added\n").changes(from: tree))
  }
  let literalWorker = llm.withWorkspace(after).spawn(name: "literal-filter-fixture")
  let literalFixture = staff.withWorker("fixture", literalWorker);
  {
    names.each { name =>
      # Directory.withoutFile accepts globs; build the sibling set explicitly
      # so names such as *.txt remain literal fixture data.
      let siblings = directory.withNewFile("new name.txt", "rename\n")
      names.filter { candidate => candidate != name }.each { sibling =>
        siblings = siblings.withNewFile(sibling, "added\n")
      }
      let tree = after.directory("/")
      let chief = after.withChanges(tree.withoutDirectory(root).withDirectory(root, siblings).changes(from: tree))
      let selected = literalFixture.salvagePending(source: chief, name: "fixture")
      assert { selected.diffStats.{{path}}.map { s => s.path }.filter { p => !p.hasSuffix("/") } == [root + "/" + name] }
      assert { selected.asPatch.contents.contains("+added") }
      assert { chief.directory("/").withChanges(selected).changes(from: after.directory("/")).isEmpty }
    }
    let withoutDir = after.withoutDirectory(root + "/a")
    let directoryDelta = literalFixture.salvagePending(source: withoutDir, name: "fixture")
    assert { directoryDelta.diffStats.{{path}}.map { s => s.path }.filter { p => !p.hasSuffix("/") } == [root + "/a/inside.txt", root + "/a/nested/leaf.txt"] }
    assert { literalFixture.salvagePending(source: after, name: "fixture").isEmpty }
    assert { literalFixture.salvagePending(source: before, name: "fixture").asPatch.contents == after.git.uncommitted.asPatch.contents }
    let undeleted = after.withNewFile(root + "/delete me.txt", "remove\n")
    assert { literalFixture.salvagePending(source: undeleted, name: "fixture").removedPaths == [root + "/delete me.txt"] }
    let oldOnly = after.withNewFile(root + "/old name.txt", "rename\n")
    assert { literalFixture.salvagePending(source: oldOnly, name: "fixture").removedPaths == [root + "/old name.txt"] }
    let newOnly = after.withoutFile(root + "/new name.txt")
    assert { literalFixture.salvagePending(source: newOnly, name: "fixture").addedPaths == [root + "/new name.txt"] }
    let unrenamed = newOnly.withNewFile(root + "/old name.txt", "rename\n")
    let renamed = literalFixture.salvagePending(source: unrenamed, name: "fixture")
    assert { renamed.diffStats.{{kind}}.map { s => s.kind } == [DiffStatKind.RENAMED] }
    null
  } rescue { e: Error => {
    literalWorker.stop
    raise e.message
  }}
  literalWorker.stop
  "Staff filtering checks passed."
}

let testStaffMembers(source: Workspace!): String! {
  let base = source.git.head.asWorkspace
  let root = "staff-members-check-" + Random.string
  let edited = base.withNewFile(root + "/note.txt", "member\n")
  let committed = edited.withCommit(
    changes: edited.git.uncommitted,
    message: "fixture: member commit",
    date: "2026-09-15T12:00:00Z",
  )
  let idle = llm.withWorkspace(base).spawn(name: "members-idle")
  let ahead = llm.withWorkspace(committed).spawn(name: "members-ahead")
  let roster = staff.withWorker("idle", idle).withWorker("ahead", ahead);
  {
    # The engine projects a @collection to keys/list/get/subset.
    let members = roster.members
    assert { members.keys == ["ahead", "idle"] }
    assert { members.list.{{name}}.map { m => m.name } == ["ahead", "idle"] }
    let picked = members.get(key: "ahead")
    assert { picked.name == "ahead" }
    assert { picked.head.commitSHA == committed.git.head.commitSHA }
    assert { picked.workspace.file(root + "/note.txt").contents == "member\n" }
    assert { members.get(key: "idle").head.commitSHA == base.git.head.commitSHA }
    assert { members.subset(keys: ["ahead"]).keys == ["ahead"] }
    let missing = members.get(key: "nobody").name rescue { e: Error => e.message }
    assert { missing.contains("nobody") }
    # An empty roster is an empty collection, not an error.
    assert { staff.members.keys == [] }

    # A member's head is an artifact: the collection field on the module's
    # main object contributes a `member` dimension to the workspace schema,
    # and `head` is a GitRef path under it.
    let selected = source.artifacts.filterPathPattern(pattern: "staff/**")
    let dimensions = selected.dimensionDefinitions.{{identifier, name, itemType}}
    assert { dimensions.any { d => d.identifier == "/staff/members" and d.name == "member" and d.itemType == "Member" } }
    let paths = selected.pathDefinitions.{{uri, dimensions}}
    assert { paths.any { p => p.uri == "dag://staff/members/head" and p.dimensions.contains("/staff/members") and p.dimensions.contains("type:GitRef") } }
    # Exactly one `members` tree: the worker's Peers is minted by a function
    # with a required argument, so it adds no second `member` dimension (no
    # staff/pull-tools/members) that would make the address ambiguous.
    assert { dimensions.filter { d => d.name == "member" }.map { d => d.identifier } == ["/staff/members"] }
    assert { !paths.any { p => p.uri.contains("pull-tools") or p.uri.contains("peers") } }

    # In a chief's scope the address resolves against its live roster, even
    # though the chief does not get `members` as a tool.
    let scope = llm.withWorkspace(base).withTools(roster, except: ["members"]).artifacts(include: ["staff/members"])
    assert { scope.dimensionKeys(dimension: "member") == ["ahead", "idle"] }
    let head = scope.filterUri(uri: "dag://staff/members/head?member=ahead").one.value.{{... on GitRef!}}
    assert { head.commitSHA == committed.git.head.commitSHA }
    null
  } rescue { e: Error => {
    idle.stop
    ahead.stop
    raise e.message
  }}
  idle.stop
  ahead.stop
  "Staff members collection checks passed."
}

let testStaffPeers(source: Workspace!): String! {
  let base = source.git.head.asWorkspace
  let root = "staff-peers-check-" + Random.string
  let edited = base.withNewFile(root + "/chief.txt", "chief\n")
  let chiefWorkspace = edited.withCommit(
    changes: edited.git.uncommitted,
    message: "fixture: chief commit",
    date: "2026-09-15T12:00:00Z",
  )
  let early = llm.withWorkspace(base).spawn(name: "peers-early")
  let late = llm.withWorkspace(base.withNewFile(root + "/late.txt", "unfinished\n")).spawn(name: "peers-late")
  # The chief's conversation binds its Staff, as Staff.agent does; the
  # roster a worker sees is read from there.
  let hiredEarly = staff.withWorker("early", early)
  let chief = llm.withWorkspace(chiefWorkspace).withTools(hiredEarly, except: ["members"]).spawn(name: "peers-chief")
  let peers = staff.peers(chief: chief, name: "early");
  {
    # The worker itself is left out; the chief is always there.
    assert { peers.members.keys == ["chief"] }
    let own = peers.members.get(key: "early").name rescue { e: Error => e.message }
    assert { own.contains("early") }

    # The chief hires `late` after `early` was spawned: its next committed
    # step binds the grown roster. Reseeding stands in for that step without
    # a model call. The SAME Peers object now sees the new worker.
    chief.reseed(conversation: llm.withWorkspace(chiefWorkspace).withTools(hiredEarly.withWorker("late", late), except: ["members"]))
    assert { peers.members.keys == ["chief", "late"] }
    assert { peers.members.get(key: "chief").head.commitSHA == chiefWorkspace.git.head.commitSHA }
    assert { peers.members.get(key: "late").head.commitSHA == base.git.head.commitSHA }

    # A worker's scope resolves the same addresses through its bound Peers,
    # bound as spawn binds it: `members` is not a tool, yet still a tree.
    let scope = llm.withWorkspace(base).withTools(peers, except: ["members"]).artifacts(include: ["staff/members"])
    assert { scope.dimensionKeys(dimension: "member") == ["chief", "late"] }
    let head = scope.filterUri(uri: "dag://staff/members/head?member=chief").one.value.{{... on GitRef!}}
    assert { head.commitSHA == chiefWorkspace.git.head.commitSHA }

    # The escape hatches reach any member, chief included.
    let pending = peers.pendingOf(name: "late")
    assert { pending.contains(root + "/late.txt") and pending.contains("+unfinished") }
    assert { peers.pendingOf(name: "chief").contains("no uncommitted changes") }
    assert { peers.salvagePending(source: base, name: "late").addedPaths.filter { p => !p.hasSuffix("/") } == [root + "/late.txt"] }

    # Workers get the roster and escape hatches, never orchestration. Bound
    # as spawn binds it: the roster is reached by address, not as a tool.
    let tools = llm.withWorkspace(base).withTools(peers, except: ["members"]).tools
    ["pendingOf", "salvagePending"].each { name =>
      assert { tools.contains("## " + name + "\n") }
    }
    ["spawn", "sendTo", "interruptWorker", "logOf", "pullPending", "members"].each { name =>
      assert { !tools.contains("## " + name + "\n") }
    }
    null
  } rescue { e: Error => {
    early.stop
    late.stop
    chief.stop
    raise e.message
  }}
  early.stop
  late.stop
  chief.stop
  "Staff peers checks passed."
}

let testStaffTools(source: Workspace!): String! {
  # LLM.tools renders one "## <name>" heading per tool.
  let tools = staff.agent(llm.withWorkspace(source)).tools
  ["spawn", "sendTo", "status", "read", "interruptWorker", "pendingOf", "salvagePending"].each { name =>
    assert { tools.contains("## " + name + "\n") }
  }
  # Git operations live in git tools, by address; the roster is reached by
  # address too; bookkeeping stays out.
  ["logOf", "diffOf", "pull", "pullConflicted", "pullPending", "pullTools", "peers", "members", "memberAgent", "memberOf"].each { name =>
    assert { !tools.contains("## " + name + "\n") }
  }
  assert { !tools.contains("withWorker") }
  assert { !tools.contains("withCompositionSource") and !tools.contains("workerBase") }
  assert { !tools.contains("checkComposition") }
  assert { !tools.contains("checkFiltering") and !tools.contains("checkTools") }
  "Staff tool visibility checks passed."
}

let testStaffComposition: String! {
  let origin = directory
    .withNewFile("dagger.toml", """
      [env.dev.modules.probe]
      source = "probe"
      [modules.staff]
      source = "staff"
      """)
    .withNewFile("probe/dagger-module.toml", """
      name = "probe"
      engineVersion = "v1.0.0-0"
      [runtime]
      source = "dang"
      """)
    .withNewFile("probe/main.dang", """
      type Probe {
        agent(base: LLM!): LLM! @agent {
          base.withTools(currentNode)
            .withModel("origin-model")
            .withSystemPrompt(`origin capabilities for ${base.workspace.file("marker").contents}`)
        }
        originRead(source: Workspace!): String! {
          source.file("marker").contents
        }
        originWrite(source: Workspace!): Changeset! {
          source.directory("/").withNewFile("written", "worker")
            .changes(from: source.directory("/"))
        }
      }
      """)
    .withNewFile("staff/dagger-module.toml", """
      name = "staff"
      engineVersion = "v1.0.0-0"
      [runtime]
      source = "dang"
      """)
    .withNewFile("staff/main.dang", """
      type Staff {
        agent(base: LLM!): LLM! @agent {
          raise "staff orchestration must be excluded"
        }
      }
      """)
    .withNewFile("marker", "origin")
    .asWorkspace.withConfigEnvironment("dev")
  let target = directory.withNewFile("marker", "checkout with pending edits").asWorkspace
  let fixture = staff.withCompositionSource(origin)
  let worker = fixture.workerBase(target).sync
  assert { worker.tools.contains("originRead") and worker.tools.contains("originWrite") }
  assert { worker.workspace.file("marker").contents == "checkout with pending edits" }
  assert { worker.model == "origin-model" }
  assert { worker.messages.{{role}}.all { m => m.role == LLMMessageRole.SYSTEM } }
  assert { worker.messages.{{content.{{text}}}}.any { m =>
    m.content.any { c => (c.text ?? "").contains("origin capabilities for checkout with pending edits") }
  } }
  assert { fixture.workerBase(target, model: "fixture-model").model == "fixture-model" }

  # Roster mutations must preserve the saved origin; no turn is started.
  let handle = worker.spawn(name: "composition-fixture")
  let roster = fixture.withWorker("fixture", handle)
  assert { roster.workerBase(target).tools.contains("originRead") }
  handle.stop

  # A destination with agent code is not implicitly trusted or composed.
  let hostile = origin.withNewFile("probe/main.dang", """
    type Probe {
      agent(base: LLM!): LLM! @agent {
        raise "destination agents must not execute"
      }
    }
    """)
  assert { fixture.workerBase(hostile).tools.contains("originRead") }
  assert { origin.file("marker").contents == "origin" }
  # Preserve direct API use when no chief composition has captured an origin.
  assert { staff.workerBase(origin).tools.contains("originRead") }
  "Staff checkout composition checks passed."
}
