# reviewer-driver: the recorded-turn pipeline check for the reviewer module,
# run by agents-dev's reviewerPipeline as a module of a plain-directory
# fixture workspace (this module, reviewer, committer and contributor).
#
# A plain directory on purpose: the engine gates LLM.loop/step made from a
# git-sourced module behind an interactive "Allow LLM access?" prompt
# (core/llm.go LLM.allowed), which a check cannot answer. An agent's loop
# runs under the client that started it, so the sub-agents must be spawned
# and sent their tasks from modules loaded here, not from agents-dev.
#
# No model is called: reviewer's withRecordedReplies makes `review` spawn
# each finder, voter and the synthesizer on a `recording/` model that
# replays its history and a canned final reply. Everything else is the real
# pipeline: composition from the caller's record, parallel finders,
# mechanical evidence checks, voters, severity from hunks, the synthesis,
# and the summary.
type ReviewerDriver {
  """
  A STANDARD review of a fixture range: three finders in parallel (one
  finding duplicated word for word across two finders, one restated in
  other words quoting another line, a different problem quoting the same
  line as another, one with evidence that is not in the file, a concern
  citing two places), the triage merging the restated one, voters per
  finding by severity (three, two or one), a tie-break voter for the
  concern's split, the synthesizer, and the summary.
  """
  pipeline(source: Workspace!): Void @check {
    let repo = container
      .from("alpine:3.22")
      .withExec(["apk", "add", "--no-cache", "git"])
      .withWorkdir("/repo")
      .withExec(["sh", "-eu", "-c", fixtureScript])
      .directory("/repo")
      .asGit
    let entries = entriesAt(source, "dag://committer/agent")
      + entriesAt(source, "dag://contributor/agent")
      + entriesAt(source, "dag://reviewer/agent")
    # The recorded task messages carry the attribution header of whichever
    # agent runs this check (CallerAgent propagates into module calls).
    let from = callingAgentName("reviewer-origin-probe")
    let chief = llm.withWorkspace(source).spawn(name: "review-chief", expertise: entries)

    let discount = finding("calc.py", 2, discountClaim, "rate = percent / 10", "correctness")
    let concern = JSON.encode({{
      severity: "CONCERN", claim: concernClaim, category: "design", causedByChange: true,
      locations: [
        {{path: "calc.py", line: 18, evidence: "return eval(x)"}},
        {{path: "calc.py", line: 1, evidence: "def discount(total, percent):"}},
      ],
    }})
    let sameLine = JSON.encode({{
      severity: "NIT", claim: negativeClaim, category: "correctness", causedByChange: true,
      locations: [{{path: "calc.py", line: 2, evidence: "rate = percent / 10"}}],
    }})
    let finders = [
      findings([discount, finding("calc.py", 2, "percent is divided by one hundred too often", "rate = percent / 100", "correctness")]),
      findings([finding("calc.py", 18, evalClaim, "return eval(x)", "security"), concern, finding("calc.py", 3, restatedClaim, "return total - total * rate", "correctness")]),
      findings([discount, sameLine, finding("calc.py", 8, "an item without a price raises AttributeError", "result += item.price", "fit")]),
    ]
    # Held, in order: 1 discount, 2 eval, 3 concern, 4 restated discount,
    # 5 the other problem on calc.py:2, 6 item.price.
    let grouped = JSON.encode({{groups: [{{findings: [1, 4], keep: 1, why: "divides by ten instead of a hundred"}}]}})
    let voters = [
      vote("CONFIRM"), vote("CONFIRM"), vote("CONFIRM"),
      vote("CONFIRM"), vote("REJECT"), vote("CONFIRM"),
      voteAs("CONFIRM", "CONCERN"), voteAs("REJECT", "CONCERN"),
      voteAs("CONFIRM", "NIT"),
      vote("REJECT"), vote("REJECT"), vote("CONFIRM"),
    ]
    let synthesis = JSON.encode({{verdict: verdictText, sound: ["total() still sums prices"]}})
    # One selection, so the uncached review runs exactly once.
    let out = reviewer
      .withRecordedReplies(origin: from, finders: finders, voters: voters, synthesis: synthesis, triageReply: grouped, tieBreakers: [voteAs("CONFIRM", "CONCERN")])
      .review(caller: chief, source: source, head: repo.branch("feature"), base: repo.branch("main"), depth: ReviewerDepth.STANDARD)
      .{{ summary: lastSummary, open: findingsList(status: ReviewerFindingStatus.OPEN) }} rescue {
        e: Error => {
          chief.stop
          raise "review failed: " + e.message
        }
      }
    chief.stop

    let summary = out.summary
    print(summary)
    let lines = summary.split("\n")
    assert(message: summary) { (lines[0] ?? "") == "1 important, 1 concern, 1 nit, 1 pre-existing" }
    assert(message: summary) { (lines[2] ?? "") == "Verdict: " + verdictText and (lines[4] ?? "") == "IMPORTANT:" }
    assert(message: summary) { summary.contains("\n\nChecked and found sound:\n- total() still sums prices\n\nReviewed ") }
    # The restated bug merged into the first, by the triage: one entry,
    # both locations, IMPORTANT's three voters.
    assert(message: summary) { summary.contains("IMPORTANT:\n- calc.py:2 — " + discountClaim + "\n      rate = percent / 10\n  also at calc.py:3 · 3/3 votes · fingerprint ") }
    assert(message: summary) { !summary.contains(restatedClaim) }
    # The other problem quoting the same line survives as its own NIT, on
    # its one voter; the concern's two voters split, and a third confirms.
    assert(message: summary) { summary.contains("NIT:\n- calc.py:2 — " + negativeClaim + "\n  1/1 votes · fingerprint ") }
    assert(message: summary) { summary.contains("CONCERN:\n- calc.py:1 — " + concernClaim) and summary.contains("  also at calc.py:18 · 2/3 votes · fingerprint ") }
    assert(message: summary) { summary.contains("- calc.py:18 — " + evalClaim + "\n      return eval(x)\n  2/3 votes · fingerprint ") }
    assert(message: summary) { summary.contains("Merged as duplicates: calc.py:2 (design) into calc.py:2: identical; calc.py:3 (behavior: \"a 50 percent discount takes off five times the total") and summary.contains("…\") into calc.py:2: divides by ten instead of a hundred") }
    assert(message: summary) { summary.contains("Dropped by the evidence checks (1):") and summary.contains("quoted evidence does not appear") }
    assert(message: summary) { summary.contains("Below quorum: calc.py:8 (1/3, needed 2)") }
    assert(message: summary) { !summary.contains("failed:") and !summary.contains("Triage:") }
    # One footer line: the sub-agents, what they were composed from, and
    # what failing tests under them are.
    let footers = lines.filter { l => l.hasPrefix("Reviewed ") }
    let footer = footers[0] ?? ""
    assert(message: summary) { footer.contains(" at STANDARD depth (votes needed: important 2 of 3, concern 2 of 2 or 2 of 3 on a split, nit 1 of 1): 3 finders, triage, 13 voters, synthesizer; composed from ") }
    assert(message: summary) { footer.contains("are the reviewers' own reproductions") }
    ["committer/readonly", "contributor/readonly", "reviewer/finder", "reviewer/triage", "reviewer/voter", "reviewer/synthesizer"].each { u =>
      assert(message: footer) { footer.contains(u) }
    }
    ["committer/agent", "contributor/agent", "reviewer/agent"].each { u =>
      assert(message: footer) { !footer.contains(u) }
    }
    assert(message: out.open) { out.open.split("\n").filter { l => l.hasPrefix("OPEN") }.length == 4 }
    null
  }
}

let discountClaim: String! = "percent / 10 divides by ten instead of a hundred, so a 50 percent discount takes off five times the total"
let restatedClaim: String! = "a 50 percent discount takes off five times the total, so the discounted price goes negative"
let negativeClaim: String! = "percent is never checked, so a negative percent raises the price instead of lowering it"
let evalClaim: String! = "legacy passes its argument to eval, so any caller-supplied string runs as code"
let concernClaim: String! = "discount assumes percent is a whole number, which no caller states"
let verdictText: String! = "The change adds a discount helper whose rate is off by a factor of ten."

let fixtureScript: String! = """
  git init -q -b main
  git config user.name 'Review Test'
  git config user.email review@example.com
  export GIT_AUTHOR_DATE=2026-09-15T12:00:00Z
  export GIT_COMMITTER_DATE=$GIT_AUTHOR_DATE
  printf '%s\n' 'def total(items):' '    result = 0' '    for item in items:' '        result += item.price' '    return result' '' 'def one():' '    return 1' '' 'def two():' '    return 2' '' 'def legacy(x):' '    return eval(x)' > calc.py
  git add .
  git commit -q -m 'fixture: base'
  git checkout -q -b feature
  { printf '%s\n' 'def discount(total, percent):' '    rate = percent / 10' '    return total - total * rate' ''; cat calc.py; } > calc.new
  mv calc.new calc.py
  git commit -q -am 'calc: add discount'
"""

let finding(path: String!, line: Int!, claim: String!, evidence: String!, category: String!): String! {
  JSON.encode({{path: path, line: line, claim: claim, evidence: evidence, category: category, severity: "IMPORTANT"}})
}

let findings(items: [String!]!): String! {
  "{\"findings\": [" + items.join(", ") + "]}"
}

let vote(verdict: String!): String! {
  JSON.encode({{verdict: verdict, severity: "IMPORTANT", reason: "checked in the workspace"}})
}

let voteAs(verdict: String!, severity: String!): String! {
  JSON.encode({{verdict: verdict, severity: severity, causedByChange: true, reason: "checked in the workspace"}})
}

let entriesAt(ws: Workspace!, uri: String!): [Expertise!]! {
  ws.artifacts.filterUri(uri: uri).asExpertise.{{ id }}.map { node(id: _.id).{{ ... on Expertise! }} }
}

# The name of the agent on whose behalf this code runs, as a send from here
# attributes it, or "" when no agent is calling. A throwaway agent with an
# empty recording receives one message (its first step then fails) and the
# recorded message's origin names the sender.
let callingAgentName(label: String!): String! {
  let probe = llm.withModel("recording/" + "[]".toBase64).spawn(name: label)
  probe.send("who is calling?")
  probe.wait
  let msgs = probe.snapshot.sync.messages.{{ id }}
  probe.stop
  let first = msgs[0]
  if (first == null) {
    raise "the origin probe recorded no message"
  }
  let name = node(id: first.id).{{ ... on LLMMessage! }}.origin.agentName rescue { e: Error => "" }
  name ?? ""
}
