# sandbox: a LAST-RESORT escape hatch for Dagger coding agents — run an argv
# in an arbitrary container ("sandbox") with the workspace copied in at a
# workdir.
#
# Coding agents normally get curated tools (checks, generators, editor tools);
# this module is for the rest: ad-hoc commands that need a real container.
# Session state lives in `let` fields (default-cached exec + nonce
# cache-busting, per-call workspace copying), following the Map-state pattern
# of the staff module.
#
# Sandbox definitions are artifacts: any zero-arg Container-returning field of
# a workspace module (this module's own `demo`, `git` and `dang` included) has
# a DAG address like dag://sandbox/dang, and FindArtifacts(type: "Container")
# lists them. There is no catalog tool here; discovery is the engine's.
#
# Mechanics per session (a named entry in the private maps):
#   - `exec` copies the caller's workspace to /workspace in the sandbox
#     container, runs the argv there, and stores the resulting container
#     plus the workspace tree that was copied in (the "before" for change
#     extraction).
#   - `changes` extracts /workspace's drift from that before-tree as a
#     Changeset — the tool layer auto-applies a returned Changeset to the
#     workspace, so returning it IS delivery.
#   - Freshness rule: a CONTINUED session only re-copies the CURRENT
#     workspace when the sandbox holds no un-extracted /workspace changes;
#     otherwise the container tree is kept (so nothing is clobbered) and a
#     note points at `changes`. A dirty session whose tree already MATCHES
#     the current workspace (its extraction was applied) self-heals to
#     clean — see the drift check in exec.
#   - Git: the sandbox gets a real checkout (.git included), so git works
#     there as an escape hatch for operations the git tools lack (e.g.
#     `git revert`). But raw .git writes never reach a Changeset: `changes`
#     and every dirtiness check diff the working tree only. Commits made in
#     the sandbox come back as HISTORY instead — the sandbox's .git reopened
#     with GitRepository.withContents, keeping the workspace repository's
#     URL and remotes — exposed as
#     `dag://sandbox/sessions/head?sandbox-session=<name>` for any tool that
#     takes a GitRef (cherry-pick, rebase, show...). A session holding
#     commits the workspace lacks counts as dirty, so a re-copy never
#     discards them.
#
# NOTE on the sandbox arg: it is typed Container! and resolved at the
# CALLER's boundary, never in this module. The tool layer lifts an address
# string — an image ref like "golang:1.26", a DAG address like
# "dag://<module>/<function>" naming a workspace module's Container
# artifact, or a Container ID from a prior result — against the session's
# bound workspace (core/llm_object_tools.go, liftableObjectArg), and the CLI
# does the same for --sandbox flags in workspace mode. That is what makes
# sibling module refs work: an in-module address() call would resolve in
# THIS module's schema, where installed workspace siblings are not
# demand-loadable (hack/designs/sandboxes.md §4, "Resolution context is the
# point").
#
# NOT registered in dagger.toml: install per workspace where wanted
# (hack/designs/sandboxes.md §3: not installed by default anywhere).

let workdir = "/workspace"
let dangVersion = "v2.1.3"

# "" means the implicit session, kept under a reserved name.
let sessionName(session: String!): String! {
  if (session == "") { "last" } else { session }
}

# Build the sandbox's workspace like a local clone: reconstruct the checkout
# from the host git session, then overlay the pending workspace edits
# (Workspace.git.uncommitted: modified and untracked files, gitignored ones
# left out as git status would). This avoids syncing the entire host
# directory on each exec. Non-git workspaces retain the directory-copy
# behavior.
let workspaceTree(ws: Workspace!): Directory! {
  {
    let git = ws.git
    git.head.tree(discardGitDir: false, depth: 0, includeTags: true)
      .withChanges(git.uncommitted)
      .sync
  } rescue {
    e: Error => ws.directory("/")
  }
}

# A tree without its git metadata: raw .git writes (an index refreshed by
# `git status`, new objects) are never workspace changes. Commits travel as
# history instead; see Sandbox.sessions.
let worktree(dir: Directory!): Directory! {
  dir.withoutDirectory(".git")
}

# The working-tree changes a session container holds relative to `before`.
let drift(after: Container!, before: Directory!): Changeset! {
  worktree(after.directory(workdir)).changes(worktree(before))
}

# A session's checkout reopened as git history: the sandbox's .git as the
# storage, the workspace repository's URL and remotes as the routing.
let history(repo: GitRepository!, after: Container!): GitRepository! {
  repo.withContents(directory: after.directory(workdir))
}

# The session's HEAD when it has moved off `seed`, the commit its checkout
# was copied at; "" when it has not moved or has no git history.
let movedHead(seed: String!, repo: GitRepository, after: Container!): String! {
  if (seed == "") {
    return ""
  }
  let r = repo
  if (r == null) {
    return ""
  }
  let head = history(r, after).head.commitSHA rescue {
    e: Error => seed
  }
  if (head == seed) { "" } else { head }
}

# The session's uncommitted changes: its working tree against `before` plus
# whatever the session committed since `seed`. Committed work travels as
# history, so it must not ALSO come back as edits.
let pending(after: Container!, before: Directory!, seed: String!, repo: GitRepository): Changeset! {
  let r = repo
  if (r == null) {
    return drift(after, before)
  }
  if (movedHead(seed, r, after) == "") {
    return drift(after, before)
  }
  let h = history(r, after)
  let committed = h.head.tree(discardGitDir: true)
    .changes(h.ref(name: seed).tree(discardGitDir: true))
  worktree(after.directory(workdir)).changes(worktree(before).withChanges(committed))
}

# How many commits the session's HEAD has on top of `seed`.
let newCommits(seed: String!, repo: GitRepository, after: Container!): Int! {
  if (seed == "") {
    return 0
  }
  let r = repo
  if (r == null) {
    return 0
  }
  let h = history(r, after)
  h.head.log(limit: 1000, base: h.ref(name: seed)).{{sha}}.length rescue {
    e: Error => 0
  }
}

let historyAddress(name: String!): String! {
  `dag://sandbox/sessions/head?sandbox-session=${name}`
}

"""
Run ad-hoc commands in arbitrary containers with the workspace copied in —
the last-resort escape hatch when no curated tool fits.
"""
type Sandbox {
  # ---- session state --------------------------------------------------------
  # Keyed by session name. Map[...] cannot be exposed through module API, so
  # these stay private `let` fields; engine-object handles (Container,
  # Directory) serialize as IDs in module state and rehydrate on the next
  # call (the modules/staff pattern).

  # container as it was after the session's last exec
  let afters: Map[Container!]! = [:]
  # workspace tree copied in at session start / last refresh — the "before"
  # side of change extraction
  let befores: Map[Directory!]! = [:]
  # For sessions copied from a git workspace: the HEAD commit the copy was
  # taken at, and the workspace repository whose routing (URL, remotes) the
  # session's history keeps. Absent for non-git workspaces.
  let seeds: Map[String!]! = [:]
  let repos: Map[GitRepository!]! = [:]

  """
  Compose the sandbox tools onto a base LLM.
  """
  agent(base: LLM!): LLM! @agent {
    # The sandbox definitions stay artifacts (dag://sandbox/dang), not tools:
    # they are reached by address as exec's `sandbox`. Likewise session
    # histories (dag://sandbox/sessions/head?sandbox-session=<name>), whose
    # collection and plumbing are not tools either.
    base
      .withTools(currentNode, except: ["demo", "git", "dang", "sessions", "sessionHead"])
      .withSystemPrompt(systemPrompt)
  }

  """
  A demo sandbox: plain alpine.

  Guarantees any workspace with this module installed one resolvable
  Container address ("dag://sandbox/demo"), and serves as the module-ref
  test target.
  """
  demo: Container! {
    container.from("alpine:3.20")
  }

  """
  A lightweight sandbox for Git operations.
  """
  git: Container! {
    container
      .from("alpine:3.20")
      .withExec(["apk", "add", "--no-cache", "git"])
  }

  """
  A sandbox with the Dang CLI installed.
  """
  dang: Container! {
    container
      .from("golang:1.25")
      .withExec(["go", "install", "github.com/vito/dang/v2/cmd/dang@" + dangVersion])
  }

  """
  Run an argv in a sandbox container with the workspace copied to /workspace.

  This is a LAST RESORT: prefer curated tools (checks, generators, editor
  tools) whenever one fits. The workspace is COPIED in, never mounted — the
  real workspace only changes when you pull the sandbox's edits back out
  with `changes`.
  """
  exec(
    ws: Workspace!,
    """
    The sandbox container to run in: an image ref like "golang:1.26", a
    sandbox definition by DAG address like "dag://sandbox/dang"
    (FindArtifacts(type: "Container") lists them), or a Container ID from a
    prior result. Ignored when continuing an existing session — the
    session's stored container is used — unless `fresh`.
    """
    sandbox: Container!,
    """
    The argv to run, e.g. ["sh", "-c", "ls -la"]. Run with expect: ANY — a
    nonzero exit is reported, not raised.
    """
    args: [String!]!,
    """
    Named session to continue or create; "" runs ephemerally (state is still
    tracked under the implicit name "last" so changes can be pulled).
    """
    session: String! = "",
    """
    Drop the stored session state first and start over from `sandbox`.
    """
    fresh: Boolean! = false,
  ): Sandbox! {
    # Default caching, deliberately. Every exec returns a new state, so an
    # agent's next call always has a different receiver and really runs; a
    # cache hit means the same state, workspace and args as a run that
    # already happened. That is exactly what re-evaluating a chain needs —
    # a resumed agent (or a client like Dang forcing a chain once per
    # selection) rebuilds its session state from cache instead of re-running
    # every command in it. The nonce env var below only ensures that when
    # this function body DOES run, the command does too, rather than hitting
    # the container exec cache for an identical chain.
    let name = sessionName(session)
    if (fresh) {
      self.afters = self.afters.without(name)
      self.befores = self.befores.without(name)
      self.seeds = self.seeds.without(name)
      self.repos = self.repos.without(name)
    }

    let current = workspaceTree(ws)

    # The container to exec in, the "before" tree in effect for this session
    # after this call, and the session's git seed (see `seeds`/`repos`).
    let ctr = container
    let sessionBefore = current
    let copied = true
    let seed = self.seeds[name] ?? ""
    let repo = self.repos[name]

    let stored = self.afters[name]
    if (stored != null) {
      # Continued session. Only re-copy the CURRENT workspace when the
      # sandbox holds nothing un-harvested — no working-tree changes, no new
      # commits; blindly re-copying would clobber work the caller hasn't
      # pulled yet.
      let prevBefore = self.befores[name]
      if (prevBefore == null) {
        raise `invariant violated: session "${name}" has a container but no before-tree`
      }
      # Self-healing for agent mode: `changes` advances the baseline on ITS
      # returned value, but a Changeset-returning tool does not rebind the
      # toolset object (core/llm.go: only a tool returning the bound object's
      # own type does), so the advance is lost and the session would look
      # dirty forever. When the sandbox tree already matches the CURRENT
      # workspace — the extracted changes were applied — the session is
      # de-facto clean. Likewise for commits once the workspace's history
      # holds the session's HEAD.
      let extracted = pending(stored, prevBefore, seed, repo).isEmpty or drift(stored, current).isEmpty
      let landed = true
      let moved = movedHead(seed, repo, stored)
      if (moved != "") {
        let r = repo
        if (r != null) {
          landed = ws.git.head.contains(other: history(r, stored).head) rescue {
            e: Error => false
          }
        }
      }
      if (!extracted) {
        print(`note: session "${name}" has un-extracted changes under ${workdir}; keeping its tree (the current workspace is NOT re-copied). Call changes(session: "${name}") to pull them.`)
      }
      if (!landed) {
        print(`note: session "${name}" has commits the workspace lacks; keeping its tree (the current workspace is NOT re-copied). Take them from ${historyAddress(name)}, or pass fresh: true to drop them.`)
      }
      copied = extracted and landed
      if (copied) {
        # withoutDirectory first: withDirectory overlays, so files deleted
        # from the workspace since the last copy would otherwise linger.
        ctr = stored
          .withoutDirectory(workdir)
          .withDirectory(workdir, current)
      } else {
        ctr = stored
        sessionBefore = prevBefore
      }
    } else {
      # New session: the sandbox arrives already resolved — the tool layer
      # (or the CLI) lifted the caller's address string into a Container at
      # the caller's boundary (see NOTE at top).
      ctr = sandbox
        .withDirectory(workdir, current)
        .withWorkdir(workdir)
    }

    if (copied) {
      # Re-seed: the commit just copied in, and the repository it came from.
      seed = ws.git.head.commitSHA rescue {
        e: Error => ""
      }
      repo = if (seed == "") { null } else { ws.git.head.asRepository }
    }

    let after = ctr
      # bust Dagger's exec cache so each call actually re-runs
      .withEnvVariable("SANDBOX_EXEC_NONCE", Random.string)
      .withExec(
        args,
        expect: ReturnType.ANY,
        experimentalPrivilegedNesting: true,
      )

    # The command's stdout/stderr already flow through as the exec's logs;
    # printing them again would duplicate them in the tool result.
    let code = after.exitCode
    if (code != 0) {
      print("exit code: " + toString(code))
    }

    self.afters = self.afters.with(name, after)
    self.befores = self.befores.with(name, sessionBefore)
    if (repo == null) {
      self.seeds = self.seeds.without(name)
      self.repos = self.repos.without(name)
    } else {
      self.seeds = self.seeds.with(name, seed)
      self.repos = self.repos.with(name, repo)
    }

    let delta = pending(after, sessionBefore, seed, repo)
    if (!delta.isEmpty) {
      # .{{path}} first: .length can't be called directly on a GraphQL
      # object list.
      let n = delta.diffStats.{{path}}.length
      print(`sandbox changed ${toString(n)} file(s) under ${workdir} — call changes(session: "${name}") to pull them into the workspace`)
    }
    let commits = newCommits(seed, repo, after)
    if (commits > 0) {
      print(`sandbox has ${toString(commits)} new commit(s) — take them from ${historyAddress(name)} with any tool that takes a GitRef (e.g. cherry-pick)`)
    }

    self
  }

  """
  Extract a session's /workspace drift as a Changeset. Returning it delivers
  it: the tool layer applies a returned Changeset to the workspace.
  """
  changes(
    """
    Session to extract from; "" means the implicit "last" session.
    """
    session: String! = "",
  ): Changeset! @cache(policy: FunctionCachePolicy.Never) {
    let name = sessionName(session)
    let after = afters[name]
    if (after == null) {
      raise `no sandbox session "${name}" — run exec first (sessions: ${names})`
    }
    let before = befores[name]
    if (before == null) {
      raise `invariant violated: session "${name}" has a container but no before-tree`
    }
    let afterTree = after.directory(workdir)
    # Advance the baseline so an already-extracted diff is not re-applied by
    # a later `changes`. KNOWN LIMIT (see final spike notes): this mutation
    # only persists where the caller keeps the returned object — in a
    # `dagger call ... exec ... changes` chain the Changeset is terminal, and
    # in agent mode a non-Sandbox-returning tool does not evolve the bound
    # toolset state. Commits are not part of this: they are taken from the
    # session's history, not extracted.
    self.befores = self.befores.with(name, afterTree)
    pending(after, before, seeds[name] ?? "", repos[name])
  }

  """
  List live sandbox sessions and whether each holds un-extracted changes or
  new commits. To find sandbox definitions, use
  FindArtifacts(type: "Container").
  """
  listSessions: String! @cache(policy: FunctionCachePolicy.Never) {
    if (afters.isEmpty) {
      return "(no sandbox sessions)"
    }
    afters.map { name, after =>
      let before = befores[name]
      let state = if (before == null) {
        "?"
      } else {
        let files = pending(after, before, seeds[name] ?? "", repos[name]).diffStats.{{path}}.length
        let commits = newCommits(seeds[name] ?? "", repos[name], after)
        let notes = [
          if (files > 0) { `${toString(files)} file(s) pending — call changes(session: "${name}")` } else { "" },
          if (commits > 0) { `${toString(commits)} new commit(s) at ${historyAddress(name)}` } else { "" },
        ].filter { n => n != "" }
        if (notes.isEmpty) { "clean" } else { notes.join("; ") }
      }
      `${name}: ${state}`
    }.values.join("\n")
  }

  """
  Sandbox sessions as a collection, keyed by session name. Only sessions
  copied from a git workspace are listed: each one's checkout, commits
  included, is its history.

  `dag://sandbox/sessions/head?sandbox-session=<name>` is a session's HEAD
  as a GitRef — the sandbox's .git reopened with the workspace repository's
  URL and remotes — so commits made in the sandbox (e.g. by `git revert`)
  can be cherry-picked, rebased onto or inspected by address with the git
  tools.
  """
  sessions: Sessions! {
    Sessions(currentNode.{{... on Dagger.Sandbox!}}, repos.keys)
  }

  """
  A session's HEAD as a GitRef. Collection plumbing: Sessions.get reaches
  the private session maps through it.
  """
  sessionHead(name: String!): GitRef! {
    let after = afters[name]
    if (after == null) {
      raise `no sandbox session "${name}" — run exec first (sessions: ${names})`
    }
    let repo = repos[name]
    if (repo == null) {
      raise `sandbox session "${name}" has no git history: the workspace it copied is not a git checkout`
    }
    history(repo, after).head
  }

  let names: String! {
    if (afters.isEmpty) {
      "(none)"
    } else {
      afters.keys.join(", ")
    }
  }

  let systemPrompt: String! = """
    You have a sandbox escape hatch: `exec` runs a command in any container
    with the workspace copied to /workspace. It is a LAST RESORT, and almost
    always the wrong first move:
    - Tests and lints: use checks — sandbox a test runner only when checks
      can't select what you need (e.g. one test via -run) and the iteration
      saving is significant.
    - Codegen and formatting: use generators.
    - Anything a module tool covers: use the module tool — it returns
      structured results a raw command doesn't.

    Mechanics:
    - `sandbox` is an address: an image ref like "golang:1.26", or a sandbox
      definition by DAG address like "dag://sandbox/dang".
      FindArtifacts(type: "Container") lists the definitions in scope.
    - The workspace is COPIED in, not mounted. Nothing you do in the sandbox
      touches the real workspace until you call `changes`, which extracts
      /workspace's drift as a Changeset and applies it.
    - Pass `session` to keep state (installed packages, files outside
      /workspace) across calls; `fresh: true` starts a session over.
      `listSessions` shows live sessions and their pending changes.
    - A continued session only sees your latest workspace edits when it has
      no un-extracted /workspace changes — pull pending changes first.
    - Git works in the sandbox (the checkout includes .git), for git
      operations no tool covers, like `git revert`. `changes` never carries
      .git itself: commits made in the sandbox are history, at
      `dag://sandbox/sessions/head?sandbox-session=<name>` — pass that
      address to any tool that takes a GitRef (e.g. cherry-pick) to take
      them. The image needs git installed: "dag://sandbox/git" has it.

    Reaching for exec is a signal: if no tool covered the need, note it; and
    if you exec the same setup twice, graduate it into a sandbox definition —
    a Container-returning function on a module (an existing one that owns
    the concern, or a workspace-local `sandboxes` module you create) — then
    use its address.
  """
}

"""
Sandbox sessions copied from a git workspace, as a collection keyed by
session name. Selected by address as
`dag://sandbox/sessions?sandbox-session=<name>`.
"""
type Sessions @collection {
  # The tool object holding the sessions; private so Sandbox itself stays out
  # of the collection's schema.
  let sandbox: Dagger.Sandbox!

  """
  Session names, sorted.
  """
  names: [String!]! @keys

  new(sandbox: Dagger.Sandbox!, names: [String!]!) {
    self.sandbox = sandbox
    self.names = names
    self
  }

  """
  The session with this name.
  """
  session(name: String!): Session! @get {
    Session(name, sandbox.sessionHead(name))
  }
}

"""
One sandbox session's git history.
"""
type Session {
  """
  The session name `exec` and `changes` address it by.
  """
  name: String!

  # Private: kept off the artifact tree except through `head`.
  let ref: GitRef!

  new(name: String!, ref: GitRef!) {
    self.name = name
    self.ref = ref
    self
  }

  """
  The session's HEAD as a GitRef — the artifact at
  `dag://sandbox/sessions/head?sandbox-session=<name>`. Commits made in the
  sandbox are reachable here; pass the address to any tool taking a GitRef
  to cherry-pick, rebase onto or inspect them.
  """
  head: GitRef! {
    ref
  }
}
