# staff: let a Dagger coding agent hire and direct long-running async worker
# agents — the async sibling of ./modules/delegate.
#
# delegate hands a subtask to a sub-agent and BLOCKS until it finishes; staff
# spawns workers that run in the background as Agent runtimes (see
# hack/designs/async-agents.md), so the chief keeps working while they do.
# Messaging is event-driven, never blocking (hack/designs/agent-messaging.md):
# spawn subscribes the chief to each worker's lifecycle, so completions and
# failures arrive as attributed messages instead of being polled or awaited;
# the chief steers by name — sendTo/status/read/interruptWorker.
#
# Staff does no git. The roster is a COLLECTION (`members`): each agent's
# committed history is an artifact, `dag://staff/members/head?member=<name>`,
# so whatever git tools the agent has that take a GitRef can inspect,
# cherry-pick or rebase onto another agent's commits by address. Uncommitted
# work has no git ref, so two escape hatches reach it by name: pendingOf
# (monitor) and salvagePending (recover), reading the agent's Workspace
# through its last committed conversation step.
#
# Workers bind `Peers` instead of Staff: the same `members` tree and escape
# hatches, but no orchestration. Its roster is LIVE — derived on each read
# from the chief's last committed step, whose bound Staff holds the current
# roster — so a worker sees peers hired after it. Plus a private line home
# (askChief) that delivers the question and returns immediately; the chief
# answers mid-turn with sendTo(replyTo:), and the engine refuses any wait
# that would deadlock.
#
# State: `agents` holds live Agent handles in module state, evolved by tools
# returning Staff! (the modules/editor pattern — engine-object handles in
# Dang state serialize as IDs and just work). The worker's tool objects are
# minted via real self-calls (Dagger.staff.peers, Dagger.staff.chiefLine):
# the result of a module call has engine identity, which withTools needs — a
# locally constructed Dang object does not.
#
# Registered in dagger.toml; can also be loaded directly with `dagger -m ./staff`.
"""
Hire and direct a staff of asynchronous worker agents: spawn them by name,
steer and observe them while they run, and collect their results.
"""
type Staff {
  # Live worker handles; unique by name, by construction.
  let agents: Map[Agent!]! = [:]

  # Tool configuration belongs to the originating workspace, not necessarily
  # the worktree the chief now edits (checkout preserves tools across switches).
  # Keep the source, not the partially composed base LLM or live tool state.
  let compositionSource: Workspace = null

  # Public for self-calls or the artifact tree, not chief tools: roster
  # bookkeeping and worker plumbing, and the `members` collection, which is
  # reached by address rather than as a tool. Prompt constants are excluded
  # too. Workers bind only the dedicated Peers object, never this full Staff.
  let plumbing = [
    "withWorker", "chiefLine", "peers", "memberAgent", "members",
    "withCompositionSource", "workerBase", "workerPrompt", "workerPromptFor"
  ]

  """
  Compose the staff-chief tools onto a base LLM.
  """
  agent(base: LLM!): LLM! @agent {
    let tools = currentNode.{{... on Dagger.Staff!}}
      .withCompositionSource(base.workspace)
    base
      .withTools(tools, except: plumbing)
      .withSystemPrompt(chiefPrompt)
  }

  """
  Retain the workspace supplying worker capabilities, independently of the
  workspace later passed to spawn. Internal composition plumbing only.
  """
  withCompositionSource(source: Workspace!): Staff! {
    self.compositionSource = source
    self
  }

  """
  Build a fresh worker base without starting a turn. Internal spawn plumbing.
  """
  workerBase(source: Workspace!, model: String = null): LLM! {
    # Direct API callers that never ran agent retain the old source-based
    # behavior. A composed Staff always uses its recorded origin instead.
    let origin = compositionSource ?? source
    # Workers work; they don't orchestrate. Do not discover or run agent code
    # from a checkout merely because the chief now operates on that worktree.
    # Expertise lists come back as lazy GraphQL lists; reload each by ID to
    # pass them as a concrete [Expertise!]! argument.
    let expertise = origin.artifacts
      .filterTypes(types: ["Expertise"])
      .withoutUri(uri: "dag://staff/**")
      .asExpertise.{{ id }}.map { node(id: _.id).{{ ... on Expertise! }} }
    let base = llm.withWorkspace(source)
      .compose(expertise: expertise)
      .withWorkspace(source)
    if (model == null) {
      base
    } else {
      base.withModel(model ?? "")
    }
  }

  """
  Hire a worker: spawn a named agent with its OWN read-write copy of your
  workspace and start it on a task, in the background.

  Returns immediately — the worker runs its opening turn asynchronously, and
  you are subscribed to its lifecycle: when it goes idle (with its final
  reply) or fails (with the error), the news arrives as an event message.
  Keep working; check on it with status/read, steer it with sendTo, and take
  its commits from `dag://staff/members/head?member=<name>` with your git
  tools. The worker gets fresh tools from the workspace where staff was
  composed, bound to your current worktree, the staff roster (`chief` and
  its peers, by address), and askChief, its line back to you. It cannot
  spawn or steer workers. Tools layered onto the chief later are not
  automatically inherited.

  The worker's roster is live: it lists the chief under the reserved name
  `chief` and every worker in your roster as of your last completed step, so
  workers hired later show up too.

  Its copy is a sandbox: whatever it edits, breaks or commits stays there
  until you harvest it, and reaches neither you nor any other worker. So
  hand it the change itself, not read-only investigation it has to write
  back to you in prose.
  """
  spawn(
    chief: Agent!,
    source: Workspace!,
    """
    Unique name for the worker; every other tool addresses it by this name.
    """
    name: String!,
    """
    The worker's opening task. Make it self-contained: the worker starts
    with none of your conversation context. Ask for the work itself — it can
    edit, run checks and commit in its own copy — and tell it to commit what
    it finishes, so you can take the result with its authorship.
    """
    task: String!,
    """
    Model for the worker's conversation — e.g. a cheaper model for rote
    work, or a stronger one for a hard problem. Defaults to the originating
    workspace composition's own choice.
    """
    model: String = null,
  ): Dagger.Staff! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): composes, starts, and messages a real agent runtime —
    # side effects that must actually run, never replay from cache.
    if (name == "chief") {
      raise `staff member name "chief" is reserved for the chief in worker rosters`
    }
    if (agents.has(name)) {
      raise `staff member "${name}" already exists — pick another name`
    }
    let base = workerBase(source, model)
    let worker = base
      # Peers holds the chief's handle and derives the roster from it on
      # every read, so workers hired after this one show up too. It exposes
      # only the roster and the escape hatches, so future Staff orchestration
      # methods cannot leak into workers by accident. Its `members` tree is
      # reached by address, so it is not a tool.
      .withTools(Dagger.staff.peers(chief: chief, name: name), except: ["members"])
      # The line home, minted via a real self-call; the boss handle itself
      # stays out of the tool schema.
      .withTools(Dagger.staff.chiefLine(boss: chief), except: ["boss"])
      .withSystemPrompt(workerPromptFor(name))
      # spawn mints a unique agent instance per call.
      .spawn(name: name)
    # Fire-and-forget: signal-with-start opens the worker's first turn.
    worker.send(task)
    # Subscribe the chief to the worker's lifecycle (defaults: IDLE and
    # FAILED): completions and failures arrive as event messages — steering
    # the chief's open turn or waking it — so nothing needs polling or
    # blocking waits. An already-settled worker fires immediately,
    # so even an instant finish is not missed.
    worker.notify(subscriber: chief)
    currentNode.{{... on Dagger.Staff!}}.withWorker(name, worker)
  }

  """
  An internal plumbing-only call so that we can separate the act of spawning
  from the act of storing the agent reference in the toolset - otherwise
  replaying the LLM ID will re-spawn agents on every nested Staff.spawn call in
  the ID.
  """
  withWorker(name: String!, worker: Agent!): Staff! {
    self.agents = self.agents.with(name, worker)
    self
  }

  """
  Send a message to a named worker without waiting: it steers the worker's
  running turn (or opens a new one) and returns the delivery evidence —
  STARTED (opened a turn), STEERED (absorbed mid-turn), or QUEUED (parked
  behind a pause; a paused worker is resumed first, so QUEUED here means the
  resume raced something).

  This is also how you ANSWER a worker's question: set replyTo to the ref
  from the question's attribution header (e.g. "#3"), and the worker sees
  your message paired with its question.
  """
  sendTo(
    """
    The worker's name.
    """
    name: String!,
    """
    The message to put on the worker's record.
    """
    message: String!,
    """
    The ref of the message you are answering, from its attribution header
    (e.g. "#3"). Leave unset for an ordinary message.
    """
    replyTo: String = null,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): every send must actually enqueue — a cached replay would
    # silently drop the message and report stale delivery evidence.
    let worker = member(name)
    # Resume-first: un-parks a worker paused by interruptWorker (or retries
    # a failed one); a no-op otherwise — so the send actually drains.
    worker.resume
    `delivery: ${toString(worker.send(message, replyTo: replyTo ?? "").delivery)}`
  }

  """
  One line per staff member: its name and lifecycle state (IDLE, RUNNING,
  PAUSED, FAILED, STOPPED).
  """
  status: String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): projects live lifecycle state — and with no args, a
    # cached result would pin this to its first answer forever.
    if (agents.isEmpty) {
      "(none)"
    } else {
      agents.map { name, agent => `${name}: ${toString(agent.state)}` }.values.join("\n")
    }
  }

  """
  Read the tail of a worker's conversation so far: the text entries of its
  last committed snapshot, tagged by role. Tool calls, results and the
  system prompt are omitted — this is the narrative, not the trace.
  """
  read(
    """
    The worker's name.
    """
    name: String!,
    """
    How many entries from the end of the conversation to return.
    """
    last: Int! = 10,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): the snapshot advances as the worker runs; identical
    # (name, last) args must not replay an old tail.
    let entries: [String!]! = []
    # SYSTEM is the worker's prompt boilerplate, and dropping it is what
    # makes a small `last` useful: otherwise the tail is all preamble and
    # none of the narrative it is asked for.
    member(name).snapshot.messages.{{role, content.{{kind, text}}}}
      .filter { m => m.role != LLMMessageRole.SYSTEM }
      .each { m =>
        m.content.each { block =>
          if (block.kind == LLMContentBlockKind.TEXT and block.text != "") {
            entries += [`[${toString(m.role)}] ${block.text}`]
          }
        }
      }
    if (entries.isEmpty) {
      "(no conversation yet)"
    } else {
      entries.takeLast(last).join("\n")
    }
  }

  """
  Escape hatch for a worker's UNCOMMITTED edits. For committed work, use git
  tools with `dag://staff/members/head?member=<name>`.

  Monitor: show what a worker has changed but not committed — a per-file
  summary followed by a Git-compatible unified diff. No git ref reaches
  uncommitted work, so this is how to look at it before the worker commits.

  Reads the worker's LAST COMMITTED conversation step, so a mid-turn worker
  may hold edits this cannot see yet. Pass `paths` to scope the patch; a
  worker's whole diff can be enormous.
  """
  pendingOf(
    """
    The worker's name.
    """
    name: String!,
    """
    Glob patterns to include, relative to the workspace root (e.g. "src/**"
    or "**/*.go"). Empty shows everything.
    """
    paths: [String!]! = [],
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): reads the worker's live snapshot, which is not part of
    # this call's arguments.
    pendingReport(workerWorkspace(name), name, paths)
  }

  """
  Escape hatch for a worker's UNCOMMITTED edits. For committed work, use git
  tools with `dag://staff/members/head?member=<name>`.

  Recover: take everything a worker changed but never committed as your own
  pending edits, re-anchored on your workspace's current content. The
  worker's authorship is lost — asking it to commit is the regular route;
  this is for work that cannot wait for that, or a worker that cannot
  finish.

  The worker started from a copy of your workspace, so its pending patch
  usually contains edits you already have; those are filtered out by
  comparing the two trees, and only files that genuinely differ are applied.
  Fails rather than half-applying when the two of you edited the same part
  of the same file. `markers: true` applies what fits and leaves git-style
  conflict markers for you to resolve.

  Reads the worker's LAST COMMITTED conversation step: wait for its idle
  event (or use `interruptWorker`) first when it matters.
  """
  salvagePending(
    source: Workspace!,
    """
    The worker's name.
    """
    name: String!,
    """
    Leave git-style conflict markers where a hunk no longer applies, instead
    of failing.
    """
    markers: Boolean! = false,
  ): Changeset! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): reads the worker's live snapshot, which is not part of
    # this call's arguments.
    salvage(source, workerWorkspace(name), name, markers)
  }

  """
  Preempt a worker mid-task: its in-flight step is canceled, every completed
  step is kept, and the worker parks PAUSED with its turn suspended. A later
  sendTo resumes it (the suspended turn continues, with your new message
  drained into it).
  """
  interruptWorker(
    """
    The worker's name.
    """
    name: String!,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): imperatively mutates runtime state.
    member(name).pause(interrupt: true)
    `${name} interrupted: parked PAUSED with completed steps kept; sendTo resumes it`
  }

  """
  Mint the tool object a worker receives: the roster and the escape hatches,
  no orchestration. Takes the chief's handle, from which the roster is read
  live; `name` is the worker's own staff name, left out of its roster.

  The required argument is load-bearing: it keeps this off the artifact
  tree, so `dag://staff/members` has exactly one meaning.
  """
  peers(chief: Agent!, name: String! = ""): Peers! {
    Peers(chief, name)
  }

  """
  The roster as a collection, one member per worker, under its staff name.

  Each member's committed history is an artifact — `dag://staff/members/head?member=<name>`
  is that agent's HEAD as a GitRef — so any git tool that takes a ref can
  inspect, cherry-pick or rebase onto another agent's commits by address.
  """
  members: Members! {
    # Map keys come back sorted, so the collection's key order is stable
    # across roster mutations.
    Members(currentNode.{{... on Dagger.Staff!}}, agents.keys)
  }

  """
  The live Agent handle behind a staff name. Collection plumbing: Members.get
  reaches the roster through it, since `agents` is private state.
  """
  memberAgent(name: String!): Agent! {
    member(name)
  }

  """
  Mint a worker's line back to its chief. Used by spawn via a self-call (a
  module-call result has the engine identity withTools needs); not part of
  the chief's or the workers' toolset.
  """
  chiefLine(boss: Agent!): ChiefLine! {
    ChiefLine(boss)
  }

  # Address a member by name, with a helpful miss.
  let member(name: String!): Agent! {
    let member = agents[name]
    if (member == null) {
      raise `no staff member named "${name}"; current members: ${memberNames}`
    }
    member
  }

  let memberNames: String! {
    if (agents.isEmpty) {
      "(none)"
    } else {
      agents.keys.join(", ")
    }
  }

  # The worker's own copy of the workspace: Agent.snapshot is its last
  # committed conversation, and LLM.workspace the workspace bound to it.
  #
  # `sync` is load-bearing, not decoration. Dang forces a lazy chain once per
  # SELECTION off it, not once per `let` binding — and Agent.snapshot is
  # DoNotCache, so every field an escape hatch reads off an unpinned `theirs`
  # re-executes snapshot and lands on a DIFFERENT live snapshot as the worker
  # steps; the resulting patch could mix trees. LLM.sync returns ID!
  # @expectedType(LLM), which Dang forces at the call site and re-hydrates
  # through node(id:) (hack/designs/async-agents.md §9), so the read happens
  # exactly once and every later selection replays the lookup instead.
  let workerWorkspace(name: String!): Workspace! {
    member(name).snapshot.sync.workspace
  }

  # Instructions for the CHIEF agent holding these tools.
  let chiefPrompt: String! = """
    You can hire and direct a staff of asynchronous worker agents. Workers
    run in the background: spawn returns immediately, and the worker chews
    on its task while you keep working. Messaging is event-driven — never
    block waiting for a worker.

    - `spawn` hires a named worker with its own read-write copy of your
      workspace and starts it on a task. Names are unique; every other tool
      addresses workers by name. Spawning subscribes you to the worker's
      lifecycle: when it finishes a turn or fails, the news arrives as an
      "[event from agent ...]" message carrying its final reply or error.
    - `sendTo` steers a worker without blocking (returning the delivery
      evidence). With `replyTo`, it answers a question: quote the ref from
      the question's attribution header (e.g. "#3").
    - `status` lists members and their lifecycle states; `read` shows the
      tail of a worker's conversation. Use them to inspect progress, not to
      poll for completion — completions arrive as events.
    - `interruptWorker` preempts a worker mid-task (progress kept, parked
      paused); a later sendTo resumes it.

    MESSAGES ARE ATTRIBUTED. A worker's question arrives as a message
    headed "[message #N from agent ...]"; an event as "[event from agent
    ...]"; the user's own words carry no header. Answer a worker's question
    with sendTo(name, answer, replyTo: "#N") — mid-turn, whenever you have
    the answer — and keep working if you have independent work to do.
    Never confuse a worker's request with the user's instructions: the user
    outranks the staff.

    THE EVENT LOOP: spawn workers, keep working, and act on events as they
    arrive. A worker going idle means its turn ended — read the final reply
    in the event, then harvest or send follow-up work. A worker FAILING
    means its loop stopped — sendTo retries it from its last completed
    step. When you have nothing to do until workers
    respond, reply with a brief progress update and END YOUR TURN. This
    applies whether you are waiting on one worker or several. Their
    completion events and messages (including questions) will wake you;
    handle them when they arrive. Do not block or poll while waiting — that
    prevents you from seeing and answering a worker's question promptly.

    A worker's copy is a SANDBOX, not a read-only view: it can edit, create,
    delete, run checks and commit exactly as freely as you can, and none of
    it reaches your workspace or any other worker's until you harvest it.
    Delegate the work itself, not a report about it. Never tell a worker to
    avoid editing, to treat the workspace as read-only, or to hand you a
    patch in prose — that throws away the isolation that makes workers worth
    hiring, and leaves you to redo the change by hand. Tell each worker to
    COMMIT what it finishes: a commit is the clean handoff, and uncommitted
    work is only the fallback.

    HARVESTING IS GIT, BY ADDRESS. Each member's committed history is
    addressable as `dag://staff/members/head?member=<name>`. Pass that
    address to any tool that takes a GitRef to inspect a worker's commits,
    cherry-pick them into your workspace, or rebase your own commits onto
    them — nothing needs pushing. FindArtifacts lists these addresses, and
    FindArtifacts(dimension: "member") the names.

    Each worker sees the same roster — `chief` for you, staff names for its
    peers — and can inspect and take their work the same way, but cannot
    spawn, steer, or interrupt anyone. Its roster is live as of your last
    completed step, so workers you hire later show up for earlier ones too.

    ESCAPE HATCHES for UNCOMMITTED work, which no git ref reaches — for
    monitoring and recovery, not the regular route:

    - `pendingOf` shows a worker's uncommitted edits as a diff.
    - `salvagePending` takes them as your own pending edits, re-anchored on
      your tree; the worker's authorship is lost. Prefer asking the worker
      to commit.

    SETTLE BEFORE THE FINAL HARVEST: a member's address and the escape
    hatches read the worker's last COMMITTED conversation step, so a
    mid-turn worker may hold work they cannot see yet. Wait for its idle
    event (or use `interruptWorker`) before the harvest that matters.
  """

  # Instructions for each WORKER. Public so tests (and the curious) can read
  # the exact text spawn composes into every worker — recordings that replay
  # a worker's conversation must match it byte for byte. spawn composes
  # workerPromptFor(name), which appends the worker's own staff name.
  workerPrompt: String! = """
    You are a worker agent on a staff, reporting to a chief agent. Work your
    task autonomously to completion with the available tools. The chief
    reads results from your conversation and collects your final reply, so
    end each task with a concise, self-contained report.

    THE WORKSPACE IS YOURS. It is a private read-write copy — not the
    chief's, not shared with any other worker. Edit, create, delete, run
    checks and commit as freely as the task needs: nothing you do disturbs
    anyone else's workspace, and no change of yours reaches the chief until
    it deliberately harvests one. So do the work rather than describing it.
    Never treat the workspace as read-only, never ask permission to make an
    edit the task already implies, and never stop at proposing a patch you
    could have applied. Experiments are cheap here: try the change, run the
    checks, keep what works.

    COMMIT WHAT YOU FINISH, in focused commits with clear messages — that is
    the clean handoff, and the chief takes those commits with your
    authorship intact. Genuinely unfinished work can stay uncommitted (the
    chief can still rescue it), but do not leave finished work sitting as
    pending edits. Say in your final report what you changed and which
    commits carry it.

    THE STAFF'S WORK IS ADDRESSABLE. Each member's committed history is a
    git ref, `dag://staff/members/head?member=<name>` — `chief` for the
    chief, staff names for your peers. Pass it to any tool that takes a
    GitRef to inspect, cherry-pick, or rebase onto that work — e.g. put your
    commits on top of the chief's when it asks you to. FindArtifacts lists
    these addresses, and FindArtifacts(dimension: "member") the names. The
    roster is live as of the chief's last completed step, so peers hired
    after you show up too. Uncommitted work has no git ref: `pendingOf`
    (monitor) and `salvagePending` (recover) are escape hatches for a
    member's uncommitted edits. You cannot spawn, steer, or interrupt agents.

    You have one line home: `askChief` delivers a question to the chief and
    returns immediately with the question's ref. The answer arrives later as
    a message headed "[reply from agent ...]" — keep working if you can, or
    end your turn to wait for it; its arrival wakes you. Use it sparingly,
    and prefer working with what you have.
  """

  """
  The exact system prompt spawn composes into a worker with the given staff
  name: workerPrompt plus a closing line carrying the name, so a worker can
  refer to itself the way the chief and its peers address it (attribution
  headers and the roster use this name). Public for the same reason as
  workerPrompt: recordings that replay a worker's conversation must match
  this text byte for byte, so the interpolation is part of the constant's
  contract rather than a private spawn detail.
  """
  workerPromptFor(name: String!): String! {
    workerPrompt + "\n\n" + `Your staff name is "${name}": the chief and your peers address you by it, and message attribution headers use it.`
  }
}

"""
The staff roster as a collection: staff names as keys, each agent's git
history as the item. Selected by address as `dag://staff/members?member=<name>`.
"""
type Members @collection {
  # The roster the keys were read from; private so Staff itself stays out of
  # the collection's schema.
  let staff: Dagger.Staff!

  """
  Staff names, sorted: workers under the names they were spawned with.
  """
  names: [String!]! @keys

  new(staff: Dagger.Staff!, names: [String!]!) {
    self.staff = staff
    self.names = names
    self
  }

  """
  The member with this staff name.
  """
  member(name: String!): Member! @get {
    Member(name, agent: staff.memberAgent(name))
  }
}

"""
One staff member: an agent and the workspace it works in, reached through its
last committed conversation step.
"""
type Member {
  """
  The staff name the chief and peers address this agent by.
  """
  name: String!

  # The live handle; private so the Agent API stays off the artifact tree.
  let agent: Agent = null
  # Or, in a worker's roster, the same member as the chief's live roster
  # holds it: a worker reaches the chief's collection, not its handles.
  let via: Dagger.StaffMember = null

  new(name: String!, agent: Agent = null, via: Dagger.StaffMember = null) {
    self.name = name
    self.agent = agent
    self.via = via
    self
  }

  """
  The agent's lifecycle state (IDLE, RUNNING, PAUSED, FAILED, STOPPED).
  """
  state: AgentState! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): projects live runtime state.
    let handle = agent
    if (handle == null) {
      return delegate.state
    }
    handle.state
  }

  """
  The agent's workspace as of its last committed step: HEAD plus any
  uncommitted edits.
  """
  workspace: Workspace! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): the snapshot advances as the agent runs. `sync` pins the
    # read to one snapshot, as workerWorkspace does for the escape hatches.
    let handle = agent
    if (handle == null) {
      return delegate.workspace
    }
    handle.snapshot.sync.workspace
  }

  # The chief's own entry for a member reached through a worker's roster.
  let delegate: Dagger.StaffMember! {
    let other = via
    if (other == null) {
      raise `staff member "${name}" has no agent`
    }
    other
  }

  """
  The agent's committed history: the HEAD of its workspace, as a GitRef. This
  is the artifact at `dag://staff/members/head?member=<name>` — pass that
  address to any tool taking a GitRef to rebase onto, cherry-pick from, or
  inspect this agent's commits.
  """
  head: GitRef! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): the snapshot advances as the agent runs.
    workspace.git.head
  }
}

"""
A worker's view of the staff: the roster and the escape hatches for
uncommitted work.

Workers receive this narrow tool object instead of Staff itself, so they can
inspect and take any member's work without gaining orchestration
capabilities such as spawn, steering, or interruption.
"""
type Peers {
  # The chief's live handle. Private so the Agent API never enters the tool
  # schema; the roster is derived from it on every read.
  let chief: Agent!
  # This worker's own staff name, left out of its roster.
  let name: String!

  new(chief: Agent!, name: String!) {
    self.chief = chief
    self.name = name
    self
  }

  """
  The staff roster as a collection: `chief`, and the workers in the chief's
  roster as of its last completed step — including workers hired after you.
  `dag://staff/members/head?member=<name>` addresses a member's committed
  history as a GitRef for tools that take one.
  """
  members: PeerMembers! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): the chief's roster grows as it spawns workers; a cached
    # result would freeze it at the first read.
    #
    # The chief's last committed step is its conversation, whose bound Staff
    # holds the live roster; LLM.artifacts reaches that tool object's
    # `members` collection at its current value. `sync` pins one snapshot.
    # A chief without staff tools (e.g. a hand-built fixture) has no roster
    # beyond itself; `chief` stays reachable either way.
    let roster: Dagger.StaffMembers = chief.snapshot.sync
      .artifacts(include: ["staff/members"])
      .filterUri(uri: "dag+staff-members://staff/members")
      .one.value.{{... on Dagger.StaffMembers!}} rescue {
        e: Error => null
      }
    let workers = if (roster == null) { [] } else { roster.keys }
    PeerMembers(chief, roster, ["chief"] + workers.filter { n => n != name })
  }

  """
  Escape hatch for an agent's UNCOMMITTED edits. For committed work, use git
  tools with `dag://staff/members/head?member=<name>`.

  Monitor: show what a member — `chief` or a peer — has changed but not
  committed, as a per-file summary followed by a Git-compatible unified
  diff. Reads its last committed conversation step.
  """
  pendingOf(
    """
    The member's name: `chief`, or a peer's staff name.
    """
    name: String!,
    """
    Glob patterns to include (e.g. "src/**" or "**/*.go"), relative to the
    workspace root. Empty shows everything.
    """
    paths: [String!]! = [],
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): reads a live snapshot, which is not part of this call's
    # arguments.
    pendingReport(members.member(name).workspace, name, paths)
  }

  """
  Escape hatch for an agent's UNCOMMITTED edits. For committed work, use git
  tools with `dag://staff/members/head?member=<name>`.

  Recover: take a member's uncommitted work as your own pending edits,
  re-anchored on your workspace's current content; its authorship is lost.
  Fails when you both edited the same part of a file, unless `markers: true`.
  """
  salvagePending(
    source: Workspace!,
    """
    The member's name: `chief`, or a peer's staff name.
    """
    name: String!,
    """
    Leave conflict markers where a hunk no longer applies.
    """
    markers: Boolean! = false,
  ): Changeset! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): reads a live snapshot, which is not part of this call's
    # arguments.
    salvage(source, members.member(name).workspace, name, markers)
  }
}

"""
A worker's roster as a collection: `chief` and its peers by staff name.
Selected by address as `dag://staff/members?member=<name>`, like the chief's.
"""
type PeerMembers @collection {
  # Private so the Agent API and the chief's Staff stay out of the
  # collection's schema.
  let chief: Agent!
  # The chief's live roster; null when its conversation binds no Staff.
  let roster: Dagger.StaffMembers

  """
  `chief`, then the chief's workers, sorted, except yourself.
  """
  names: [String!]! @keys

  new(chief: Agent!, roster: Dagger.StaffMembers, names: [String!]!) {
    self.chief = chief
    self.roster = roster
    self.names = names
    self
  }

  """
  The member with this staff name.
  """
  member(name: String!): Member! @get {
    if (!names.contains(name)) {
      raise `no staff member named "${name}" in your roster; current members: ${names.join(", ")}`
    }
    if (name == "chief") {
      return Member("chief", agent: chief)
    }
    let live = roster
    if (live == null) {
      raise `no staff member named "${name}": the chief has no roster`
    }
    # A local Member wrapping the chief's entry, not that entry itself: the
    # item type names the collection's dimension, which must stay `member`.
    Member(name, via: live.get(key: name))
  }
}

"""
A worker's private line back to the chief that spawned it.
"""
type ChiefLine {
  # The chief's live handle; bound with except: ["boss"] so it never shows
  # up as a tool.
  boss: Agent!

  """
  Ask your chief a question. Non-blocking: the question is delivered and
  this returns immediately — the answer arrives later as a message headed
  "[reply from agent ...]".

  Keep working if you can; if you truly cannot proceed without the answer,
  end your turn — the reply's arrival wakes you. Your question lands on the
  chief's record attributed to you, and the chief answers it mid-turn
  whenever it has an answer, not necessarily right away.
  """
  askChief(
    """
    The question to put on the chief's record.
    """
    question: String!,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): a worker re-asking the same question must reach the
    # chief again, not replay the first delivery from cache.
    let msg = boss.send(question)
    `question ${msg.ref} delivered to the chief. The answer will arrive as `
      + `a "[reply from agent ...]" message — keep working, or end your turn `
      + `to wait for it.`
  }
}

# ------------------------------------------------------------ escape hatches
# Shared by the chief's Staff and a worker's Peers; `theirs` is the member's
# workspace as of one pinned snapshot.

# pendingOf: a member's uncommitted work as a summary plus patch.
let pendingReport(theirs: Workspace!, name: String!, paths: [String!]!): String! {
  let changes = theirs.git.uncommitted.filter(include: paths)
  let scopedStats = changes.diffStats.{{kind, addedLines, removedLines, path}}
  if (scopedStats.isEmpty) {
    return `"${name}" has no uncommitted changes`
      + (if (paths.isEmpty) { "." } else { " under the given paths." })
      + "\n\n" + `What it committed is at dag://staff/members/head?member=${name}, `
      + "for any tool that takes a GitRef."
  }
  let summary = scopedStats.map { s =>
    `${renderKind(s.kind)}  +${toString(s.addedLines)}  -${toString(s.removedLines)}  ${s.path}`
  }.join("\n")
  let scoped = changes.asPatch.contents
  let patchBlock = if (scoped == "") { "" } else { "\n\n" + scoped }
  `Uncommitted work in "${name}"'s workspace:` + "\n\n" + summary + patchBlock
}

# salvagePending: a member's uncommitted work, re-anchored on `source`.
let salvage(source: Workspace!, theirs: Workspace!, name: String!, markers: Boolean!): Changeset! {
  let base = source.directory("/")

  # Re-anchoring, and the reason the naive version fails in the COMMON
  # case: the worker inherited your pending edits at spawn, so its patch
  # contains hunks you already have, and withPatch is a plain `git apply`
  # with no 3-way — it rejects an already-applied hunk. Restrict the patch
  # to the files where the two trees genuinely differ. Partial overlap
  # INSIDE a file still fails; that is what markers: true is for.
  # Keep both names of a rename: filtering one side intentionally yields
  # only an addition or deletion. Drop absent old paths so an empty name
  # does not select the whole tree.
  let driftStats = theirs.directory("/").changes(from: base).diffStats.{{path, oldPath}}
  let drift = driftStats.map { s => s.path }
    + driftStats.map { s => s.oldPath ?? "" }.filter { p => p != "" }
  if (drift.isEmpty) {
    print(`"${name}" has nothing your workspace does not already have.`)
    return base.changes(from: base)
  }

  let pending = scopeLiteralChanges(theirs.git.uncommitted, drift).asPatch.contents
  if (pending == "") {
    print(`"${name}" has no uncommitted work to take. What it committed is at `
      + `dag://staff/members/head?member=${name}, for any tool that takes a GitRef.`)
    return base.changes(from: base)
  }

  let onConflict = if (markers) {
    PatchConflict.LEAVE_CONFLICT_MARKERS
  } else {
    PatchConflict.FAIL
  }
  let delta = base.withPatch(pending, onConflict: onConflict).changes(from: base)
  # Force the apply here; a swallowed failure would silently discard the
  # worker's uncommitted work.
  delta.isEmpty rescue {
    e: Error => raise `taking "${name}"'s uncommitted work failed: ${e.message}`
      + (
        if (markers) {
          ""
        } else {
          ` — you and ${name} edited the same part of the same file; retry with markers: true to resolve it by hand`
        }
      )
  }

  let marked = if (markers) {
    " Search for conflict markers (<<<<<<<) and resolve them."
  } else {
    ""
  }
  print(`Took "${name}"'s uncommitted work as your own pending edits.` + marked)
  delta
}

# Only salvage's computed drift paths need literal matching. Public diff
# filters accept native globs and bypass this escaping entirely.
let scopeLiteralChanges(changes: Changeset!, paths: [String!]!): Changeset! {
  if (paths.isEmpty or paths.any { p => Path(p) == Path(".") }) {
    return changes
  }
  let include = paths.map { p =>
    Path(p).string
      .replace("\\", "\\\\")
      .replace("*", "\\*")
      .replace("?", "\\?")
      .replace("[", "\\[")
      .replace("]", "\\]")
      .replace("!", "[!]")
      .rewriteMatches(`\s`) { m => "[" + m.string + "]" }
  }
  changes.filter(include: include)
}

# Nullable: the projected record's fields inherit nullability from the
# nullable `changes` field they were selected through.
let renderKind(kind: DiffStatKind): String! {
  case (kind) {
    DiffStatKind.ADDED => "A"
    DiffStatKind.MODIFIED => "M"
    DiffStatKind.REMOVED => "D"
    DiffStatKind.RENAMED => "R"
    else => "?"
  }
}
